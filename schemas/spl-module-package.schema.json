{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spl:module-package:1",
  "title": "SPL registered pure module run binding",
  "type": "object", "additionalProperties": false,
  "required": ["profile", "module_ref", "manifest", "scope", "inputs", "parameters", "evidence", "state_cells", "decisions"],
  "properties": {
    "profile": {"const": "spl-module/1"},
    "module_ref": {"$ref": "#/$defs/module_ref"},
    "manifest": {"type": "object", "additionalProperties": false,
      "required": ["run_id", "scenario_id", "mode", "period", "cutoff", "compiler_build", "runtime_build", "module_closure", "resource_limits"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1}, "scenario_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["final", "preview"]},
        "period": {"type": "object", "additionalProperties": false, "required": ["start", "end"],
          "properties": {"start": {"type": "string"}, "end": {"type": "string"}}},
        "cutoff": {"type": "string"},
        "report_date": {"type": "string"}, "issue_date": {"type": "string"},
        "compiler_build": {"type": "string"}, "runtime_build": {"type": "string"},
        "module_closure": {"type": "array", "items": {"$ref": "#/$defs/module_ref"}},
        "resource_limits": {"type": "object", "additionalProperties": false,
          "required": ["max_input_rows", "lean_timeout_seconds"],
          "properties": {"max_input_rows": {"const": 100000}, "lean_timeout_seconds": {"const": 180}}}
      }},
    "scope": {"type": "object", "additionalProperties": false,
      "required": ["agreement_id", "participant_ids", "pool_id", "purpose", "asset_ids"],
      "properties": {"agreement_id": {"type": "string", "minLength": 1}, "pool_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "participant_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "inputs": {"type": "object"}, "parameters": {"type": "object"},
    "evidence": {"type": "object"},
    "state_cells": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["state_key", "opening_port", "purpose", "unit", "scope", "boundary", "quantity", "provenance_ref", "scenario_id"],
      "properties": {"state_key": {"type": "string", "minLength": 1}, "opening_port": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1},
        "scope": {"type": "object", "additionalProperties": false, "required": ["agreement_id", "participant_id", "pool_id"],
          "properties": {"agreement_id": {"type": "string"}, "participant_id": {"type": "string"}, "pool_id": {"type": "string"},
            "vintage_id": {"type": "string"}, "asset_id": {"type": "string"}, "unit": {"type": "string", "minLength": 1}}},
        "boundary": {"type": "string"}, "quantity": {}, "provenance_ref": {"type": "string", "minLength": 1},
        "scenario_id": {"type": "string", "minLength": 1}, "prior_result_ref": {"type": "string", "pattern": "^result@sha256:[0-9a-f]{64}$"}
      }}},
    "decisions": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["decision_id", "policy_id", "policy_revision", "status", "evidence_ref"],
      "properties": {"decision_id": {"type": "string", "minLength": 1}, "policy_id": {"type": "string", "minLength": 1},
        "policy_revision": {"type": "string", "minLength": 1}, "status": {"enum": ["proposed", "reviewed", "approved"]},
        "evidence_ref": {"type": "string", "minLength": 1}}}}
  },
  "$defs": {
    "module_ref": {"type": "object", "additionalProperties": false, "required": ["id", "revision", "locator", "sha256"],
      "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
