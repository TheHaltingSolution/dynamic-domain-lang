    define lines = for each period_entry in economic {
      define original_earned: Option<Money<USD>> = fold filter(checked_issues, row => row.period_id == period_entry.period_id) from none() with selected, row { yield some(row.earned); };
      define original_result: Option<Text> = fold filter(checked_issues, row => row.period_id == period_entry.period_id) from none() with selected, row { yield some(row.result_ref); };
