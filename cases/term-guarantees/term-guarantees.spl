// Explicit fixed-term caps, final-only floors and actual-funded prepayment.
schedule FixedTermGuarantees language "spl/0.1-draft" core "spl-core/0.1-draft" schema "spl-data/0.1-draft" {
  input scope: SettlementScope;
  input project: Id<Asset>;
  input fact_scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>};
  input case_id: Text;
  input as_of: Date;
  input cutoff: Instant;
  input policy: {id: Text, revision: Text, method: Text, floor_timing: Text, cap_reset: Text, cap_reduction_order: Text, funding_date_basis: Text, term_availability: Text, rounding: Text, evidence_class: Text};
  input term: {approved_date: Date, cap: Money<USD>, evidence_ref: Text, floor: Money<USD>, id: Text, observed_at: Instant, opening_utc: Instant, period: Period, recorded_date: Date, recoupable_minimum_face: Money<USD>, revision: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_cap: Text, source_floor: Text, source_observed_at: Text, source_recoupable_minimum_face: Text, source_ref: Text};
  input earnings: List<{amount: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_observed_at: Text, source_ref: Text, term_id: Text}>;
  input fundings: List<{amount: Money<USD>, approved: Bool, disbursement_id: Text, evidence_ref: Text, funded_at: Instant, funded_date: Date, funded_utc_date: Date, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_funded_at: Text, source_observed_at: Text, source_ref: Text, term_id: Text}>;
  input evidence: List<{approval_ref: Id<Decision>, evidence_ref: Text, id: Text, kind: Text, observed_at: Instant, population: Option<{disbursement_ids: List<Text>, funded_total: Money<USD>, funding_ids: List<Text>, period: Period, term_id: Text}>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_kind: Text, source_observed_at: Text}>;
  input supplied_opening: {boundary: Date, cap_reduction_order: Text, method: Text, origin: Text, period_history: List<{earnings: List<{amount: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_observed_at: Text, source_ref: Text, term_id: Text}>, fundings: List<{amount: Money<USD>, approved: Bool, disbursement_id: Text, evidence_ref: Text, funded_at: Instant, funded_date: Date, funded_utc_date: Date, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_funded_at: Text, source_observed_at: Text, source_ref: Text, term_id: Text}>, period: Period, source_case_id: Text}>, policy_id: Text, policy_revision: Text, prepayment: Money<USD>, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, term: {approved_date: Date, cap: Money<USD>, evidence_ref: Text, floor: Money<USD>, id: Text, observed_at: Instant, opening_utc: Instant, period: Period, recorded_date: Date, recoupable_minimum_face: Money<USD>, revision: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_cap: Text, source_floor: Text, source_observed_at: Text, source_recoupable_minimum_face: Text, source_ref: Text}, term_cap_consumed: Money<USD>, term_closed: Bool, term_earned: Money<USD>, term_recognized_entitlement: Money<USD>, total_funded: Money<USD>, total_recovered: Money<USD>};
  input predecessor: Option<{source_case_id: Text, period: Period, closing_state: {boundary: Date, cap_reduction_order: Text, method: Text, origin: Text, period_history: List<{earnings: List<{amount: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_observed_at: Text, source_ref: Text, term_id: Text}>, fundings: List<{amount: Money<USD>, approved: Bool, disbursement_id: Text, evidence_ref: Text, funded_at: Instant, funded_date: Date, funded_utc_date: Date, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_funded_at: Text, source_observed_at: Text, source_ref: Text, term_id: Text}>, period: Period, source_case_id: Text}>, policy_id: Text, policy_revision: Text, prepayment: Money<USD>, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, term: {approved_date: Date, cap: Money<USD>, evidence_ref: Text, floor: Money<USD>, id: Text, observed_at: Instant, opening_utc: Instant, period: Period, recorded_date: Date, recoupable_minimum_face: Money<USD>, revision: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_cap: Text, source_floor: Text, source_observed_at: Text, source_recoupable_minimum_face: Text, source_ref: Text}, term_cap_consumed: Money<USD>, term_closed: Bool, term_earned: Money<USD>, term_recognized_entitlement: Money<USD>, total_funded: Money<USD>, total_recovered: Money<USD>}}>;
  opening history: {boundary: Date, cap_reduction_order: Text, method: Text, origin: Text, period_history: List<{earnings: List<{amount: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_observed_at: Text, source_ref: Text, term_id: Text}>, fundings: List<{amount: Money<USD>, approved: Bool, disbursement_id: Text, evidence_ref: Text, funded_at: Instant, funded_date: Date, funded_utc_date: Date, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_funded_at: Text, source_observed_at: Text, source_ref: Text, term_id: Text}>, period: Period, source_case_id: Text}>, policy_id: Text, policy_revision: Text, prepayment: Money<USD>, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, term: {approved_date: Date, cap: Money<USD>, evidence_ref: Text, floor: Money<USD>, id: Text, observed_at: Instant, opening_utc: Instant, period: Period, recorded_date: Date, recoupable_minimum_face: Money<USD>, revision: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_cap: Text, source_floor: Text, source_observed_at: Text, source_recoupable_minimum_face: Text, source_ref: Text}, term_cap_consumed: Money<USD>, term_closed: Bool, term_earned: Money<USD>, term_recognized_entitlement: Money<USD>, total_funded: Money<USD>, total_recovered: Money<USD>} from "term-guarantee/original-term-history";
  require fact_scope.contract_id == scope.agreement_id and fact_scope.participant_id == scope.participant_id and fact_scope.pool_id == scope.pool_id and fact_scope.asset_id == project and fact_scope.currency == "USD" else "TERM_FACT_SCOPE";
  require case_id != "" and term.id != "" and term.revision != "" and term.source_ref != "" else "TERM_IDENTITY_REQUIRED";
  require policy.id == "SYNTHETIC-TERM-GUARANTEES-01" and policy.revision == "1" and policy.floor_timing == "term_end" and policy.cap_reset == "never_within_term" and policy.cap_reduction_order == "topup_before_earned" and policy.funding_date_basis == "supplied_utc_date" and policy.term_availability == "known_at_open_utc" and policy.rounding == "exact_no_rounding" and policy.evidence_class == "research_assumption" else "TERM_SELECTED_POLICY";
  require policy.method == "term_cap" or policy.method == "term_floor_at_end" or policy.method == "actual_funded_advance" or policy.method == "floor_cap_advance_including_topup" or policy.method == "floor_cap_advance_earned_only" or policy.method == "cap_floor_advance_including_topup" or policy.method == "cap_floor_advance_earned_only" else "TERM_METHOD_REQUIRED";
  define floor_before_cap = policy.method == "floor_cap_advance_including_topup" or policy.method == "floor_cap_advance_earned_only";
  define cap_before_floor = policy.method == "cap_floor_advance_including_topup" or policy.method == "cap_floor_advance_earned_only";
  define cap_active = policy.method == "term_cap" or floor_before_cap or cap_before_floor;
  define floor_active = policy.method == "term_floor_at_end" or floor_before_cap or cap_before_floor;
  define advance_active = policy.method == "actual_funded_advance" or floor_before_cap or cap_before_floor;
  define earned_only = policy.method == "floor_cap_advance_earned_only" or policy.method == "cap_floor_advance_earned_only";
  require term.scope == fact_scope else "TERM_TERM_SCOPE";
  require term.period.start <= scope.period.start and scope.period.end <= term.period.end else "TERM_PERIOD_OUTSIDE_TERM";
  require term.approved_date <= term.recorded_date and term.recorded_date <= as_of and term.recorded_date <= term.period.start and term.observed_at < term.opening_utc else "TERM_AVAILABILITY";
  require term.observed_at < cutoff else "TERM_OBSERVATION_CUTOFF";
  require term.floor >= USD 0 and term.cap >= USD 0 and term.recoupable_minimum_face >= USD 0 else "TERM_EXACT_NONNEGATIVE_VALUE";
  require (policy.method != "term_cap" or (term.floor == USD 0 and term.recoupable_minimum_face == USD 0)) and (policy.method != "term_floor_at_end" or (term.cap == USD 0 and term.recoupable_minimum_face == USD 0)) and (policy.method != "actual_funded_advance" or (term.floor == USD 0 and term.cap == USD 0)) else "TERM_UNUSED_AMOUNT";
  define checked_evidence = for each row in evidence {
    require row.id != "" and row.source_kind != "" else "TERM_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "TERM_EVIDENCE_SCOPE";
    require row.observed_at < cutoff else "TERM_EVIDENCE_CUTOFF";
    require (row.source_kind == "complete_funding_population") == is_some(row.population) else "TERM_RECORD_FIELDS";
    require not is_some(row.population) or (require_some(row.population, "TERM_FUNDING_COMPLETENESS_SCOPE").term_id == term.id and term.period.start <= require_some(row.population, "TERM_FUNDING_COMPLETENESS_SCOPE").period.start and require_some(row.population, "TERM_FUNDING_COMPLETENESS_SCOPE").period.end <= term.period.end) else "TERM_FUNDING_COMPLETENESS_SCOPE";
    require not is_some(row.population) or (sum(require_some(row.population, "TERM_FUNDING_COMPLETENESS_SCOPE").funding_ids, id => if id != "" and sum(filter(require_some(row.population, "TERM_FUNDING_COMPLETENESS_SCOPE").funding_ids, other => other == id), other => 1) == 1 then 0 else 1) == 0 and sum(require_some(row.population, "TERM_FUNDING_COMPLETENESS_SCOPE").disbursement_ids, id => if id != "" and sum(filter(require_some(row.population, "TERM_FUNDING_COMPLETENESS_SCOPE").disbursement_ids, other => other == id), other => 1) == 1 then 0 else 1) == 0) else "TERM_FUNDING_POPULATION_CONTROL";
    yield row;
  };
  require sum(filter(checked_evidence, row => row.id == term.evidence_ref), row => 1) == 1 else "TERM_EVIDENCE_REQUIRED";
  require history == supplied_opening else "TERM_OPENING_SNAPSHOT";
  require history.scope == fact_scope and history.purpose == "term_guarantee_and_prepayment" else "TERM_OPENING_SCOPE";
  require history.policy_id == policy.id and history.policy_revision == policy.revision and history.method == policy.method and history.cap_reduction_order == policy.cap_reduction_order else "TERM_OPENING_METHOD";
  require history.term == term else "TERM_AMENDMENT_REQUIRED";
  require history.boundary == scope.period.start else "TERM_OPENING_BOUNDARY";
  require advance_active or history.prepayment == USD 0 else "TERM_ADVANCE_OUTSIDE_METHOD";
  define declared_opening = {term_earned: history.term_earned, term_recognized_entitlement: history.term_recognized_entitlement, term_cap_consumed: history.term_cap_consumed, total_funded: history.total_funded, total_recovered: history.total_recovered, prepayment: history.prepayment, term_closed: history.term_closed};
  require if history.origin == "genesis" then declared_opening == {term_earned: USD 0, term_recognized_entitlement: USD 0, term_cap_consumed: USD 0, total_funded: USD 0, total_recovered: USD 0, prepayment: USD 0, term_closed: false} and sum(history.period_history, row => 1) == 0 and history.source_case_id == "genesis" and scope.period.start == term.period.start and not is_some(predecessor) else history.origin == "prior_result" and is_some(predecessor) else "TERM_PREDECESSOR_REQUIRED";
  require history.origin == "genesis" or require_some(predecessor, "TERM_PREDECESSOR_REQUIRED").period.end == scope.period.start else "TERM_PREDECESSOR_BOUNDARY";
  require history.origin == "genesis" or (require_some(predecessor, "TERM_PREDECESSOR_REQUIRED").source_case_id == history.source_case_id and history.source_case_id != case_id and require_some(predecessor, "TERM_PREDECESSOR_REQUIRED").closing_state == history) else "TERM_PREDECESSOR_MISMATCH";
  define prior_periods = map(sort_by(history.period_history, row => row.period.start), row => {is_current: false, record: row});
  define periods = append(prior_periods, {is_current: true, record: {source_case_id: case_id, period: scope.period, earnings: earnings, fundings: fundings}});
  define replayed: {meters: {prepayment: Money<USD>, term_cap_consumed: Money<USD>, term_closed: Bool, term_earned: Money<USD>, term_recognized_entitlement: Money<USD>, total_funded: Money<USD>, total_recovered: Money<USD>}, boundary: Date, used_cases: List<Text>, earning_ids: List<Text>, funding_ids: List<Text>, disbursement_ids: List<Text>, earning_sources: List<Text>, funding_sources: List<Text>, history: List<{earnings: List<{amount: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_observed_at: Text, source_ref: Text, term_id: Text}>, fundings: List<{amount: Money<USD>, approved: Bool, disbursement_id: Text, evidence_ref: Text, funded_at: Instant, funded_date: Date, funded_utc_date: Date, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_funded_at: Text, source_observed_at: Text, source_ref: Text, term_id: Text}>, period: Period, source_case_id: Text}>, replays: List<{funding_population_status: Text, opening_meters: {prepayment: Money<USD>, term_cap_consumed: Money<USD>, term_closed: Bool, term_earned: Money<USD>, term_recognized_entitlement: Money<USD>, total_funded: Money<USD>, total_recovered: Money<USD>}, period: Period, source_case_id: Text, stages: {advance_active: Bool, available_prepayment: Money<USD>, cap_active: Bool, cap_applied: Money<USD>, cap_stage_input: Money<USD>, closing_meters: {prepayment: Money<USD>, term_cap_consumed: Money<USD>, term_closed: Bool, term_earned: Money<USD>, term_recognized_entitlement: Money<USD>, total_funded: Money<USD>, total_recovered: Money<USD>}, earned: Money<USD>, entitlement: Money<USD>, floor_active: Bool, floor_topup_before_cap: Money<USD>, is_term_end: Bool, new_actual_funding: Money<USD>, payable_calculated: Money<USD>, recovered: Money<USD>, recovery_base: Money<USD>, retained_earned: Money<USD>, retained_topup: Money<USD>, unmet_floor_at_term_end: Money<USD>}}>} = fold periods from {meters: {term_earned: USD 0, term_recognized_entitlement: USD 0, term_cap_consumed: USD 0, total_funded: USD 0, total_recovered: USD 0, prepayment: USD 0, term_closed: false}, boundary: term.period.start, used_cases: [], earning_ids: [], funding_ids: [], disbursement_ids: [], earning_sources: [], funding_sources: [], history: [], replays: []} with ledger, entry {
    define record = entry.record;
    require record.source_case_id != "" and sum(filter(ledger.used_cases, id => id == record.source_case_id), id => 1) == 0 and (entry.is_current or record.source_case_id != case_id) else "TERM_DUPLICATE_PERIOD_CASE";
    require ledger.boundary == record.period.start and (entry.is_current or record.period.end <= scope.period.start) and not ledger.meters.term_closed else "TERM_HISTORY_BOUNDARY";
    require not entry.is_current or (ledger.meters == declared_opening and (history.origin == "genesis" or sum(filter(history.period_history, row => row.period.end == scope.period.start and row.source_case_id == history.source_case_id), row => 1) == 1)) else "TERM_OPENING_HISTORY_RECONCILIATION";
    require term.period.start <= record.period.start and record.period.end <= term.period.end else "TERM_PERIOD_OUTSIDE_TERM";
    require advance_active or sum(record.fundings, row => 1) == 0 else "TERM_ADVANCE_OUTSIDE_METHOD";
    define populations = filter(checked_evidence, row => is_some(row.population) and require_some(row.population, "TERM_FUNDING_COMPLETENESS_SCOPE").period == record.period);
    require not advance_active or sum(populations, row => 1) > 0 else "TERM_FUNDING_POPULATION_REQUIRED";
    require not advance_active or sum(populations, row => 1) == 1 else "TERM_FUNDING_POPULATION_AMBIGUOUS";
    define checked_earnings = for each row in sort_by(record.earnings, event => event.id) {
      require row.id != "" and row.source_ref != "" else "TERM_IDENTITY_REQUIRED";
      require sum(filter(record.earnings, other => other.id == row.id), other => 1) == 1 else "TERM_DUPLICATE_ID";
      require sum(filter(ledger.earning_ids, id => id == row.id), id => 1) == 0 else "TERM_EARNING_ALREADY_RECOGNIZED";
      require row.scope == fact_scope and row.term_id == term.id else "TERM_FACT_SCOPE";
      require sum(filter(checked_evidence, support => support.id == row.evidence_ref), support => 1) == 1 else "TERM_EVIDENCE_REQUIRED";
      require row.observed_at < cutoff else "TERM_FACT_CUTOFF";
      require sum(filter(ledger.earning_sources, source => source == row.source_ref), source => 1) == 0 and sum(filter(record.earnings, other => other.source_ref == row.source_ref), other => 1) == 1 else "TERM_SOURCE_ALREADY_RECOGNIZED";
      require in_period(row.effective_date, record.period) else "TERM_EARNING_PERIOD";
      require row.amount >= USD 0 else "TERM_EXACT_NONNEGATIVE_VALUE";
      yield row;
    };
    define checked_fundings = for each row in sort_by(record.fundings, event => event.id) {
      require row.id != "" and row.source_ref != "" and row.disbursement_id != "" else "TERM_IDENTITY_REQUIRED";
      require sum(filter(record.fundings, other => other.id == row.id), other => 1) == 1 else "TERM_DUPLICATE_ID";
      require sum(filter(ledger.funding_ids, id => id == row.id), id => 1) == 0 else "TERM_FUNDING_ALREADY_RECOGNIZED";
      require sum(filter(ledger.disbursement_ids, id => id == row.disbursement_id), id => 1) == 0 and sum(filter(record.fundings, other => other.disbursement_id == row.disbursement_id), other => 1) == 1 else "TERM_DISBURSEMENT_ALREADY_RECOGNIZED";
      require row.scope == fact_scope and row.term_id == term.id else "TERM_FACT_SCOPE";
      require sum(filter(checked_evidence, support => support.id == row.evidence_ref), support => 1) == 1 else "TERM_EVIDENCE_REQUIRED";
      require row.observed_at < cutoff else "TERM_FACT_CUTOFF";
      require sum(filter(ledger.funding_sources, source => source == row.source_ref), source => 1) == 0 and sum(filter(record.fundings, other => other.source_ref == row.source_ref), other => 1) == 1 else "TERM_SOURCE_ALREADY_RECOGNIZED";
      require row.amount > USD 0 and row.approved else "TERM_ACTUAL_FUNDING_REQUIRED";
      require row.funded_date == row.funded_utc_date else "TERM_FUNDED_UTC_DATE";
      require in_period(row.funded_date, record.period) else "TERM_FUNDING_PERIOD";
      require row.funded_at <= row.observed_at else "TERM_FUNDING_OBSERVATION_ORDER";
      require sum(filter(checked_evidence, support => support.id == row.evidence_ref and support.source_kind == "actual_advance_funding" and row.funded_at <= support.observed_at), support => 1) == 1 else "TERM_ACTUAL_FUNDING_EVIDENCE";
      yield row;
    };
    define earned = sum(checked_earnings, row => row.amount);
    define funded = sum(checked_fundings, row => row.amount);
    require not advance_active or sum(populations, row => if sort_by(require_some(row.population, "TERM_FUNDING_COMPLETENESS_SCOPE").funding_ids, id => id) == sort_by(map(checked_fundings, fact => fact.id), id => id) and sort_by(require_some(row.population, "TERM_FUNDING_COMPLETENESS_SCOPE").disbursement_ids, id => id) == sort_by(map(checked_fundings, fact => fact.disbursement_id), id => id) and require_some(row.population, "TERM_FUNDING_COMPLETENESS_SCOPE").funded_total == funded then 1 else 0) == 1 else "TERM_FUNDING_POPULATION_CONTROL";
    define final = record.period.end == term.period.end;
    define remaining_cap = term.cap - ledger.meters.term_cap_consumed;
    define capped_earned = min(earned, remaining_cap);
    define floor_input = if cap_before_floor then capped_earned else earned;
    define floor_topup = if final and floor_active then max(USD 0, term.floor - ledger.meters.term_recognized_entitlement - floor_input) else USD 0;
    define cap_input = if cap_active then (if floor_before_cap then earned + floor_topup else earned) else USD 0;
    define cap_applied = if cap_active then min(cap_input, remaining_cap) else USD 0;
    define entitlement = if policy.method == "term_cap" or floor_before_cap then cap_applied else if cap_before_floor then cap_applied + floor_topup else if policy.method == "term_floor_at_end" then earned + floor_topup else earned;
    define retained_earned = if cap_before_floor or policy.method == "term_cap" then cap_applied else if floor_before_cap then min(earned, entitlement) else earned;
    define retained_topup = entitlement - retained_earned;
    define available = ledger.meters.prepayment + funded;
    require ledger.meters.total_funded + funded <= term.recoupable_minimum_face else "TERM_FUNDED_CEILING";
    define recovery_base = if advance_active then (if earned_only then retained_earned else entitlement) else USD 0;
    define recovered = min(available, recovery_base);
    define payable = entitlement - recovered;
    define next_meters = {term_earned: ledger.meters.term_earned + earned, term_recognized_entitlement: ledger.meters.term_recognized_entitlement + entitlement, term_cap_consumed: ledger.meters.term_cap_consumed + cap_applied, total_funded: ledger.meters.total_funded + funded, total_recovered: ledger.meters.total_recovered + recovered, prepayment: available - recovered, term_closed: final};
    require next_meters.prepayment == next_meters.total_funded - next_meters.total_recovered and payable + recovered == entitlement else "TERM_RECONCILIATION";
    require not cap_active or next_meters.term_cap_consumed <= term.cap else "TERM_CAP_RECONCILIATION";
    define stages = {earned: earned, is_term_end: final, floor_active: floor_active, cap_active: cap_active, advance_active: advance_active, floor_topup_before_cap: floor_topup, cap_stage_input: cap_input, cap_applied: cap_applied, retained_earned: retained_earned, retained_topup: retained_topup, entitlement: entitlement, new_actual_funding: funded, available_prepayment: available, recovery_base: recovery_base, recovered: recovered, payable_calculated: payable, unmet_floor_at_term_end: if final and floor_active then max(USD 0, term.floor - next_meters.term_recognized_entitlement) else USD 0, closing_meters: next_meters};
    define result = {source_case_id: record.source_case_id, period: record.period, opening_meters: ledger.meters, stages: stages, funding_population_status: if advance_active then (if sum(checked_fundings, row => 1) > 0 then "complete_with_funding" else "complete_no_events") else "not_applicable"};
    yield {meters: next_meters, boundary: record.period.end, used_cases: append(ledger.used_cases, record.source_case_id), earning_ids: concat(ledger.earning_ids, map(checked_earnings, row => row.id)), funding_ids: concat(ledger.funding_ids, map(checked_fundings, row => row.id)), disbursement_ids: concat(ledger.disbursement_ids, map(checked_fundings, row => row.disbursement_id)), earning_sources: concat(ledger.earning_sources, map(checked_earnings, row => row.source_ref)), funding_sources: concat(ledger.funding_sources, map(checked_fundings, row => row.source_ref)), history: append(ledger.history, {source_case_id: record.source_case_id, period: record.period, earnings: checked_earnings, fundings: checked_fundings}), replays: append(ledger.replays, result)};
  };
  define selected: Option<{funding_population_status: Text, opening_meters: {prepayment: Money<USD>, term_cap_consumed: Money<USD>, term_closed: Bool, term_earned: Money<USD>, term_recognized_entitlement: Money<USD>, total_funded: Money<USD>, total_recovered: Money<USD>}, period: Period, source_case_id: Text, stages: {advance_active: Bool, available_prepayment: Money<USD>, cap_active: Bool, cap_applied: Money<USD>, cap_stage_input: Money<USD>, closing_meters: {prepayment: Money<USD>, term_cap_consumed: Money<USD>, term_closed: Bool, term_earned: Money<USD>, term_recognized_entitlement: Money<USD>, total_funded: Money<USD>, total_recovered: Money<USD>}, earned: Money<USD>, entitlement: Money<USD>, floor_active: Bool, floor_topup_before_cap: Money<USD>, is_term_end: Bool, new_actual_funding: Money<USD>, payable_calculated: Money<USD>, recovered: Money<USD>, recovery_base: Money<USD>, retained_earned: Money<USD>, retained_topup: Money<USD>, unmet_floor_at_term_end: Money<USD>}}> = fold filter(replayed.replays, row => row.source_case_id == case_id) from none() with unused, row { yield some(row); };
  define current = require_some(selected, "TERM_CURRENT_PERIOD_REQUIRED");
  closing history = {scope: fact_scope, purpose: "term_guarantee_and_prepayment", policy_id: policy.id, policy_revision: policy.revision, method: policy.method, cap_reduction_order: policy.cap_reduction_order, term: term, boundary: scope.period.end, origin: "prior_result", source_case_id: case_id, term_earned: replayed.meters.term_earned, term_recognized_entitlement: replayed.meters.term_recognized_entitlement, term_cap_consumed: replayed.meters.term_cap_consumed, total_funded: replayed.meters.total_funded, total_recovered: replayed.meters.total_recovered, prepayment: replayed.meters.prepayment, term_closed: replayed.meters.term_closed, period_history: replayed.history};
  emit "comparison" = {source_case_id: case_id, period: scope.period, method: policy.method, opening_meters: current.opening_meters, is_term_end: current.stages.is_term_end, floor_active: current.stages.floor_active, cap_active: current.stages.cap_active, advance_active: current.stages.advance_active, earned: current.stages.earned, floor_topup_before_cap: current.stages.floor_topup_before_cap, cap_stage_input: current.stages.cap_stage_input, cap_applied: current.stages.cap_applied, retained_earned: current.stages.retained_earned, retained_topup: current.stages.retained_topup, entitlement: current.stages.entitlement, new_actual_funding: current.stages.new_actual_funding, available_prepayment: current.stages.available_prepayment, recovery_base: current.stages.recovery_base, recovered: current.stages.recovered, payable_calculated: current.stages.payable_calculated, unmet_floor_at_term_end: current.stages.unmet_floor_at_term_end, closing_meters: current.stages.closing_meters, funding_population_status: current.funding_population_status, settlement_payment_evidence_status: "no_event_supplied", status_meaning: "calculated entitlement/recovery/payable; actual funding is separate from unknown settlement payment"};
  emit "period_replays" = replayed.replays;
  emit "current_facts" = {earnings: sort_by(earnings, row => row.id), fundings: sort_by(fundings, row => row.id)};
  emit "reconciliation" = current.stages.payable_calculated + current.stages.recovered == current.stages.entitlement and replayed.meters.prepayment == replayed.meters.total_funded - replayed.meters.total_recovered;
}
