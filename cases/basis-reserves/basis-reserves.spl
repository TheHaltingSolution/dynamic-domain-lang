  define zero_totals = {gross: USD 0, added: USD 0, applied_returns: USD 0, released: USD 0, net_receipts: USD 0, fee: USD 0, allocation: USD 0};
  define empty_vintages: List<{added: Money<USD>, applied_returns: Money<USD>, available: Money<USD>, cash_line_ref: Text, claim_ids: List<Text>, due_date: Date, election_id: Text, id: Text, origin_date: Date, receipt_id: Text, release_ids: List<Tuple<Text, Text>>, released: Money<USD>, reserve_elected: Bool, return_ids: List<Text>}> = [];
  define empty_movements: List<{allocation: Money<USD>, authority_id: Option<Text>, claim_id: Option<Text>, election_id: Option<Text>, fee: Money<USD>, gross: Money<USD>, id: Tuple<Text, Text>, kind: Text, movement_date: Date, net_receipts: Money<USD>, receipt_id: Text, release: Money<USD>, reserve_addition: Money<USD>, return_applied: Money<USD>, source_ref: Option<Text>, vintage_id: Text}> = [];
  define empty_snapshots: List<{added: Money<USD>, allocation: Money<USD>, applied_returns: Money<USD>, as_of: Date, checkpoint_id: Text, closing_reserve: Money<USD>, cutoff: Instant, fee: Money<USD>, gross: Money<USD>, id: Text, movements: List<{allocation: Money<USD>, authority_id: Option<Text>, claim_id: Option<Text>, election_id: Option<Text>, fee: Money<USD>, gross: Money<USD>, id: Tuple<Text, Text>, kind: Text, movement_date: Date, net_receipts: Money<USD>, receipt_id: Text, release: Money<USD>, reserve_addition: Money<USD>, return_applied: Money<USD>, source_ref: Option<Text>, vintage_id: Text}>, net_receipts: Money<USD>, period: Period, released: Money<USD>, source_case_id: Text, source_cutoff: Text, vintages: List<{added: Money<USD>, applied_returns: Money<USD>, available: Money<USD>, cash_line_ref: Text, claim_ids: List<Text>, due_date: Date, election_id: Text, id: Text, origin_date: Date, receipt_id: Text, release_ids: List<Tuple<Text, Text>>, released: Money<USD>, reserve_elected: Bool, return_ids: List<Text>}>}> = [];
  define empty_text: List<Text> = [];
  define empty_keys: List<Tuple<Text, Text>> = [];
  define empty_days: List<Date> = [];
  define none_text: Option<Text> = none();
  define replayed = fold ordered_checkpoints from {vintages: empty_vintages, cumulative: zero_totals, movements: empty_movements, snapshots: empty_snapshots} with ledger, checkpoint {
    define before = checkpoint.cutoff;
    require authority.observed_at < before and authority_support.observed_at < before and checkpoint.evidence_observed_at < before else "BR_SOURCE_AFTER_CUTOFF";
    define populations_for_checkpoint = filter(checked_populations, row => row.checkpoint_id == checkpoint.id);
    require sum(populations_for_checkpoint, row => 1) == 1 and sum(populations_for_checkpoint, row => if row.complete then 1 else 0) == 1 else "BR_COMPLETE_POPULATION_REQUIRED";
    define control_slot: Option<{authority_ids: List<Text>, checkpoint_id: Text, complete: Bool, election_ids: List<Text>, evidence_observed_at: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, other_adjustment_ids: List<Text>, other_adjustment_total: Money<USD>, receipt_ids: List<Text>, receipt_total: Money<USD>, return_ids: List<Text>, return_total: Money<USD>, source_ref: Text}> = fold populations_for_checkpoint from none() with slot, row { yield some(row); };
    define control = require_some(control_slot, "BR_COMPLETE_POPULATION_REQUIRED");
    require control.observed_at < before and control.evidence_observed_at < before else "BR_SOURCE_AFTER_CUTOFF";
