// Complete original-history replay and actual adjacent state; children are classifications.
schedule QuantizedAllocation language "spl/0.1-draft" core "spl-core/0.1-draft" schema "spl-data/0.1-draft" {
  input scope: SettlementScope;
  input project: Id<Asset>;
  input fact_scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>};
  input case_id: Text;
  input cutoff: Instant;
  input cutoff_source: Text;
  input as_of: Date;
  input policy: {evidence_class: Text, id: Text, limits: {historical_periods: Int, parents_per_period: Int, recipients: Int}, method: Text, parent_rounding: Text, quota_basis: Text, residual_order: Text, revision: Text};
  input recipients: List<{evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text}>;
  input parents: List<{amount: Money<USD>, amount_source: Text, authority_id: Id<AllocationRecord>, effective_date: Date, evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text, upstream_ref: Text}>;
  input authorities: List<{approved: Bool, approved_date: Date, effective: Period, evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, method: Text, observed_at: Instant, observed_at_source: Text, parent_id: Id<AllocationRecord>, parent_upstream_ref: Text, recipient_ids: List<Id<AllocationRecord>>, recorded_date: Date, residual_order: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text, supplied_allocation_ids: List<Id<AllocationRecord>>, terms: List<{evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, recipient_id: Id<AllocationRecord>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text, weight: Ratio, weight_source: Text}>}>;
  input supplied_allocations: List<{amount: Money<USD>, amount_source: Text, evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, parent_id: Id<AllocationRecord>, recipient_id: Id<AllocationRecord>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text}>;
  input evidence: List<{approval_ref: Id<Decision>, evidence_ref: Text, id: Id<AllocationRecord>, kind: Text, observed_at: Instant, observed_at_source: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_kind: Text}>;
  input supplied_opening: {boundary: Date, consumed_parent_ids: List<Id<AllocationRecord>>, consumed_upstream_refs: List<Text>, history: List<{as_of: Date, authorities: List<{approved: Bool, approved_date: Date, effective: Period, evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, method: Text, observed_at: Instant, observed_at_source: Text, parent_id: Id<AllocationRecord>, parent_upstream_ref: Text, recipient_ids: List<Id<AllocationRecord>>, recorded_date: Date, residual_order: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text, supplied_allocation_ids: List<Id<AllocationRecord>>, terms: List<{evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, recipient_id: Id<AllocationRecord>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text, weight: Ratio, weight_source: Text}>}>, cutoff: Instant, cutoff_source: Text, parents: List<{amount: Money<USD>, amount_source: Text, authority_id: Id<AllocationRecord>, effective_date: Date, evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text, upstream_ref: Text}>, period: Period, source_case_id: Text, supplied_allocations: List<{amount: Money<USD>, amount_source: Text, evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, parent_id: Id<AllocationRecord>, recipient_id: Id<AllocationRecord>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text}>}>, origin: Text, policy: {evidence_class: Text, id: Text, limits: {historical_periods: Int, parents_per_period: Int, recipients: Int}, method: Text, parent_rounding: Text, quota_basis: Text, residual_order: Text, revision: Text}, purpose: Text, recipient_registry: List<{evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text}>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text};
  input predecessor: Option<{closing_state: {boundary: Date, consumed_parent_ids: List<Id<AllocationRecord>>, consumed_upstream_refs: List<Text>, history: List<{as_of: Date, authorities: List<{approved: Bool, approved_date: Date, effective: Period, evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, method: Text, observed_at: Instant, observed_at_source: Text, parent_id: Id<AllocationRecord>, parent_upstream_ref: Text, recipient_ids: List<Id<AllocationRecord>>, recorded_date: Date, residual_order: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text, supplied_allocation_ids: List<Id<AllocationRecord>>, terms: List<{evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, recipient_id: Id<AllocationRecord>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text, weight: Ratio, weight_source: Text}>}>, cutoff: Instant, cutoff_source: Text, parents: List<{amount: Money<USD>, amount_source: Text, authority_id: Id<AllocationRecord>, effective_date: Date, evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text, upstream_ref: Text}>, period: Period, source_case_id: Text, supplied_allocations: List<{amount: Money<USD>, amount_source: Text, evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, parent_id: Id<AllocationRecord>, recipient_id: Id<AllocationRecord>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text}>}>, origin: Text, policy: {evidence_class: Text, id: Text, limits: {historical_periods: Int, parents_per_period: Int, recipients: Int}, method: Text, parent_rounding: Text, quota_basis: Text, residual_order: Text, revision: Text}, purpose: Text, recipient_registry: List<{evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text}>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text}, period: Period, source_case_id: Text}>;
  opening ledger: {boundary: Date, consumed_parent_ids: List<Id<AllocationRecord>>, consumed_upstream_refs: List<Text>, history: List<{as_of: Date, authorities: List<{approved: Bool, approved_date: Date, effective: Period, evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, method: Text, observed_at: Instant, observed_at_source: Text, parent_id: Id<AllocationRecord>, parent_upstream_ref: Text, recipient_ids: List<Id<AllocationRecord>>, recorded_date: Date, residual_order: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text, supplied_allocation_ids: List<Id<AllocationRecord>>, terms: List<{evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, recipient_id: Id<AllocationRecord>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text, weight: Ratio, weight_source: Text}>}>, cutoff: Instant, cutoff_source: Text, parents: List<{amount: Money<USD>, amount_source: Text, authority_id: Id<AllocationRecord>, effective_date: Date, evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text, upstream_ref: Text}>, period: Period, source_case_id: Text, supplied_allocations: List<{amount: Money<USD>, amount_source: Text, evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, parent_id: Id<AllocationRecord>, recipient_id: Id<AllocationRecord>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text}>}>, origin: Text, policy: {evidence_class: Text, id: Text, limits: {historical_periods: Int, parents_per_period: Int, recipients: Int}, method: Text, parent_rounding: Text, quota_basis: Text, residual_order: Text, revision: Text}, purpose: Text, recipient_registry: List<{evidence_ref: Id<AllocationRecord>, id: Id<AllocationRecord>, observed_at: Instant, observed_at_source: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_ref: Text}>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text} from "quantized-allocation/original-parents";
  require policy.id == "SYNTHETIC-QUANTIZED-ALLOCATION-01" and policy.revision == "1" and policy.parent_rounding == "half_even_once_to_cent" and policy.quota_basis == "rounded_parent_target" and policy.residual_order == "descending_remainder_then_ascii_recipient_id" and policy.evidence_class == "research_assumption" and policy.limits.recipients == 8 and policy.limits.parents_per_period == 4 and policy.limits.historical_periods == 8 else "QA_POLICY";
  require policy.method == "exact_weights_largest_remainder" or policy.method == "authorized_supplied_cents" else "QA_METHOD";
  require case_id != "" else "QA_ASCII_ID";
  require fact_scope.contract_id == scope.agreement_id and fact_scope.participant_id == scope.participant_id and fact_scope.pool_id == scope.pool_id and fact_scope.asset_id == project and fact_scope.currency == "USD" else "QA_FACT_SCOPE";
  require ledger == supplied_opening else "QA_OPENING_SNAPSHOT";
  require ledger.scope == fact_scope and ledger.purpose == "quantized_parent_allocation" else "QA_OPENING_SCOPE";
  define registry = sort_by(recipients, row => row.id);
  require ledger.policy == policy and sort_by(ledger.recipient_registry, row => row.id) == registry else "QA_PINNED_TERMS";
  require ledger.boundary == scope.period.start else "QA_OPENING_BOUNDARY";
  require sum(ledger.history, row => 1) <= 8 else "QA_HISTORY_BOUND";
  require if ledger.origin == "genesis" then sum(ledger.history, row => 1) == 0 and sum(ledger.consumed_parent_ids, identity => 1) == 0 and sum(ledger.consumed_upstream_refs, identity => 1) == 0 and ledger.source_case_id == "genesis" and not is_some(predecessor) else ledger.origin == "prior_result" and is_some(predecessor) else "QA_PREDECESSOR_REQUIRED";
  require ledger.origin == "genesis" or (require_some(predecessor, "QA_PREDECESSOR_REQUIRED").closing_state == ledger and require_some(predecessor, "QA_PREDECESSOR_REQUIRED").source_case_id == ledger.source_case_id and ledger.source_case_id != case_id and require_some(predecessor, "QA_PREDECESSOR_REQUIRED").period.start < require_some(predecessor, "QA_PREDECESSOR_REQUIRED").period.end and require_some(predecessor, "QA_PREDECESSOR_REQUIRED").period.end == scope.period.start) else "QA_PREDECESSOR_MISMATCH";
  define checked_evidence = for each support in evidence {
    require sum(filter(evidence, other => other.id == support.id), other => 1) == 1 else "QA_DUPLICATE_ID";
    require support.scope == fact_scope and support.source_kind != "" else "QA_EVIDENCE_SCOPE";
    require support.observed_at == instant(support.observed_at_source) and support.observed_at < cutoff else "QA_EVIDENCE_CUTOFF";
    yield support;
  };
  define history = sort_by(ledger.history, row => row.period.start);
  define historical_chain = fold history from {started: false, boundary: scope.period.start, source_case_id: ledger.source_case_id} with previous, row {
    require row.period.start < row.period.end and row.period.end <= scope.period.start and (not previous.started or previous.boundary == row.period.start) else "QA_HISTORY_BOUNDARY";
    require row.source_case_id != case_id and sum(filter(history, other => other.source_case_id == row.source_case_id), other => 1) == 1 else "QA_DUPLICATE_HISTORY_CASE";
    yield {started: true, boundary: row.period.end, source_case_id: row.source_case_id};
  };
  require not historical_chain.started or historical_chain.boundary == scope.period.start and historical_chain.source_case_id == ledger.source_case_id else "QA_OPENING_HISTORY_RECONCILIATION";
  define historical_parents: List<{id: Id<AllocationRecord>, source_ref: Text, upstream_ref: Text}> = fold history from [] with prior, row {
    yield concat(prior, map(row.parents, parent => {id: parent.id, upstream_ref: parent.upstream_ref, source_ref: parent.source_ref}));
  };
  require ledger.consumed_parent_ids == sort_by(map(historical_parents, row => row.id), identity => identity) and ledger.consumed_upstream_refs == sort_by(map(historical_parents, row => row.upstream_ref), identity => identity) else "QA_OPENING_HISTORY_RECONCILIATION";
  define current = {source_case_id: case_id, period: scope.period, as_of: as_of, cutoff: cutoff, cutoff_source: cutoff_source, parents: parents, authorities: authorities, supplied_allocations: supplied_allocations};
  define records = append(history, current);
  define all_parents = concat(historical_parents, map(parents, row => {id: row.id, upstream_ref: row.upstream_ref, source_ref: row.source_ref}));
  define checked_parent_origins = for each row in all_parents {
    require sum(filter(all_parents, other => other.id == row.id), other => 1) == 1 else "QA_ALREADY_CONSUMED_ID";
    require sum(filter(all_parents, other => other.upstream_ref == row.upstream_ref or other.source_ref == row.source_ref), other => 1) == 1 else "QA_PARENT_SOURCE_ALREADY_CONSUMED";
    yield row.id;
  };
  define authority_ids: List<Id<AllocationRecord>> = fold records from [] with prior, row { yield concat(prior, map(row.authorities, authority => authority.id)); };
  define allocation_ids: List<Id<AllocationRecord>> = fold records from [] with prior, row { yield concat(prior, map(row.supplied_allocations, allocation => allocation.id)); };
  define checked_authority_ids = for each identity in authority_ids {
    require sum(filter(authority_ids, other => other == identity), other => 1) == 1 else "QA_ALREADY_CONSUMED_ID";
    yield identity;
  };
  define checked_allocation_ids = for each identity in allocation_ids {
    require sum(filter(allocation_ids, other => other == identity), other => 1) == 1 else "QA_ALREADY_CONSUMED_ID";
    yield identity;
  };
  // A transient wrapper reuses the validated original case identity. The full
  // original record remains present; this avoids anonymous instance IDs that
  // recursively quote the entire source history in every nested observation.
  define keyed_records = map(records, row => {id: row.source_case_id, original: row});
  define replay = for each row in keyed_records {
    define calculated = allocate_parent_record(fact_scope, policy.method, cutoff, registry, checked_evidence, row.original);
    yield {id: row.id, allocations: calculated.allocations, normalized: calculated.normalized};
  };
  define selected = require_some(lookup(make_map(filter(replay, row => row.id == case_id), row => true, row => row), true), "QA_CURRENT_REQUIRED");
  define original_total = sum(selected.allocations, row => row.original_parent_amount);
  define target_total = sum(selected.allocations, row => row.rounded_target);
  define child_total = sum(selected.allocations, row => row.child_total);
  require child_total == target_total else "QA_CHILD_CONSERVATION";
  closing ledger = {scope: fact_scope, purpose: "quantized_parent_allocation", policy: policy, recipient_registry: registry, boundary: scope.period.end, origin: "prior_result", source_case_id: case_id,
                    consumed_parent_ids: sort_by(map(all_parents, row => row.id), identity => identity), consumed_upstream_refs: sort_by(map(all_parents, row => row.upstream_ref), identity => identity), history: map(replay, row => row.normalized)};
  emit "comparison" = {source_case_id: case_id, period: scope.period, method: policy.method, original_parent_total: original_total, rounded_target_total: target_total, child_allocation_total: child_total,
                       parent_rounding_delta_total: target_total - original_total, parent_count: sum(parents, row => 1), recognized_amount_space: "selected_children_only", payment_status: "not_a_payment_measure"};
  emit "allocations" = selected.allocations;
  emit "reconciliation" = child_total == target_total;
}

