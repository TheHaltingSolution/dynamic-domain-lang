      require sum(filter(ledger.revision_authorities, other => other.id == row.id), other => 1) + sum(filter(ledger.offset_authorities, other => other.id == row.id), other => 1) == 0 and sum(filter(record.revision_authorities, other => other.id == row.id), other => 1) + sum(filter(record.offset_authorities, other => other.id == row.id), other => 1) == 1 else "OFFSET_AUTHORITY_ALREADY_RECOGNIZED";
      require sum(filter(ledger.revision_authorities, other => other.source_ref == row.source_ref), other => 1) + sum(filter(ledger.offset_authorities, other => other.source_ref == row.source_ref), other => 1) == 0 and sum(filter(record.revision_authorities, other => other.source_ref == row.source_ref), other => 1) + sum(filter(record.offset_authorities, other => other.source_ref == row.source_ref), other => 1) == 1 else "OFFSET_SOURCE_ALREADY_RECOGNIZED";
      require row.effective == record.period and row.approved and row.approved_date <= row.recorded_date and row.recorded_date <= record.as_of else "OFFSET_AUTHORITY_ASOF_SCOPE";
      require row.claim_id != "" and row.amount > USD 0 else "OFFSET_POSITIVE_AMOUNT_REQUIRED";
      require row.kind == "original_overpayment" or row.kind == "other_supplied_claim" else "OFFSET_CLAIM_KIND";
      require row.priority == (if (row.kind == "original_overpayment") == (policy.priority_recipe == "clawback_first") then 0 else 1) else "OFFSET_EXPLICIT_PRIORITY";
      require row.sequence >= 0 and sum(filter(record.offset_authorities, other => other.sequence == row.sequence), other => 1) == 1 and sum(filter(ledger.claims, claim => claim.sequence == row.sequence), claim => 1) == 0 else "OFFSET_CLAIM_SEQUENCE";
      require in_period(row.eligible_from, record.period) and row.recorded_date <= row.eligible_from else "OFFSET_PROSPECTIVE_DATE";
      yield row;
    };
    define registered = fold sort_by(checked_offset_authorities, row => tuple(row.eligible_from, row.sequence)) from ledger.claims with claims_step, authority {
      require sum(filter(claims_step, claim => claim.id == authority.claim_id), claim => 1) == 0 else "OFFSET_CLAIM_ALREADY_REGISTERED";
      require authority.kind != "original_overpayment" or authority.origin_id == original.id else "OFFSET_CLAIM_ORIGINAL";
      define old_original_principal = sum(filter(claims_step, claim => claim.kind == "original_overpayment"), claim => claim.authorized_amount);
      define prospective_returned = sum(filter(all_reversals, reversal => reversal.recognition_date <= authority.eligible_from), reversal => reversal.returned_basis);
      require authority.kind != "original_overpayment" or old_original_principal + authority.amount <= max(USD 0, paid - gross + prospective_returned * original.rate) else "OFFSET_OVERPAYMENT_AUTHORIZATION_CAPACITY";
      require authority.kind != "other_supplied_claim" or sum(filter(checked_others, row => row.id == authority.origin_id), row => 1) == 1 else "OFFSET_OTHER_CLAIM_REQUIRED";
      require authority.kind != "other_supplied_claim" or sum(filter(claims_step, claim => claim.kind == "other_supplied_claim" and claim.origin_id == authority.origin_id), claim => claim.authorized_amount) + authority.amount <= sum(filter(checked_others, row => row.id == authority.origin_id), row => row.amount) else "OFFSET_OTHER_AUTHORIZATION_CAPACITY";
      yield append(claims_step, {id: authority.claim_id, kind: authority.kind, origin_id: authority.origin_id, authorized_amount: authority.amount, priority: authority.priority, sequence: authority.sequence, eligible_from: authority.eligible_from, authority_id: authority.id, authority_record: authority, actual_cash_recovered: USD 0, earning_offsets: USD 0, remaining: authority.amount});
    };
    define recovery_populations = filter(checked_evidence, row => is_some(row.cash_population) and require_some(row.cash_population, "OFFSET_RECOVERY_POPULATION_REQUIRED").period == record.period);
    require sum(recovery_populations, row => 1) > 0 else "OFFSET_RECOVERY_POPULATION_REQUIRED";
    require sum(recovery_populations, row => 1) == 1 else "OFFSET_RECOVERY_POPULATION_AMBIGUOUS";
    require sum(recovery_populations, row => if row.observed_at < record.cutoff then 0 else 1) == 0 else "OFFSET_EVIDENCE_CUTOFF";
    define checked_cash_recoveries = for each row in sort_by(record.cash_recoveries, event => event.id) {
      require row.id != "" and row.source_ref != "" else "OFFSET_IDENTITY_REQUIRED";
      require sum(filter(record.cash_recoveries, other => other.id == row.id), other => 1) == 1 else "OFFSET_DUPLICATE_ID";
      require sum(filter(ledger.cash_recoveries, other => other.id == row.id), other => 1) == 0 else "OFFSET_EVENT_ALREADY_RECOGNIZED";
      require row.scope == fact_scope else "OFFSET_FACT_SCOPE";
      require sum(filter(checked_evidence, support => support.id == row.evidence_ref), support => 1) == 1 else "OFFSET_EVIDENCE_REQUIRED";
      require row.observed_at < record.cutoff else "OFFSET_FACT_CUTOFF";
      require sum(filter(checked_evidence, support => support.id == row.evidence_ref and support.observed_at < record.cutoff), support => 1) == 1 else "OFFSET_EVIDENCE_CUTOFF";
      require sum(filter(ledger.cash_recoveries, other => other.source_ref == row.source_ref), other => 1) == 0 and sum(filter(record.cash_recoveries, other => other.source_ref == row.source_ref), other => 1) == 1 else "OFFSET_SOURCE_ALREADY_RECOGNIZED";
      require sum(filter(checked_evidence, support => support.id == row.evidence_ref and support.source_kind == "actual_cash_recovery"), support => 1) == 1 else "OFFSET_ACTUAL_CASH_EVIDENCE";
      require row.receipt_id != "" and sum(filter(ledger.cash_recoveries, other => other.receipt_id == row.receipt_id), other => 1) == 0 and sum(filter(record.cash_recoveries, other => other.receipt_id == row.receipt_id), other => 1) == 1 else "OFFSET_BANK_RECEIPT_ALREADY_RECOGNIZED";
      require row.received_date == row.received_utc_date else "OFFSET_CASH_UTC_DATE";
      require in_period(row.received_date, record.period) and row.received_at <= row.observed_at else "OFFSET_CASH_DATE";
      require row.amount > USD 0 else "OFFSET_POSITIVE_AMOUNT_REQUIRED";
      yield row;
    };
    define checked_recovery_applications = for each row in sort_by(record.recovery_applications, event => event.id) {
      require row.id != "" and row.source_ref != "" else "OFFSET_IDENTITY_REQUIRED";
      require sum(filter(record.recovery_applications, other => other.id == row.id), other => 1) == 1 else "OFFSET_DUPLICATE_ID";
      require sum(filter(ledger.recovery_applications, other => other.id == row.id), other => 1) == 0 else "OFFSET_EVENT_ALREADY_RECOGNIZED";
      require row.scope == fact_scope else "OFFSET_FACT_SCOPE";
      require sum(filter(checked_evidence, support => support.id == row.evidence_ref), support => 1) == 1 else "OFFSET_EVIDENCE_REQUIRED";
      require row.observed_at < record.cutoff else "OFFSET_FACT_CUTOFF";
      require sum(filter(checked_evidence, support => support.id == row.evidence_ref and support.observed_at < record.cutoff), support => 1) == 1 else "OFFSET_EVIDENCE_CUTOFF";
      require sum(filter(ledger.recovery_applications, other => other.source_ref == row.source_ref), other => 1) == 0 and sum(filter(record.recovery_applications, other => other.source_ref == row.source_ref), other => 1) == 1 else "OFFSET_SOURCE_ALREADY_RECOGNIZED";
      require sum(filter(checked_cash_recoveries, receipt => receipt.id == row.cash_id), receipt => 1) == 1 and sum(filter(registered, claim => claim.id == row.claim_id), claim => 1) == 1 else "OFFSET_CASH_APPLICATION_REFERENCE";
      define claim_option: Option<{actual_cash_recovered: Money<USD>, authority_id: Text, authority_record: {amount: Money<USD>, approved: Bool, approved_date: Date, claim_id: Text, effective: Period, eligible_from: Date, evidence_ref: Text, id: Text, kind: Text, observed_at: Instant, origin_id: Text, priority: Int, recorded_date: Date, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_amount: Text, source_observed_at: Text, source_ref: Text}, authorized_amount: Money<USD>, earning_offsets: Money<USD>, eligible_from: Date, id: Text, kind: Text, origin_id: Text, priority: Int, remaining: Money<USD>, sequence: Int}> = fold filter(registered, claim => claim.id == row.claim_id) from none() with unused, claim { yield some(claim); };
      define selected_claim = require_some(claim_option, "OFFSET_CASH_APPLICATION_REFERENCE");
      require sum(filter(checked_cash_recoveries, receipt => receipt.id == row.cash_id and receipt.received_date >= selected_claim.eligible_from), receipt => 1) == 1 else "OFFSET_CASH_BEFORE_AUTHORITY";
      require sum(filter(checked_cash_recoveries, receipt => receipt.id == row.cash_id and receipt.observed_at <= row.observed_at), receipt => 1) == 1 and selected_claim.authority_record.observed_at <= row.observed_at else "OFFSET_APPLICATION_DATE_ORDER";
      require row.amount > USD 0 else "OFFSET_POSITIVE_AMOUNT_REQUIRED";
      yield row;
    };
    require sum(checked_cash_recoveries, receipt => if sum(filter(checked_recovery_applications, row => row.cash_id == receipt.id), row => row.amount) == receipt.amount then 0 else 1) == 0 else "OFFSET_CASH_APPLICATION_CONSERVATION";
    define current_cash = sum(checked_cash_recoveries, row => row.amount);
    require sum(recovery_populations, row => if sort_by(require_some(row.cash_population, "OFFSET_RECOVERY_POPULATION_REQUIRED").cash_ids, id => id) == sort_by(map(checked_cash_recoveries, receipt => receipt.id), id => id) and sort_by(require_some(row.cash_population, "OFFSET_RECOVERY_POPULATION_REQUIRED").receipt_ids, id => id) == sort_by(map(checked_cash_recoveries, receipt => receipt.receipt_id), id => id) and sort_by(require_some(row.cash_population, "OFFSET_RECOVERY_POPULATION_REQUIRED").application_ids, id => id) == sort_by(map(checked_recovery_applications, application => application.id), id => id) and require_some(row.cash_population, "OFFSET_RECOVERY_POPULATION_REQUIRED").cash_total == current_cash then 1 else 0) == 1 else "OFFSET_RECOVERY_POPULATION_CONTROL";
    require sum(recovery_populations, population => sum(checked_cash_recoveries, row => if row.observed_at <= population.observed_at then 0 else 1) + sum(checked_recovery_applications, row => if row.observed_at <= population.observed_at then 0 else 1)) == 0 else "OFFSET_POPULATION_OBSERVATION_ORDER";
    define cash_applied = for each claim in registered {
      define recovered = sum(filter(checked_recovery_applications, row => row.claim_id == claim.id), row => row.amount);
      require recovered <= claim.remaining else "OFFSET_CLAIM_CASH_OVERAPPLICATION";
      yield {id: claim.id, kind: claim.kind, origin_id: claim.origin_id, authorized_amount: claim.authorized_amount, priority: claim.priority, sequence: claim.sequence, eligible_from: claim.eligible_from, authority_id: claim.authority_id, authority_record: claim.authority_record, actual_cash_recovered: claim.actual_cash_recovered + recovered, earning_offsets: claim.earning_offsets, remaining: claim.remaining - recovered};
    };
    define checked_future_earnings = for each row in sort_by(record.future_earnings, event => event.id) {
      require row.id != "" and row.source_ref != "" else "OFFSET_IDENTITY_REQUIRED";
      require sum(filter(record.future_earnings, other => other.id == row.id), other => 1) == 1 else "OFFSET_DUPLICATE_ID";
      require sum(filter(ledger.future_earnings, other => other.id == row.id), other => 1) == 0 else "OFFSET_EVENT_ALREADY_RECOGNIZED";
      require row.scope == fact_scope else "OFFSET_FACT_SCOPE";
      require sum(filter(checked_evidence, support => support.id == row.evidence_ref), support => 1) == 1 else "OFFSET_EVIDENCE_REQUIRED";
      require row.observed_at < record.cutoff else "OFFSET_FACT_CUTOFF";
      require sum(filter(checked_evidence, support => support.id == row.evidence_ref and support.observed_at < record.cutoff), support => 1) == 1 else "OFFSET_EVIDENCE_CUTOFF";
      require sum(filter(ledger.future_earnings, other => other.source_ref == row.source_ref), other => 1) == 0 and sum(filter(record.future_earnings, other => other.source_ref == row.source_ref), other => 1) == 1 else "OFFSET_SOURCE_ALREADY_RECOGNIZED";
      require in_period(row.effective_date, record.period) else "OFFSET_EARNING_PERIOD";
      require row.sequence >= 0 and sum(filter(record.future_earnings, other => other.sequence == row.sequence), other => 1) == 1 else "OFFSET_EARNING_SEQUENCE";
      require sum(filter(ledger.future_earnings, other => other.upstream_ref == row.upstream_ref), other => 1) == 0 and sum(filter(record.future_earnings, other => other.upstream_ref == row.upstream_ref), other => 1) == 1 else "OFFSET_EARNING_LINE_ALREADY_RECOGNIZED";
