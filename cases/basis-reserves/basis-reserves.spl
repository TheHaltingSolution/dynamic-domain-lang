    require sum(filter(checked_returns, other => other.claim_id == row.claim_id), other => 1) == 1 and sum(filter(checked_returns, other => other.return_line_ref == row.return_line_ref), other => 1) == 1 else "BR_RETURN_CLAIM_ALIAS";
