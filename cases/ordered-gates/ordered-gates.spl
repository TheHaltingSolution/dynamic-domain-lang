      require support_decision.observed_at <= row.observed_at else "GATE_EVIDENCE_NOT_KNOWN";
      define parents = filter(event_headers, parent => parent.id == row.parent_event_id and parent.decision_id == row.id and parent.original_ref == row.event_ref);
      require sum(parents, parent => 1) == 1 and sum(parents, parent => if row.observed_at <= parent.observed_at then 1 else 0) == 1 else "GATE_CLASSIFICATION_TARGET";
      require sum(filter(source_decisions, other => other.parent_event_id == row.parent_event_id), other => 1) == 1 else "GATE_CLASSIFICATION_REPLAY_OR_ALIAS";
      require row.reason != "" and sum(filter(previous_seen.decision_ids, old => old == row.id), old => 1) == 0 else "GATE_CLASSIFICATION_REPLAY_OR_ALIAS";
