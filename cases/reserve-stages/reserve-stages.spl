oney<USD>, established_date: Date, fee_assessed_once: Money<USD>, fee_key: List<Text>, id: Text, liquidated: Bool, original_addition: Money<USD>, original_election: Text, original_receipt: Text, raw_addition: Money<USD>, released: Money<USD>, reserve_measure: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>, purpose: Text}, tranches: List<{due_date: Date, fraction: Option<Ratio>, id: Text, kind: Text, processed: Bool}>}>}}>, receipt_ids: List<Text>, receipt_refs: List<Text>, unknown: List<Text>, vintages: List<{applied: Money<USD>, available: Money<USD>, established_date: Date, fee_assessed_once: Money<USD>, fee_key: List<Text>, id: Text, liquidated: Bool, original_addition: Money<USD>, original_election: Text, original_receipt: Text, raw_addition: Money<USD>, released: Money<USD>, reserve_measure: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>, purpose: Text}, tranches: List<{due_date: Date, fraction: Option<Ratio>, id: Text, kind: Text, processed: Bool}>}>}>, origin: Text, source_case_id: Text, transport_profile: Text} from "reserve-stages/full-original-history";
  define empty_vintages: List<{applied: Money<USD>, available: Money<USD>, established_date: Date, fee_assessed_once: Money<USD>, fee_key: List<Text>, id: Text, liquidated: Bool, original_addition: Money<USD>, original_election: Text, original_receipt: Text, raw_addition: Money<USD>, released: Money<USD>, reserve_measure: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>, purpose: Text}, tranches: List<{due_date: Date, fraction: Option<Ratio>, id: Text, kind: Text, processed: Bool}>}> = [];
