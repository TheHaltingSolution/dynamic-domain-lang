    require paid <= original_earned else "REPLAY_ORIGINAL_PAYMENT_CEILING";
    yield {id: row.id, amount: paid};
  };
  define actual_paid = sum(paid_by_receipt, row => row.amount);
  define paid_population = registry.payment_population;
  
      require paid_population.id != "" and paid_population.source_ref != "" and paid_population.scope == fact_scope else "REPLAY_FACT_SCOPE";
      require paid_population.observed_at < minimum_cutoff else "REPLAY_SOURCE_OBSERVATION";
      define supporting_paid_population = require_some(lookup(static_evidence_index, paid_population.evidence_slot), "REPLAY_EVIDENCE_REQUIRED");
      require supporting_paid_population.id == paid_population.evidence_ref and supporting_paid_population.kind == "complete_historical_payment_population" and supporting_paid_population.observed_at <= paid_population.observed_at else "REPLAY_SOURCE_OBSERVATION";

  define unique_payment_population = fold sort_by(paid_population.payment_ids, id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_ID_LIST"; yield id; };
  define unique_application_population = fold sort_by(paid_population.application_ids, id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_ID_LIST"; yield id; };
  require paid_population.complete and some(paid_population.through_period_id) == original_chain.previous and sum(paid_population.payment_ids, id => 1) <= 8 and sum(paid_population.application_ids, id => 1) <= 8 and sort_by(paid_population.payment_ids, id => id) == sort_by(map(checked_payments, row => row.id), id => id) and sort_by(paid_population.application_ids, id => id) == sort_by(map(checked_applications, row => row.id), id => id) and paid_population.paid_total == actual_paid else "REPLAY_COMPLETE_PAID_POPULATION";
  define original_end_utc: Instant = require_some(fold original_period_rows from none() with selected, row { yield some(row.period_end_utc); }, "REPLAY_ORIGINAL_OPENING");
  require paid_population.observed_at >= original_end_utc and sum(filter(checked_payments, row => row.observed_at > paid_population.observed_at), row => 1) == 0 and sum(filter(checked_applications, row => row.observed_at > paid_population.observed_at), row => 1) == 0 else "REPLAY_PAYMENT_POPULATION_OBSERVATION";
  define original_issue_rows = for each period_entry in original_periods {
    define issue: {basis_total: Money<USD>, closing_cumulative_basis: Money<USD>, complete: Bool, earned: Money<USD>, evidence_ref: Text, evidence_slot: Int, id: Text, issued_at: Instant, issued_at_utc_date: Date, observed_at: Instant, opening_cumulative_basis: Money<USD>, original_ref: Text, period_id: Text, predecessor_issue_id: Option<Text>, receipt_ids: List<Text>, result_ref: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Text, pool_id: Id<Pool>, purpose: Text}, source_ref: Text} = require_some(fold filter(checked_issues, row => row.period_id == period_entry.id) from none() with selected, row { yield some(row); }, "REPLAY_COMPLETE_ISSUED_CHAIN");
    define original: Text = require_some(fold filter(original_registry.issued_artifacts, row => row.id == issue.id) from none() with selected, row { yield some(row.raw_original); }, "REPLAY_ORIGINAL_REGISTRY_POPULATION");
