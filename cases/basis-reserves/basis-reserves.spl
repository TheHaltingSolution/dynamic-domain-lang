        define vintage_slot: Option<{added: Money<USD>, applied_returns: Money<USD>, available: Money<USD>, cash_line_ref: Text, claim_ids: List<Text>, due_date: Date, election_id: Text, id: Text, origin_date: Date, receipt_id: Text, release_ids: List<Tuple<Text, Text>>, released: Money<USD>, reserve_elected: Bool, return_ids: List<Text>}> = fold filter(return_ledger.vintages, candidate_vintage => candidate_vintage.id == returned.vintage_id) from none() with slot, candidate_vintage { yield some(candidate_vintage); };
