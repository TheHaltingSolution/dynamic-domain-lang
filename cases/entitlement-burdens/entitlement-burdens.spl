    require frame.id == original_frame.id and frame.period == original_frame.period else "BURDEN_ORIGINAL_FRAME_POPULATION";
    define original_population_tables = original_frame.originals;
    define population_raw_accounts = original_population_tables.accounts;
    define population_typed_accounts = frame.population_ids.accounts;
    require map(population_raw_accounts, row => row.id) == population_typed_accounts and sum(population_raw_accounts, row => if row.raw_original != "" then 1 else 0) == sum(population_typed_accounts, id => 1) else "BURDEN_ORIGINAL_RECORD_POPULATION";
    define population_raw_terms = original_population_tables.terms;
    define population_typed_terms = frame.population_ids.terms;
