    define recognition_history = if view.mode == "final" then append(ledger.history, {id: view.recognition_id, view_id: view.id, period_id: period.id, source_case_id: view.source_case_id, cutoff: view.cutoff, source_cutoff: view.source_cutoff, current_earnings: current_earnings, catchup: catchup, amount: new_recognition, attributions: attributions}) else ledger.history;
