    require sum(visible_authorities, row => if row.observed_at < before and row.evidence_observed_at < before and row.observed_at <= control.observed_at then 0 else 1) == 0 else "BR_POPULATION_OBSERVATION_ORDER";
    require sum(control.other_adjustment_ids, id => 1) == 0 and control.other_adjustment_total == USD 0 else "BR_OTHER_ADJUSTMENT_VARIANT_REQUIRED";
    define clearances_for_checkpoint = filter(checked_clearances, row => row.checkpoint_id == checkpoint.id);
