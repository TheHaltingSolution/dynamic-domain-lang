  require coordinator.id != "" and coordinator.currency == "USD" and coordinator.purpose == "cross_contract_entitlement_burden" else "BURDEN_COORDINATOR_METADATA";
  require policy.method == "accrued_basis_current_period" or policy.method == "paid_basis_current_period" else "BURDEN_METHOD";
  require policy.id == "SYNTHETIC-CONTRACT-BURDENS-01" else "BURDEN_SELECTED_POLICY";
  require policy.revision == "1" else "BURDEN_SELECTED_POLICY";
  require policy.measurement == "original_pre_burden_current_participation" else "BURDEN_SELECTED_POLICY";
  require policy.cap == "cumulative_original_authority" else "BURDEN_SELECTED_POLICY";
  require policy.cap_excess == "consume_no_carry" else "BURDEN_SELECTED_POLICY";
  require policy.shortfall == "atomic_reject_after_cap" else "BURDEN_SELECTED_POLICY";
  require policy.threshold == "basis_at_least_minimum" else "BURDEN_SELECTED_POLICY";
  require policy.request_limit == "one_canonical_authority_source_period_measurement" else "BURDEN_SELECTED_POLICY";
  require policy.order == "unique_authorized_sequence" else "BURDEN_SELECTED_POLICY";
  require policy.rounding == "exact_no_rounding" else "BURDEN_SELECTED_POLICY";
  require policy.observation_date_basis == "UTC" else "BURDEN_SELECTED_POLICY";
  require policy.late_payment_reopening == "unsupported" else "BURDEN_SELECTED_POLICY";
  require policy.evidence_class == "research_assumption" else "BURDEN_SELECTED_POLICY";
  require research.review_locator == "LD03:390-399;B-C10-BURDEN;RR04:no-C10-specific-rule" else "BURDEN_REVIEW_SCOPE";
  require history == supplied_opening else "BURDEN_CANONICAL_OPENING_MISMATCH";
  define frame_count = sum(frames, frame => 1);
  require frame_count > 0 and frame_count <= 4 else "BURDEN_HISTORY_BOUND";
  define unique_cases = fold sort_by(map(frames, frame => frame.id), id => id) from {started: false, previous: "", count: 0} with step, id { require id != "" and (not step.started or id != step.previous) else "BURDEN_CASE_ID_REPLAY"; yield {started: true, previous: id, count: step.count + 1}; };
  require unique_cases.count == frame_count else "BURDEN_CASE_ID_REPLAY";
  define metadata = fold frames from {started: false, boundary: scope.period.start} with step, frame {
    require frame.period.start < frame.period.end and frame.as_of_next == frame.period.end and frame.cutoff >= frame.period_end_utc else "BURDEN_COMPLETE_PERIOD_VIEW";
    require not step.started or frame.period.start == step.boundary else "BURDEN_HISTORY_ADJACENCY";
    yield {started: true, boundary: frame.period.end};
  };
  require metadata.boundary == scope.period.end else "BURDEN_CURRENT_PERIOD";
  define current_frames = filter(frames, frame => frame.period == scope.period);
  require sum(current_frames, frame => 1) == 1 and sum(current_frames, frame => if frame.cutoff == cutoff then 1 else 0) == 1 else "BURDEN_CURRENT_PERIOD";
  define frame_headers = for each frame in frames {
    yield {id: frame.id, period: frame.period, population_ids: {accounts: map(frame.accounts, row => row.id), terms: map(frame.terms, row => row.id), receipts: map(frame.receipts, row => row.id), authorizations: map(frame.authorizations, row => row.id), requests: map(frame.requests, row => row.id), payments: map(frame.payments, row => row.id), applications: map(frame.applications, row => row.id), receipt_populations: map(frame.receipt_populations, row => row.id), payment_populations: map(frame.payment_populations, row => row.id), evidence: map(frame.evidence, row => row.id)}, evidence_slots: map(frame.evidence, row => row.slot), static_slots: concat(concat(map(frame.accounts, row => row.evidence_slot), map(frame.terms, row => row.evidence_slot)), map(frame.authorizations, row => row.evidence_slot))};
  };
  define frame_index = make_map(frame_headers, row => row.period.start, row => row);
  define original_tables = map(original_frames, row => {id: row.id, period: row.period, receipts: row.originals.receipts, applications: row.originals.applications, requests: row.originals.requests});
  define original_table_index = make_map(original_tables, row => row.period.start, row => row);
  define original_sources = map(original_frames, row => {id: row.id, period: row.period, raw_original: row.raw_original});
  define original_source_index = make_map(original_sources, row => row.period.start, row => row);
