        define revised: {added: Money<USD>, applied_returns: Money<USD>, available: Money<USD>, cash_line_ref: Text, claim_ids: List<Text>, due_date: Date, election_id: Text, id: Text, origin_date: Date, receipt_id: Text, release_ids: List<Tuple<Text, Text>>, released: Money<USD>, reserve_elected: Bool, return_ids: List<Text>} = {id: vintage.id, receipt_id: vintage.receipt_id, cash_line_ref: vintage.cash_line_ref, election_id: vintage.election_id, reserve_elected: vintage.reserve_elected, origin_date: vintage.origin_date, due_date: vintage.due_date, added: vintage.added, applied_returns: vintage.applied_returns + returned.amount, released: vintage.released, available: vintage.available - returned.amount, return_ids: append(vintage.return_ids, returned.id), claim_ids: append(vintage.claim_ids, returned.claim_id), release_ids: vintage.release_ids};
        define movement: {allocation: Money<USD>, authority_id: Option<Text>, claim_id: Option<Text>, election_id: Option<Text>, fee: Money<USD>, gross: Money<USD>, id: Tuple<Text, Text>, kind: Text, movement_date: Date, net_receipts: Money<USD>, receipt_id: Text, release: Money<USD>, reserve_addition: Money<USD>, return_applied: Money<USD>, source_ref: Option<Text>, vintage_id: Text} = {id: tuple("return", returned.id), kind: "matched_actual_return", movement_date: day, receipt_id: returned.receipt_id, vintage_id: returned.vintage_id, election_id: none(), source_ref: some(returned.source_ref), claim_id: some(returned.claim_id), authority_id: some(returned.authority_id), gross: USD 0, reserve_addition: USD 0, return_applied: returned.amount, release: USD 0, net_receipts: USD 0, fee: USD 0, allocation: USD 0};
        yield {vintages: map(return_ledger.vintages, row => if row.id == vintage.id then revised else row), movements: append(return_ledger.movements, movement)};
      };
      define released_vintages = for each vintage in sort_by(applied_returns.vintages, row => row.id) {
        require not (vintage.due_date == day and vintage.available > USD 0) or sum(vintage.release_ids, key => 1) == 0 else "BR_VINTAGE_ALREADY_RELEASED";
        yield if vintage.due_date == day and vintage.available > USD 0 then {id: vintage.id, receipt_id: vintage.receipt_id, cash_line_ref: vintage.cash_line_ref, election_id: vintage.election_id, reserve_elected: vintage.reserve_elected, origin_date: vintage.origin_date, due_date: vintage.due_date, added: vintage.added, applied_returns: vintage.applied_returns, released: vintage.released + vintage.available, available: USD 0, return_ids: vintage.return_ids, claim_ids: vintage.claim_ids, release_ids: append(vintage.release_ids, tuple("due-release", vintage.id))} else vintage;
      };
      define release_movements = for each vintage in filter(sort_by(applied_returns.vintages, row => row.id), row => row.due_date == day and row.available > USD 0) {
        define release_fee = vintage.available * authority.fee_rate;
