    yield row;
  };
  define no_replacements: List<{base_amount: Money<USD>, effective_date: Date, effective_date_utc: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, original_basis_ref: Text, original_receipt_id: Text, original_ref: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Text, pool_id: Id<Pool>, purpose: Text}, source_case_id: Text, source_ref: Text}> = [];
  
    define original_calculation: {basis: Money<USD>, controls: List<{closing_cumulative_basis: Money<USD>, earned: Money<USD>, gross_basis: Money<USD>, opening_cumulative_basis: Money<USD>, period: Period, period_id: Text, receipt_details: List<{closing_cumulative_basis: Money<USD>, earned: Money<USD>, lower_basis: Money<USD>, opening_cumulative_basis: Money<USD>, original_basis: Money<USD>, receipt_id: Text, replacement_id: Option<Text>, selected_basis: Money<USD>, term_id: Text, upper_basis: Money<USD>}>}>} = fold original_periods from {basis: USD 0, controls: []} with original_calculation_ledger, original_calculation_period_entry {
      define original_calculation_economic_rows = sort_by(filter(checked_original_receipts, original_calculation_row => original_calculation_row.period_id == original_calculation_period_entry.id), original_calculation_row => tuple(original_calculation_row.effective_date, original_calculation_row.sequence));
      define original_calculation_unique_keys: Option<Tuple<Date,Int>> = fold original_calculation_economic_rows from none() with original_calculation_previous, original_calculation_row {
        require not is_some(original_calculation_previous) or require_some(original_calculation_previous, "REPLAY_UNRESOLVED_RECEIPT_ORDER") != tuple(original_calculation_row.effective_date, original_calculation_row.sequence) else "REPLAY_UNRESOLVED_RECEIPT_ORDER";
        yield some(tuple(original_calculation_row.effective_date, original_calculation_row.sequence));
      };
      define original_calculation_meter: {basis: Money<USD>, earned: Money<USD>, details: List<{closing_cumulative_basis: Money<USD>, earned: Money<USD>, lower_basis: Money<USD>, opening_cumulative_basis: Money<USD>, original_basis: Money<USD>, receipt_id: Text, replacement_id: Option<Text>, selected_basis: Money<USD>, term_id: Text, upper_basis: Money<USD>}>} = fold original_calculation_economic_rows from {basis: original_calculation_ledger.basis, earned: USD 0, details: []} with original_calculation_step, original_calculation_row {
        define original_calculation_terms_selected = filter(registry.terms, original_calculation_item => original_calculation_item.id == original_calculation_row.term_id);
        require sum(original_calculation_terms_selected, original_calculation_item => 1) == 1 else "REPLAY_TERM_REFERENCE";
        define original_calculation_term: {approved: Bool, approved_date: Date, approved_date_utc: Instant, effective: Period, effective_end_ordinal: Int, effective_end_utc: Instant, evidence_ref: Text, evidence_slot: Int, flat_rate: Ratio, id: Text, kind: Text, lower_rate: Ratio, observed_at: Instant, original_ref: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Text, pool_id: Id<Pool>, purpose: Text}, source_ref: Text, threshold: Money<USD>, upper_rate: Ratio} = require_some(fold original_calculation_terms_selected from none() with original_calculation_selected, original_calculation_item { yield some(original_calculation_item); }, "REPLAY_TERM_REFERENCE");
        require original_calculation_term.effective == original_calculation_period_entry.period else "REPLAY_TERM_REFERENCE";
        require original_calculation_term.approved_date <= original_calculation_row.effective_date and original_calculation_term.observed_at <= original_calculation_row.observed_at else "REPLAY_TERM_NOT_KNOWN_OR_EFFECTIVE";
        define original_calculation_active_rows = filter(no_replacements, original_calculation_item => original_calculation_item.original_receipt_id == original_calculation_row.id);
        require sum(original_calculation_active_rows, original_calculation_item => 1) <= 1 else "REPLAY_CORRECTION_ALREADY_CONSUMED";
        define original_calculation_selected_basis = fold original_calculation_active_rows from original_calculation_row.base_amount with original_calculation_selected, original_calculation_item { yield original_calculation_item.base_amount; };
        define original_calculation_replacement: Option<Text> = fold original_calculation_active_rows from none() with original_calculation_selected, original_calculation_item { yield some(original_calculation_item.id); };
        define original_calculation_lower = if original_calculation_term.kind == "flat_ratio" then original_calculation_selected_basis else min(original_calculation_selected_basis, max(original_calculation_term.threshold - original_calculation_step.basis, USD 0));
        define original_calculation_upper = original_calculation_selected_basis - original_calculation_lower;
        define original_calculation_earned = if original_calculation_term.kind == "flat_ratio" then original_calculation_selected_basis * original_calculation_term.flat_rate else original_calculation_lower * original_calculation_term.lower_rate + original_calculation_upper * original_calculation_term.upper_rate;
        define original_calculation_closing_basis = original_calculation_step.basis + original_calculation_selected_basis;
        define original_calculation_detail: {closing_cumulative_basis: Money<USD>, earned: Money<USD>, lower_basis: Money<USD>, opening_cumulative_basis: Money<USD>, original_basis: Money<USD>, receipt_id: Text, replacement_id: Option<Text>, selected_basis: Money<USD>, term_id: Text, upper_basis: Money<USD>} = {receipt_id: original_calculation_row.id, original_basis: original_calculation_row.base_amount, selected_basis: original_calculation_selected_basis, replacement_id: original_calculation_replacement, term_id: original_calculation_term.id, opening_cumulative_basis: original_calculation_step.basis, lower_basis: original_calculation_lower, upper_basis: original_calculation_upper, earned: original_calculation_earned, closing_cumulative_basis: original_calculation_closing_basis};
        yield {basis: original_calculation_closing_basis, earned: original_calculation_step.earned + original_calculation_earned, details: append(original_calculation_step.details, original_calculation_detail)};
