    require sum(checked_evidence, row => if sum(filter(used_evidence_ids, id => id == row.id), id => 1) > 0 then 1 else 0) == count_evidence else "GATE_UNUSED_EVIDENCE";
    define path_state: {continuous: Bool, costs: Money<USD>, latched: Bool, path: List<{channel: Text, economic_instant: Instant, eligible: Bool, id: Text, kind: Text, latch_after: Bool, latch_before: Bool, post_costs: Money<USD>, post_receipts: Money<USD>, post_surplus: Money<USD>, pre_costs: Money<USD>, pre_receipts: Money<USD>, pre_surplus: Money<USD>, row_slot: Int, selected_full_amount: Money<USD>, sequence: Int}>, receipts: Money<USD>} = fold ordered from {receipts: ledger.receipts, costs: ledger.costs, latched: ledger.latched, continuous: ledger.receipts >= ledger.costs, path: []} with step, event {
      define opening_surplus = step.receipts - step.costs;
      define next_receipts = step.receipts + (if event.kind == "receipt" then event.selected_full_amount else USD 0);
      define next_costs = step.costs + (if event.kind == "cost" then event.selected_full_amount else USD 0);
      define next_surplus = next_receipts - next_costs;
      define next_latch = step.latched or (event.kind == "receipt" and event.selected_full_amount > USD 0 and next_receipts >= next_costs);
      define path_row = {id: event.id, kind: event.kind, row_slot: event.row_slot, sequence: event.sequence, economic_instant: event.economic_instant, selected_full_amount: event.selected_full_amount, eligible: event.eligible, channel: event.channel, pre_receipts: step.receipts, pre_costs: step.costs, pre_surplus: opening_surplus, post_receipts: next_receipts, post_costs: next_costs, post_surplus: next_surplus, latch_before: step.latched, latch_after: next_latch};
      yield {receipts: next_receipts, costs: next_costs, latched: next_latch, continuous: step.continuous and next_surplus >= USD 0, path: append(step.path, path_row)};
    };
    define period_eligible = if policy.method == "opening_gate" then ledger.receipts >= ledger.costs else if policy.method == "closing_gate" then path_state.receipts >= path_state.costs else path_state.continuous;
    define path = for each row in path_state.path {
      define is_period_method = policy.method == "opening_gate" or policy.method == "closing_gate" or policy.method == "continuous_history";
      define active = row.kind == "receipt" and row.eligible;
      define applicable = active and (if is_period_method then period_eligible else if policy.method == "split_latch" then row.latch_before or row.post_surplus >= USD 0 else if policy.method == "next_row_reopen" then row.pre_surplus >= USD 0 else row.post_surplus >= USD 0);
      define split_amount = max(USD 0, row.post_surplus) - max(USD 0, row.pre_surplus);
      define admission = if not active then USD 0 else if is_period_method then (if applicable then row.selected_full_amount else USD 0) else if policy.method == "split_latch" then (if row.latch_before then row.selected_full_amount else split_amount) else if policy.method == "full_cross_reopen" then (if row.post_surplus > USD 0 then row.selected_full_amount else USD 0) else if policy.method == "next_row_reopen" then (if applicable then row.selected_full_amount else USD 0) else split_amount;
      define proxy = if row.kind == "cost" then 0.0 else if row.channel == "home_video" then terms.video_proxy else 1.0;
      define reason = if row.kind == "cost" then "cost_updates_gate_only" else if not row.eligible then "explicitly_excluded_receipt" else if is_period_method then (if applicable then "period_gate_eligible" else "period_gate_inapplicable") else if applicable and admission == USD 0 then "eligible_zero_at_equality" else if applicable then "eligible_receipt" else "gate_below_receipt";
      yield {id: row.id, kind: row.kind, row_slot: row.row_slot, economic_instant: row.economic_instant, sequence: row.sequence, selected_full_amount: row.selected_full_amount, pre_receipts: row.pre_receipts, pre_costs: row.pre_costs, pre_surplus: row.pre_surplus, post_receipts: row.post_receipts, post_costs: row.post_costs, post_surplus: row.post_surplus, latch_before: row.latch_before, latch_after: row.latch_after, gross_branch_applicable: applicable, reason: reason, admitted_full_receipt: admission, proxy_factor: proxy, payout_base_contribution: admission * proxy};
    };
    define no_eligible_receipts = sum(filter(receipt_events, row => row.eligible), row => 1) == 0;
    define any_applicable = if no_eligible_receipts then (if policy.method == "opening_gate" or policy.method == "closing_gate" or policy.method == "continuous_history" then period_eligible else path_state.receipts >= path_state.costs or (policy.method == "split_latch" and path_state.latched)) else sum(path, row => if row.gross_branch_applicable then 1 else 0) > 0;
    define payout_base = sum(path, row => row.payout_base_contribution);
    define gross = payout_base * terms.gross_rate;
    define net_candidate = supplied_net_subtotal * terms.net_rate;
    define entitlement = max(gross, net_candidate);
    define result = {source_case_id: current_id, period: current_period, status: "calculated", opening_receipts: ledger.receipts, opening_costs: ledger.costs, opening_latch: ledger.latched, current_full_receipts: sum(receipt_events, row => row.selected_full_amount), current_eligible_costs: sum(cost_events, row => row.selected_full_amount), closing_receipts: path_state.receipts, closing_costs: path_state.costs, closing_latch: path_state.latched, continuous_current_history: path_state.continuous, payout_base: payout_base, gross_candidate: gross, gross_status: if gross > USD 0 then "computed_positive" else if any_applicable then "computed_zero" else "inapplicable", supplied_net_subtotal: supplied_net_subtotal, net_candidate: net_candidate, net_status: "computed_zero", selected_branch: if gross > net_candidate then "gross" else if gross < net_candidate or not any_applicable then "net" else "tie", calculated_unissued_entitlement: entitlement, path: path, payment_evidence_status: "not_part_of_profile", bank_movement_created: false};
    define seen = {ids: sort_by(concat(previous_seen.ids, current_event_ids), id => id), refs: sort_by(concat(previous_seen.refs, current_original_refs), id => id), decision_ids: sort_by(concat(previous_seen.decision_ids, ids_decisions), id => id), decision_refs: sort_by(concat(previous_seen.decision_refs, current_decision_refs), id => id)};
    yield {receipts: path_state.receipts, costs: path_state.costs, latched: path_state.latched, seen: seen, recognized: ledger.recognized + entitlement, snapshots: append(ledger.snapshots, {id: current_id, period: current_period, result: result, seen: seen, recognized: ledger.recognized + entitlement})};
  };
  define raw_headers = for each source in original_frames {
    define originals = source.originals;
    define event_originals = concat(originals.receipts, originals.costs);
    define event_index = make_map(event_originals, row => row.row_slot, row => row);
    define hurdle = fold originals.aggregate_hurdles from "" with selected, row { yield row.raw_original; };
    define net = fold originals.net_worksheets from "" with selected, row { yield row.raw_original; };
    yield {id: source.id, period: source.period, raw_original: source.raw_original, event_index: event_index, aggregate_hurdle: hurdle, net_worksheet: net, population_records: map(originals.populations, row => row.raw_original)};
  };
  define raw_header_index = make_map(raw_headers, row => row.period.start, row => row);
  define complete_snapshots = for each snapshot in replayed.snapshots {
    define original = require_some(lookup(raw_header_index, snapshot.period.start), "GATE_ORIGINAL_FRAME_POPULATION");
    require original.id == snapshot.id and original.period == snapshot.period else "GATE_ORIGINAL_FRAME_POPULATION";
    define path = for each row in snapshot.result.path {
      define event_original = require_some(lookup(original.event_index, row.row_slot), "GATE_SOURCE_ROW_REQUIRED");
      require event_original.id == row.id and event_original.kind == row.kind else "GATE_SOURCE_ROW_REQUIRED";
      yield {original: event_original.raw_original, id: row.id, kind: row.kind, row_slot: row.row_slot, sequence: row.sequence, economic_instant: row.economic_instant, pre_costs: row.pre_costs, pre_surplus: row.pre_surplus, post_surplus: row.post_surplus, post_receipts: row.post_receipts, selected_full_amount: row.selected_full_amount, payout_base_contribution: row.payout_base_contribution, admitted_full_receipt: row.admitted_full_receipt, post_costs: row.post_costs, pre_receipts: row.pre_receipts, latch_before: row.latch_before, latch_after: row.latch_after, gross_branch_applicable: row.gross_branch_applicable, reason: row.reason, proxy_factor: row.proxy_factor};
    };
    yield {id: snapshot.id, period: snapshot.period, seen: snapshot.seen, recognized: snapshot.recognized, result: {source_case_id: snapshot.result.source_case_id, period: snapshot.result.period, status: snapshot.result.status, current_eligible_costs: snapshot.result.current_eligible_costs, closing_receipts: snapshot.result.closing_receipts, calculated_unissued_entitlement: snapshot.result.calculated_unissued_entitlement, payout_base: snapshot.result.payout_base, opening_costs: snapshot.result.opening_costs, net_candidate: snapshot.result.net_candidate, gross_candidate: snapshot.result.gross_candidate, closing_costs: snapshot.result.closing_costs, opening_receipts: snapshot.result.opening_receipts, supplied_net_subtotal: snapshot.result.supplied_net_subtotal, current_full_receipts: snapshot.result.current_full_receipts, opening_latch: snapshot.result.opening_latch, closing_latch: snapshot.result.closing_latch, continuous_current_history: snapshot.result.continuous_current_history, bank_movement_created: snapshot.result.bank_movement_created, gross_status: snapshot.result.gross_status, net_status: snapshot.result.net_status, selected_branch: snapshot.result.selected_branch, payment_evidence_status: snapshot.result.payment_evidence_status, path: path, aggregate_hurdle: original.aggregate_hurdle, net_worksheet: original.net_worksheet, population_records: original.population_records}};
  };
  define complete_snapshot_index = make_map(complete_snapshots, row => row.period.start, row => row);
  define current = require_some(lookup(complete_snapshot_index, scope.period.start), "GATE_CURRENT_PERIOD");
  require current.period == scope.period else "GATE_CURRENT_PERIOD";
  define current_frame_cutoff = fold filter(frames, row => row.id == current.id) from cutoff with selected, row { yield row.cutoff; };
  require current_frame_cutoff == cutoff else "GATE_CURRENT_PERIOD";
  define history_records = for each snapshot in complete_snapshots {
    define original = require_some(lookup(raw_header_index, snapshot.period.start), "GATE_ORIGINAL_FRAME_POPULATION");
    require original.id == snapshot.id else "GATE_ORIGINAL_FRAME_POPULATION";
    yield {id: snapshot.id, period: snapshot.period, record: {facts: original.raw_original, result: snapshot.result}};
  };
  define material_states: List<{boundary: Date, id: Text, state: {boundary: Date, detail: Option<{consumed_classification_ids: List<Text>, consumed_classification_refs: List<Text>, consumed_event_ids: List<Text>, consumed_original_refs: List<Text>, costs: Money<USD>, history: List<{facts: Text, result: {aggregate_hurdle: Text, bank_movement_created: Bool, calculated_unissued_entitlement: Money<USD>, closing_costs: Money<USD>, closing_latch: Bool, closing_receipts: Money<USD>, continuous_current_history: Bool, current_eligible_costs: Money<USD>, current_full_receipts: Money<USD>, gross_candidate: Money<USD>, gross_status: Text, net_candidate: Money<USD>, net_status: Text, net_worksheet: Text, opening_costs: Money<USD>, opening_latch: Bool, opening_receipts: Money<USD>, path: List<{admitted_full_receipt: Money<USD>, economic_instant: Instant, gross_branch_applicable: Bool, id: Text, kind: Text, latch_after: Bool, latch_before: Bool, original: Text, payout_base_contribution: Money<USD>, post_costs: Money<USD>, post_receipts: Money<USD>, post_surplus: Money<USD>, pre_costs: Money<USD>, pre_receipts: Money<USD>, pre_surplus: Money<USD>, proxy_factor: Ratio, reason: Text, row_slot: Int, selected_full_amount: Money<USD>, sequence: Int}>, payment_evidence_status: Text, payout_base: Money<USD>, period: Period, population_records: List<Text>, selected_branch: Text, source_case_id: Text, status: Text, supplied_net_subtotal: Money<USD>}}>, latched: Bool, receipts: Money<USD>, recognized_entitlement: Money<USD>, schema_version: Text}>, identity_codec: Text, origin: Text, original_frames: List<{id: Text, period: Period, raw_original: Text}>, policy: {amendments: Text, continuous: Text, event_order: Text, evidence_class: Text, fee_offset: Text, id: Text, latch: Text, method: Text, net: Text, reserve_movements: Text, revision: Text, rounding: Text}, registry: {genesis_date: Date, net_pool_id: Text, terms: {effective_end: Date, effective_start: Date, evidence_ref: Text, gross_rate: Ratio, id: Text, net_rate: Ratio, observed_at: Instant, original_ref: Text, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text, video_proxy: Ratio}, work: {eligible: Bool, evidence_ref: Text, id: Text, observed_at: Instant, original_ref: Text, purchaser_produced: Bool, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text}}, registry_original: Text, research: {professional_approval: Text, references: List<{locator: Text, path: Text, sha256: Text}>, source_boundary: Text}, research_original: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Id<Participant>, pool_id: Text, purpose: Text}, source_case_id: Option<Text>, transport_profile: Text}}> = for each snapshot in filter(complete_snapshots, row => row.period == scope.period or row.period.end == scope.period.start) {
    define records = map(filter(history_records, row => row.period.end <= snapshot.period.end), row => row.record);
    yield {id: snapshot.id, boundary: snapshot.period.end, state: {transport_profile: "ordered-gates-original-json/1", identity_codec: "unicode-utf8-hex/1", scope: fact_scope, policy: policy, registry: registry, research: research, registry_original: registry_original, research_original: research_original, origin: "prior_result", boundary: snapshot.period.end, source_case_id: some(snapshot.id), original_frames: [], detail: some({schema_version: "ordered-gate-state/1", receipts: snapshot.result.closing_receipts, costs: snapshot.result.closing_costs, latched: snapshot.result.closing_latch, history: records, recognized_entitlement: snapshot.recognized, consumed_event_ids: snapshot.seen.ids, consumed_original_refs: snapshot.seen.refs, consumed_classification_ids: snapshot.seen.decision_ids, consumed_classification_refs: snapshot.seen.decision_refs})}};
  };
  define state_index = make_map(material_states, row => row.boundary, row => row.state);
  define previous_state = lookup(state_index, scope.period.start);
