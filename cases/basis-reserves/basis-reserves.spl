  emit "comparison" = {source_case_id: case_id, period: scope.period, status: "calculated", checkpoint_id: current.checkpoint_id, as_of: current.as_of, cutoff: current.cutoff, source_cutoff: current.source_cutoff, gross: current.gross, added: current.added, applied_returns: current.applied_returns, released: current.released, net_receipts: current.net_receipts, fee: current.fee, allocation: current.allocation, closing_reserve: current.closing_reserve, cumulative: replayed.cumulative, payment_status: "not_assessed_no_bank_payment_measure", source_support: "partial_within_vintage_returns_only", remaining_source_acceptance: "excess actual returns require separate signed Net Receipts/fee/allocation policy"};
  emit "checkpoint_results" = checkpoint_results;
  emit "vintages" = current.vintages;
