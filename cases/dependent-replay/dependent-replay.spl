e: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Text, pool_id: Id<Pool>, purpose: Text}, source_case_id: Text, transport_profile: Text} from "dependent-replay/original-known-views";
  require fact_scope.currency == "USD" and fact_scope.purpose == "authorized_dependent_replay" else "REPLAY_SCOPE";
  require fact_scope.agreement_id == scope.agreement_id and fact_scope.pool_id == scope.pool_id and fact_scope.asset_id == project and fact_scope.participant_id != "" else "REPLAY_SCOPE";
  require policy.id == "SYNTHETIC-DEPENDENT-REPLAY-01" and policy.revision == "1" and (policy.route == "restatement" or policy.route == "prospective") else "REPLAY_POLICY";
  require policy.economics == "original_opening_exact_cumulative_basis" and policy.attribution == (if policy.route == "restatement" then "revised_historical_lines" else "original_lines_plus_current_signed_credit") and policy.cash == "complete_empty_current_only" and policy.replacements == "one_authorized_replacement_per_original_receipt" and policy.balance_scope == "nonnegative_account_and_no_original_overpayment" and policy.rounding == "exact_no_rounding" and policy.evidence_class == "research_assumption" else "REPLAY_POLICY";
  require research.catalog_sha256 != "" and research.backlog_sha256 != "" and research.scope_note == "C13.DEPENDENT_PERIOD_REPLAY+C13.PROSPECTIVE_PERIOD_ADJUSTMENT;synthetic-positive-balance-only" else "REPLAY_RESEARCH_SCOPE";
  require history == supplied_opening and history.transport_profile == "dependent-replay-original-json/1" and history.identity_codec == "unicode-utf8-hex/1" else "REPLAY_OPENING";
  require history.scope == fact_scope and history.policy == policy and history.research == research and history.registry_original == registry_original else "REPLAY_PINNED_ORIGINALS_OR_ROUTE";
  define frame_count = sum(frames, row => 1);
  require frame_count >= 1 and frame_count <= 3 and sum(registry.periods, row => 1) >= 1 and sum(registry.periods, row => 1) + frame_count <= 4 else "REPLAY_TOTAL_PERIOD_BOUND";
  define minimum_cutoff = fold frames from cutoff with current, row { yield if row.cutoff < current then row.cutoff else current; };
  define unique_cases = fold sort_by(map(frames, row => row.id), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_DUPLICATE_CASE"; yield id; };
  require map(original_frames, row => row.id) == map(frames, row => row.id) else "REPLAY_ORIGINAL_FRAME_POPULATION";
  define raw_frame_index = make_map(original_frames, row => row.period.start, row => row);
  require sum(registry.party_ids, id => 1) <= 8 and sum(filter(registry.party_ids, id => id == registry.payer_id), id => 1) == 1 and sum(filter(registry.party_ids, id => id == fact_scope.participant_id), id => 1) == 1 and registry.payer_id != fact_scope.participant_id else "REPLAY_PARTY_ROLES";
  define unique_parties = fold sort_by(registry.party_ids, id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_ID_LIST"; yield id; };
  require registry.origin.cumulative_basis == USD 0 and registry.origin.recognized_entitlement == USD 0 and registry.origin.actual_paid == USD 0 else "REPLAY_ORIGINAL_OPENING";
    require sum(registry.periods, row => 1) <= 4 else "REPLAY_FINITE_ROWS";
  define unique_static_periods = fold sort_by(map(registry.periods, row => row.id), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_DUPLICATE_ID"; yield id; };
  require map(original_registry.periods, row => row.id) == map(registry.periods, row => row.id) else "REPLAY_ORIGINAL_REGISTRY_POPULATION";
  require sum(registry.terms, row => 1) <= 8 else "REPLAY_FINITE_ROWS";
  define unique_static_terms = fold sort_by(map(registry.terms, row => row.id), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_DUPLICATE_ID"; yield id; };
  require map(original_registry.terms, row => row.id) == map(registry.terms, row => row.id) else "REPLAY_ORIGINAL_REGISTRY_POPULATION";
  require sum(registry.receipts, row => 1) <= 8 else "REPLAY_FINITE_ROWS";
  define unique_static_receipts = fold sort_by(map(registry.receipts, row => row.id), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_DUPLICATE_ID"; yield id; };
  require map(original_registry.receipts, row => row.id) == map(registry.receipts, row => row.id) else "REPLAY_ORIGINAL_REGISTRY_POPULATION";
  require sum(registry.issued_artifacts, row => 1) <= 4 else "REPLAY_FINITE_ROWS";
  define unique_static_issued_artifacts = fold sort_by(map(registry.issued_artifacts, row => row.id), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_DUPLICATE_ID"; yield id; };
  require map(original_registry.issued_artifacts, row => row.id) == map(registry.issued_artifacts, row => row.id) else "REPLAY_ORIGINAL_REGISTRY_POPULATION";
  require sum(registry.payments, row => 1) <= 8 else "REPLAY_FINITE_ROWS";
  define unique_static_payments = fold sort_by(map(registry.payments, row => row.id), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_DUPLICATE_ID"; yield id; };
  require map(original_registry.payments, row => row.id) == map(registry.payments, row => row.id) else "REPLAY_ORIGINAL_REGISTRY_POPULATION";
  require sum(registry.applications, row => 1) <= 8 else "REPLAY_FINITE_ROWS";
