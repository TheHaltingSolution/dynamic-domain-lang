  closing history = {transport_profile: "reserve-stages-original-json/1", context: source_context, origin: "prior_result", boundary: replay.boundary, source_case_id: replay.last_case, detail: some(replay.book)};
  emit "comparison" = final_result;
  emit "reconciliation" = true;
}
