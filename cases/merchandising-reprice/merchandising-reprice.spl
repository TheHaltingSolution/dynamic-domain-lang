  emit "as_known_snapshots" = replayed.snapshots;
  emit "recognition_history" = replayed.history;
  emit "reconciliation" = current.candidate_total_unpaid == current.candidate_unissued + current.issued_outstanding and current.new_recognition_candidate == current.current_earnings + current.catchup;
}
