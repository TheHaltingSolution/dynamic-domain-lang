ol_id: Id<Pool>, purpose: Text}, tranches: List<{due_date: Date, fraction: Option<Ratio>, id: Text, kind: Text, processed: Bool}>}>}}> = [];
  define empty_receipt_details: List<{addition: Money<USD>, cap_room_before: Money<USD>, closing_retained_after_addition: Money<USD>, fee_consumed: Money<USD>, fee_key: List<Text>, gross: Money<USD>, nonparticipant: Money<USD>, producer: Money<USD>, raw_addition: Money<USD>, receipt_id: Text, retained_before: Money<USD>, unretained_current: Money<USD>, vintage_id: Text}> = [];
  define empty_application_details: List<{applied: Money<USD>, closing_available: Money<USD>, opening_available: Money<USD>, original: Text}> = [];
  define empty_release_details: List<{basis: Text, closing_available: Money<USD>, due_date: Date, fee: Money<USD>, key: List<Text>, nonparticipant: Money<USD>, opening_available: Money<USD>, original_addition: Money<USD>, producer: Money<USD>, quota: Money<USD>, released: Money<USD>, tranche_id: Text, vintage_id: Text}> = [];
  define empty_ids: List<Text> = [];
  define empty_fee_keys: List<List<Text>> = [];
  define empty_dates: List<Date> = [];
  define empty_tranches: List<{due_date: Date, fraction: Option<Ratio>, id: Text, kind: Text, processed: Bool}> = [];
  define zero = {gross: USD 0, fee: USD 0, producer: USD 0, nonparticipant: USD 0, applications: USD 0, additions: USD 0, releases: USD 0};
  require history == supplied_opening and history.context == source_context and history.transport_profile == "reserve-stages-original-json/1" and history.boundary == scope.period.start else "RS_OPENING_CONTEXT";
  require fact_scope.agreement_id == scope.agreement_id and fact_scope.participant_id == scope.participant_id and fact_scope.pool_id == scope.pool_id and fact_scope.asset_id == project and fact_scope.currency == "USD" else "RS_SCOPE";
  require policy.id == "SYNTHETIC-RESERVE-STAGES-01" and policy.revision == "1" and policy.fee == "fixed_once_per_original_receipt" and policy.cap == "limit_addition_with_unretained_current" and policy.order == "daily_receipts_then_ordered_applications_then_due_tranches" and policy.release == "unconditional_under_supplied_generic_terms" and policy.rounding == "exact_no_rounding" and policy.evidence_class == "research_assumption" else "RS_POLICY";
  define basis = policy.stage == "basis_reserve";
  require (basis and policy.reserve_measure == "gross_basis_USD" and fact_scope.purpose == "synthetic_gross_basis_reserve") or (policy.stage == "producer_holdback" and policy.reserve_measure == "producer_entitlement_USD" and fact_scope.purpose == "synthetic_producer_entitlement_holdback") else "RS_STAGE_MEASURE_PURPOSE";
  require sum(frames, f => 1) >= 1 and sum(frames, f => 1) <= 4 else "RS_FRAME_BOUND";
  define minimum_cutoff = fold frames from cutoff with a, f { yield if a < f.cutoff then a else f.cutoff; };
  define registry_checked = for each e in registry_evidence { require e.id != "" and e.source_ref != "" and e.kind != "" and e.approved and e.scope == fact_scope and e.observed_at < minimum_cutoff and sum(filter(registry_evidence, x => x.id == e.id), x => 1) == 1 else "RS_REGISTRY_EVIDENCE"; yield e; };
  require sum(registry_checked, e => 1) <= 32 and terms.scope == fact_scope and terms.id != "" and terms.version != "" and terms.source_ref != "" and terms.approved and terms.approved_utc <= terms.observed_at and terms.observed_at < minimum_cutoff else "RS_TERMS";
  require sum(filter(registry_checked, e => e.id == terms.evidence_ref and e.kind == "generic_reserve_terms" and e.observed_at <= terms.observed_at), e => 1) == 1 else "RS_TERMS_SUPPORT";
  require terms.reserve_measure == policy.reserve_measure and terms.fixed_fee >= USD 0 and terms.retained_cap >= USD 0 and terms.reserve_rate >= 0.0 and terms.reserve_rate <= 1.0 and terms.participation_share >= 0.0 and terms.participation_share <= 1.0 and (terms.calendar_mode == "clamp_day" or terms.calendar_mode == "reject_invalid_day") else "RS_TERMS_VALUES";
  define schedule_check = fold terms.release_schedule from {count: 0, offset: zero_nat, final: false} with a, r { require r.id != "" and sum(filter(terms.release_schedule, x => x.id == r.id), x => 1) == 1 and r.offset_months > a.offset and r.offset_months <= 24 and not a.final else "RS_SCHEDULE_ORDER"; require (r.kind == "all_remaining" and not is_some(r.fraction)) or (a.count == 0 and r.kind == "fraction_of_original_addition" and is_some(r.fraction) and require_some(r.fraction, "RS_FRACTION") > 0.0 and require_some(r.fraction, "RS_FRACTION") <= 1.0) else "RS_SCHEDULE_RULE"; yield {count: a.count + 1, offset: r.offset_months, final: r.kind == "all_remaining"}; };
  require schedule_check.count >= 1 and schedule_check.count <= 2 and schedule_check.final else "RS_SCHEDULE_FINAL";
