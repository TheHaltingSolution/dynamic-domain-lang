  require map(original_registry.applications, row => row.id) == map(registry.applications, row => row.id) else "REPLAY_ORIGINAL_REGISTRY_POPULATION";
  require sum(registry.evidence, row => 1) <= 32 else "REPLAY_FINITE_ROWS";
  define unique_static_evidence = fold sort_by(map(registry.evidence, row => row.id), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_DUPLICATE_ID"; yield id; };
  require map(original_registry.evidence, row => row.id) == map(registry.evidence, row => row.id) else "REPLAY_ORIGINAL_REGISTRY_POPULATION";
  define static_evidence_count = sum(registry.evidence, row => 1);
  define unique_static_slots = fold sort_by(registry.evidence, row => row.slot) from -1 with previous, row { require row.slot >= 0 and row.slot < static_evidence_count and row.slot != previous else "REPLAY_EVIDENCE_SLOT"; yield row.slot; };
  define checked_static_evidence = for each row in registry.evidence {
    require row.scope == fact_scope and row.approved and row.observed_at < minimum_cutoff and row.kind != "" and row.source_ref != "" else "REPLAY_EVIDENCE_SCOPE_APPROVAL_CUTOFF";
    yield {id: row.id, kind: row.kind, observed_at: row.observed_at, slot: row.slot};
  };
  define static_evidence_index = make_map(checked_static_evidence, row => row.slot, row => row);
  define original_period_rows = sort_by(registry.periods, row => row.period.start);
  define original_chain: {boundary: Date, previous: Option<Text>} = fold original_period_rows from {boundary: registry.origin.boundary, previous: none()} with chain, row {
    
      require row.id != "" and row.source_ref != "" and row.scope == fact_scope else "REPLAY_FACT_SCOPE";
      require row.observed_at < minimum_cutoff else "REPLAY_SOURCE_OBSERVATION";
      define supporting_row = require_some(lookup(static_evidence_index, row.evidence_slot), "REPLAY_EVIDENCE_REQUIRED");
      require supporting_row.id == row.evidence_ref and supporting_row.kind == "issued_period" and supporting_row.observed_at <= row.observed_at else "REPLAY_SOURCE_OBSERVATION";

    require row.period.start < row.period.end and row.as_of >= row.period.start and row.as_of < row.period.end and row.as_of_ordinal + 1 == row.period_end_ordinal and row.cutoff >= row.period_end_utc else "REPLAY_COMPLETE_ORIGINAL_PERIOD";
    require row.period.start == chain.boundary and row.predecessor_period_id == chain.previous else "REPLAY_BROKEN_DEPENDENCY";
