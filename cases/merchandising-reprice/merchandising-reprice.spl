  // Reconstruct only material previous/current states after financial replay.
  // Each frame uses its original cutoff, as-of and finalized recognition set.
  define state_views = map(filter(replayed.snapshots, snapshot => snapshot.mode == "final" and (snapshot.view_id == run.view_id or sum(filter(checked_periods, p => p.id == snapshot.period_id and p.period.end == scope.period.start), p => 1) == 1)), snapshot => {id: snapshot.view_id, snapshot: snapshot});
  define state_frames = for each frame in state_views {
    define view = frame.snapshot;
    define before = view.cutoff;
    define period_slot: Option<{evidence_observed_at: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, period: Period}> = fold filter(checked_periods, row => row.id == view.period_id) from none() with slot, row { yield some(row); };
    define period = require_some(period_slot, "MR_UNKNOWN_PERIOD");
    define processed = map(filter(checked_periods, row => row.period.end <= period.period.end), row => row.id);
    define recognized = map(view.attributions, row => {id: row.receipt_id, receipt_id: row.receipt_id, amount: row.target_entitlement});
    define recognition_history = filter(replayed.history, row => row.cutoff <= before);
    define prefix_sources = {periods: map(sort_by(filter(state_source_periods, row => row.observed_at < before and sum(filter(processed, id => id == row.id), id => 1) == 1), row => row.id), row => {category: "periods", id: row.id, record: row.raw_original}), views: map(sort_by(filter(state_source_views, row => row.observed_at < before and sum(filter(processed, id => id == row.period_id), id => 1) == 1), row => row.id), row => {category: "views", id: row.id, record: row.raw_original}), receipts: map(sort_by(filter(state_source_receipts, row => row.observed_at < before and sum(filter(processed, id => id == row.period_id), id => 1) == 1), row => row.id), row => {category: "receipts", id: row.id, record: row.raw_original}), box_office: map(sort_by(filter(state_source_box_office, row => row.observed_at < before and row.recorded_date <= view.as_of), row => row.id), row => {category: "box_office", id: row.id, record: row.raw_original}), issues: map(sort_by(filter(state_source_issues, row => row.observed_at < before), row => row.id), row => {category: "issues", id: row.id, record: row.raw_original}), payments: map(sort_by(filter(state_source_payments, row => row.observed_at < before), row => row.id), row => {category: "payments", id: row.id, record: row.raw_original}), applications: map(sort_by(filter(state_source_applications, row => row.observed_at < before), row => row.id), row => {category: "applications", id: row.id, record: row.raw_original}), populations: map(sort_by(filter(state_source_populations, row => row.observed_at < before and sum(filter(checked_views, v => v.id == row.view_id and sum(filter(processed, id => id == v.period_id), id => 1) == 1), v => 1) == 1), row => row.id), row => {category: "populations", id: row.id, record: row.raw_original}), no_default: map(sort_by(filter(state_source_no_default, row => row.observed_at < before and sum(filter(checked_views, v => v.id == row.view_id and sum(filter(processed, id => id == v.period_id), id => 1) == 1), v => 1) == 1), row => row.id), row => {category: "no_default", id: row.id, record: row.raw_original}), evidence: map(sort_by(filter(state_source_evidence, row => row.observed_at < before), row => row.id), row => {category: "evidence", id: row.id, record: row.raw_original})};
    yield {id: frame.id, state: {transport_profile: "merchandising-original-json/1", scope: fact_scope, purpose: "first_dollar_merchandising", policy: policy, boundary: period.period.end, origin: "prior_result", source_case_id: view.source_case_id, detail: some({research: research, terms: terms.raw_original, cost_basis: cost_basis.raw_original, qualifications: qualifications.raw_original, cb_switch: cb_switch.raw_original, last_view_id: view.view_id, recognized_rows: recognized, recognition_history: recognition_history, known_issued: view.known_issued, actual_paid: view.actual_paid, issued_outstanding: view.issued_outstanding, recognized_unissued: view.recognized_cumulative - view.known_issued, sources: prefix_sources})}};
  };
  define previous_state: Option<{boundary: Date, detail: Option<{actual_paid: Money<USD>, cb_switch: Text, cost_basis: Text, issued_outstanding: Money<USD>, known_issued: Money<USD>, last_view_id: Text, qualifications: Text, recognition_history: List<{amount: Money<USD>, attributions: List<{earned_period_id: Text, id: Text, kind: Text, license_cash: Money<USD>, license_deduction: Money<USD>, nmi: Money<USD>, previously_recognized: Money<USD>, qualifying: Bool, rate: Ratio, receipt_id: Text, receipt_ref: Text, recognition_delta: Money<USD>, target_entitlement: Money<USD>}>, catchup: Money<USD>, current_earnings: Money<USD>, cutoff: Instant, id: Text, period_id: Text, source_case_id: Text, source_cutoff: Text, view_id: Text}>, recognized_rows: List<{amount: Money<USD>, id: Text, receipt_id: Text}>, recognized_unissued: Money<USD>, research: {clause_locator: Text, contract_url: Text, ld03_sha256: Text, rr04_sha256: Text}, sources: {applications: List<{category: Text, id: Text, record: Text}>, box_office: List<{category: Text, id: Text, record: Text}>, evidence: List<{category: Text, id: Text, record: Text}>, issues: List<{category: Text, id: Text, record: Text}>, no_default: List<{category: Text, id: Text, record: Text}>, payments: List<{category: Text, id: Text, record: Text}>, periods: List<{category: Text, id: Text, record: Text}>, populations: List<{category: Text, id: Text, record: Text}>, receipts: List<{category: Text, id: Text, record: Text}>, views: List<{category: Text, id: Text, record: Text}>}, terms: Text}>, origin: Text, policy: {amounts: Text, cash_date_basis: Text, credit_profile: Text, evidence_class: Text, id: Text, method: Text, negative_adjustments: Text, professional_review: Text, revision: Text}, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, transport_profile: Text}> = fold filter(state_frames, frame => frame.id != run.view_id) from none() with slot, frame { yield some(frame.state); };
  define current_state: Option<{boundary: Date, detail: Option<{actual_paid: Money<USD>, cb_switch: Text, cost_basis: Text, issued_outstanding: Money<USD>, known_issued: Money<USD>, last_view_id: Text, qualifications: Text, recognition_history: List<{amount: Money<USD>, attributions: List<{earned_period_id: Text, id: Text, kind: Text, license_cash: Money<USD>, license_deduction: Money<USD>, nmi: Money<USD>, previously_recognized: Money<USD>, qualifying: Bool, rate: Ratio, receipt_id: Text, receipt_ref: Text, recognition_delta: Money<USD>, target_entitlement: Money<USD>}>, catchup: Money<USD>, current_earnings: Money<USD>, cutoff: Instant, id: Text, period_id: Text, source_case_id: Text, source_cutoff: Text, view_id: Text}>, recognized_rows: List<{amount: Money<USD>, id: Text, receipt_id: Text}>, recognized_unissued: Money<USD>, research: {clause_locator: Text, contract_url: Text, ld03_sha256: Text, rr04_sha256: Text}, sources: {applications: List<{category: Text, id: Text, record: Text}>, box_office: List<{category: Text, id: Text, record: Text}>, evidence: List<{category: Text, id: Text, record: Text}>, issues: List<{category: Text, id: Text, record: Text}>, no_default: List<{category: Text, id: Text, record: Text}>, payments: List<{category: Text, id: Text, record: Text}>, periods: List<{category: Text, id: Text, record: Text}>, populations: List<{category: Text, id: Text, record: Text}>, receipts: List<{category: Text, id: Text, record: Text}>, views: List<{category: Text, id: Text, record: Text}>}, terms: Text}>, origin: Text, policy: {amounts: Text, cash_date_basis: Text, credit_profile: Text, evidence_class: Text, id: Text, method: Text, negative_adjustments: Text, professional_review: Text, revision: Text}, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, transport_profile: Text}> = fold filter(state_frames, frame => frame.id == run.view_id) from none() with slot, frame { yield some(frame.state); };
  require history.scope == fact_scope and history.purpose == "first_dollar_merchandising" and history.policy == policy and history.boundary == scope.period.start else "MR_OPENING_HISTORY_RECONCILIATION";
  require if is_some(previous_state) then (history.origin == "prior_result" or history.origin == "supplied_history") and is_some(history.detail) and history.source_case_id == require_some(previous_state, "MR_OPENING_REQUIRED").source_case_id and history.detail == require_some(previous_state, "MR_OPENING_REQUIRED").detail else history.origin == "genesis" and history.source_case_id == "genesis" and not is_some(history.detail) and not is_some(predecessor) else "MR_OPENING_HISTORY_RECONCILIATION";
  require if history.origin == "prior_result" then is_some(predecessor) and require_some(predecessor, "MR_PREDECESSOR_REQUIRED").source_case_id == history.source_case_id and require_some(predecessor, "MR_PREDECESSOR_REQUIRED").source_case_id != case_id and require_some(predecessor, "MR_PREDECESSOR_REQUIRED").period.end == scope.period.start and require_some(predecessor, "MR_PREDECESSOR_REQUIRED").closing_state == history else not is_some(predecessor) else "MR_PREDECESSOR_MISMATCH";
  define validated_issues = for each row in checked_issues {
    require row.amount >= USD 0 and row.version == "1" and row.issued_date_utc <= row.observed_at else "MR_ISSUE_OBSERVATION_ORDER";
    require sum(filter(checked_issues, other => other.recognition_id == row.recognition_id), other => 1) == 1 else "MR_ISSUE_RECOGNITION_REFERENCE";
