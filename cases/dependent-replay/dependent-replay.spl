  define original_periods = map(original_period_rows, row => {id: row.id, period: row.period});
  define checked_terms = for each row in registry.terms {
    
      require row.id != "" and row.source_ref != "" and row.scope == fact_scope else "REPLAY_FACT_SCOPE";
      require row.observed_at < minimum_cutoff else "REPLAY_SOURCE_OBSERVATION";
      define supporting_row = require_some(lookup(static_evidence_index, row.evidence_slot), "REPLAY_EVIDENCE_REQUIRED");
      require supporting_row.id == row.evidence_ref and supporting_row.kind == "earning_terms" and supporting_row.observed_at <= row.observed_at else "REPLAY_SOURCE_OBSERVATION";

    require row.approved and row.approved_date_utc <= row.observed_at and (row.kind == "flat_ratio" or row.kind == "cumulative_marginal") and row.effective.start < row.effective.end and row.original_ref != "" else "REPLAY_TERM_AUTHORITY";
    require row.flat_rate >= 0 and row.flat_rate <= 1 and row.lower_rate >= 0 and row.lower_rate <= 1 and row.upper_rate >= 0 and row.upper_rate <= 1 and row.lower_rate <= row.upper_rate and row.threshold >= USD 0 else "REPLAY_TERM_RATE";
    yield row.id;
  };
  define unique_original_refs = fold sort_by(map(registry.receipts, row => row.original_ref), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_RECEIPT_LINE_ALIAS"; yield id; };
  define unique_entitlements = fold sort_by(map(registry.receipts, row => row.entitlement_ref), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_RECEIPT_LINE_ALIAS"; yield id; };
  define checked_original_receipts = for each row in registry.receipts {
    
      require row.id != "" and row.source_ref != "" and row.scope == fact_scope else "REPLAY_FACT_SCOPE";
