{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false, "required": ["format", "binding", "selectors"],
  "properties": {
    "format": {"const": "spl-component-dependencies/1"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["module_ref", "source_sha256", "policy_sha256", "module_closure"],
      "properties": {
        "module_ref": {"$ref": "#/$defs/module_ref"},
        "source_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "policy_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "module_closure": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/module_ref"}}
      }
    },
    "selectors": {"type": "array", "maxItems": 128, "items": {
      "type": "object", "additionalProperties": false, "required": ["kind", "namespace", "rows", "key"],
      "properties": {
        "kind": {"enum": ["pool", "gate", "allocation_parent", "correction_chain", "cross_contract"]},
        "namespace": {"type": "string", "minLength": 1},
        "rows": {"$ref": "#/$defs/path"},
        "key": {"type": "array", "minItems": 1, "maxItems": 16, "items": {
          "type": "object", "additionalProperties": false, "required": ["from", "path"],
          "properties": {"from": {"enum": ["row", "package"]}, "path": {"$ref": "#/$defs/path"}}
        }}
      }
    }}
  },
  "$defs": {
    "path": {"type": "array", "maxItems": 32, "items": {}},
    "module_ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "revision", "locator", "sha256"],
      "properties": {"id": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1},
                     "locator": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}}
    }
  }
}
