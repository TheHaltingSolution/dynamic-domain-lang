  require (history.origin == "genesis" and frame_count == 1 and scope.period.start == registry.genesis_date and not is_some(history.source_case_id) and not is_some(history.detail) and sum(history.original_frames, row => 1) == 0 and not is_some(predecessor)) or (history.origin == "original_history" and frame_count > 1 and not is_some(history.source_case_id) and not is_some(history.detail) and history.original_frames == original_prefix and not is_some(predecessor)) or (history.origin == "prior_result" and frame_count > 1 and history == require_some(previous_state, "GATE_OPENING_RECONCILIATION") and is_some(predecessor)) else "GATE_OPENING_RECONCILIATION";
  require not is_some(predecessor) or (require_some(predecessor, "GATE_PREDECESSOR_REQUIRED").closing_state == history and some(require_some(predecessor, "GATE_PREDECESSOR_REQUIRED").source_case_id) == history.source_case_id and require_some(predecessor, "GATE_PREDECESSOR_REQUIRED").period.end == scope.period.start) else "GATE_PREDECESSOR_MISMATCH";
  closing history = require_some(lookup(state_index, scope.period.end), "GATE_CURRENT_PERIOD");
  emit "comparison" = current.result;
  emit "stage_summary" = {work_gate_receipts: "full eligible original amounts", payout_video_basis: "native admitted full amount times supplied video proxy", aggregate_hurdle: "supplied attained strictly before period start", net_basis: "separately supplied scoped zero worksheet", fee_offset: USD 0, reserve_movements: USD 0, source_boundary: "proposed synthetic history and operating choices; no full net ledger or professional approval"};
  emit "reconciliation" = replayed.receipts == sum(complete_snapshots, row => row.result.current_full_receipts) and replayed.costs == sum(complete_snapshots, row => row.result.current_eligible_costs) and replayed.recognized == sum(complete_snapshots, row => row.result.calculated_unissued_entitlement);
}
