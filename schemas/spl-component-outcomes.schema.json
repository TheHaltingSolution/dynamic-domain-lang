{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["format", "status", "requested_backend", "audit_profile", "workers", "plan", "components", "diagnostics"],
  "properties": {
    "format": {"const": "spl-component-outcomes/1"},
    "status": {"enum": ["completed", "partial"]},
    "requested_backend": {"enum": ["compare", "lean", "reference"]},
    "audit_profile": {"enum": ["array-v1", "compact-v2"]},
    "workers": {"type": "integer", "const": 1},
    "plan": {"type": "object"},
    "diagnostics": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/diagnostic"}},
    "components": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "members", "status", "diagnostic_codes", "trace_origin", "state_consumable"],
      "properties": {
        "id": {"type": "string", "pattern": "component-[0-9a-f]{64}"},
        "members": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "pattern": "[A-Za-z][A-Za-z0-9_-]{0,63}"}},
        "status": {"enum": ["calculated", "provisional", "blocked", "not_executed"]},
        "diagnostic_codes": {"type": "array", "items": {"type": "string"}},
        "trace_origin": {},
        "state_consumable": {"type": "boolean"},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
        "completion": {
          "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}}
        }
      }
    }}
  },
  "$defs": {"diagnostic": {
    "type": "object", "additionalProperties": false, "required": ["code"],
    "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
  }}
}
