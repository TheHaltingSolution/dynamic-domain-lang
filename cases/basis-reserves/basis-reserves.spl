    require sum(clearances_for_checkpoint, row => if row.observed_at < before and row.evidence_observed_at < before then 1 else 0) == 1 else "BR_SOURCE_AFTER_CUTOFF";
    define current_receipts = filter(visible_receipts, row => checkpoint.period.start <= row.receipt_date and row.receipt_date < checkpoint.period.end);
