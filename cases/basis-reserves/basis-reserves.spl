  emit "reconciliation" = replayed.cumulative.gross - replayed.cumulative.applied_returns == replayed.cumulative.net_receipts + current.closing_reserve and replayed.cumulative.fee + replayed.cumulative.allocation == replayed.cumulative.net_receipts;
}
