  define state_views = filter(checkpoint_results, row => row.checkpoint_id == run_checkpoint_id or row.period.end == scope.period.start);
  define state_frames = for each snapshot in state_views {
    define before = snapshot.cutoff;
    define processed = map(filter(checked_checkpoints, cp => cp.period.end <= snapshot.period.end), cp => cp.id);
    define receipts_before = filter(validated_receipts, row => row.receipt_date <= snapshot.as_of);
    define returns_before = filter(validated_returns, row => row.return_date <= snapshot.as_of);
    define prefix_sources = {checkpoints: map(sort_by(filter(state_source_checkpoints, row => row.observed_at < before and sum(filter(processed, id => id == row.id), id => 1) == 1), row => row.id), row => {id: row.id, category: "checkpoints", record: row.raw_original}), receipts: map(sort_by(filter(state_source_receipts, row => row.observed_at < before and sum(filter(receipts_before, receipt => receipt.id == row.id), receipt => 1) == 1), row => row.id), row => {id: row.id, category: "receipts", record: row.raw_original}), elections: map(sort_by(filter(state_source_elections, row => row.observed_at < before and sum(filter(receipts_before, receipt => receipt.id == row.receipt_id), receipt => 1) == 1), row => row.id), row => {id: row.id, category: "elections", record: row.raw_original}), returns: map(sort_by(filter(state_source_returns, row => row.observed_at < before and sum(filter(returns_before, returned => returned.id == row.id), returned => 1) == 1), row => row.id), row => {id: row.id, category: "returns", record: row.raw_original}), return_authorities: map(sort_by(filter(state_source_return_authorities, row => row.observed_at < before and sum(filter(returns_before, returned => returned.id == row.return_id), returned => 1) == 1), row => row.id), row => {id: row.id, category: "return_authorities", record: row.raw_original}), populations: map(sort_by(filter(state_source_populations, row => row.observed_at < before and sum(filter(processed, id => id == row.checkpoint_id), id => 1) == 1), row => row.id), row => {id: row.id, category: "populations", record: row.raw_original}), clearances: map(sort_by(filter(state_source_clearances, row => row.observed_at < before and sum(filter(processed, id => id == row.checkpoint_id), id => 1) == 1), row => row.id), row => {id: row.id, category: "clearances", record: row.raw_original}), evidence: map(sort_by(filter(state_source_evidence, row => row.observed_at < before), row => row.id), row => {id: row.id, category: "evidence", record: row.raw_original})};
    define cumulative = {gross: sum(filter(replayed.snapshots, cp => cp.period.end <= snapshot.period.end), cp => cp.gross), added: sum(filter(replayed.snapshots, cp => cp.period.end <= snapshot.period.end), cp => cp.added), applied_returns: sum(filter(replayed.snapshots, cp => cp.period.end <= snapshot.period.end), cp => cp.applied_returns), released: sum(filter(replayed.snapshots, cp => cp.period.end <= snapshot.period.end), cp => cp.released), net_receipts: sum(filter(replayed.snapshots, cp => cp.period.end <= snapshot.period.end), cp => cp.net_receipts), fee: sum(filter(replayed.snapshots, cp => cp.period.end <= snapshot.period.end), cp => cp.fee), allocation: sum(filter(replayed.snapshots, cp => cp.period.end <= snapshot.period.end), cp => cp.allocation)};
    define movements = concat(empty_movements, fold filter(replayed.snapshots, cp => cp.period.end <= snapshot.period.end) from empty_movements with previous, cp { yield concat(previous, cp.movements); });
