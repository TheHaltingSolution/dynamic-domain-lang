// Five explicit fixed-table methods, replayed from original historical events.
schedule OrderedEscalation language "spl/0.1-draft" core "spl-core/0.1-draft" schema "spl-data/0.1-draft" {
  input scope: SettlementScope;
  input project: Id<Asset>;
  input fact_scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>};
  input case_id: Text;
  input as_of: Date;
  input cutoff: Instant;
  input opening_utc: Instant;
  input policy: {id: Text, revision: Text, method: Text, equality: Text, rounding: Text, evidence_class: Text, table_availability: Text};
  input bracket_table: {approved_date: Date, brackets: List<{evidence_ref: Text, id: Text, lower: Money<USD>, rate: Ratio, sequence: Int, source_lower: Text, source_rate: Text, source_ref: Text, source_upper: Text, upper: Option<Money<USD>>}>, effective: Period, evidence_ref: Text, id: Text, observed_at: Instant, recorded_date: Date, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_observed_at: Text, source_ref: Text, version: Text};
  input events: List<{basis: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_basis: Text, source_observed_at: Text, source_ref: Text}>;
  input evidence: List<{id: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, observed_at: Instant, source_kind: Text, source_observed_at: Text, approval_ref: Id<Decision>, evidence_ref: Text, kind: Text}>;
  input supplied_opening: {boundary: Date, bracket_table: {approved_date: Date, brackets: List<{evidence_ref: Text, id: Text, lower: Money<USD>, rate: Ratio, sequence: Int, source_lower: Text, source_rate: Text, source_ref: Text, source_upper: Text, upper: Option<Money<USD>>}>, effective: Period, evidence_ref: Text, id: Text, observed_at: Instant, recorded_date: Date, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_observed_at: Text, source_ref: Text, version: Text}, cumulative_basis: Money<USD>, method: Text, origin: Text, period_history: List<{closing_basis: Money<USD>, closing_recognized: Money<USD>, current_result: Money<USD>, events: List<{basis: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_basis: Text, source_observed_at: Text, source_ref: Text}>, opening_basis: Money<USD>, opening_recognized: Money<USD>, opening_utc: Instant, period: Period, source_case_id: Text, source_numbers: Option<{closing_basis: Text, closing_recognized: Text, current_result: Text, opening_basis: Text, opening_recognized: Text}>}>, policy_id: Text, policy_revision: Text, purpose: Text, recognized_entitlement: Money<USD>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text};
  input predecessor: Option<{source_case_id: Text, period: Period, closing_state: {boundary: Date, bracket_table: {approved_date: Date, brackets: List<{evidence_ref: Text, id: Text, lower: Money<USD>, rate: Ratio, sequence: Int, source_lower: Text, source_rate: Text, source_ref: Text, source_upper: Text, upper: Option<Money<USD>>}>, effective: Period, evidence_ref: Text, id: Text, observed_at: Instant, recorded_date: Date, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_observed_at: Text, source_ref: Text, version: Text}, cumulative_basis: Money<USD>, method: Text, origin: Text, period_history: List<{closing_basis: Money<USD>, closing_recognized: Money<USD>, current_result: Money<USD>, events: List<{basis: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_basis: Text, source_observed_at: Text, source_ref: Text}>, opening_basis: Money<USD>, opening_recognized: Money<USD>, opening_utc: Instant, period: Period, source_case_id: Text, source_numbers: Option<{closing_basis: Text, closing_recognized: Text, current_result: Text, opening_basis: Text, opening_recognized: Text}>}>, policy_id: Text, policy_revision: Text, purpose: Text, recognized_entitlement: Money<USD>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text}}>;
  opening history: {boundary: Date, bracket_table: {approved_date: Date, brackets: List<{evidence_ref: Text, id: Text, lower: Money<USD>, rate: Ratio, sequence: Int, source_lower: Text, source_rate: Text, source_ref: Text, source_upper: Text, upper: Option<Money<USD>>}>, effective: Period, evidence_ref: Text, id: Text, observed_at: Instant, recorded_date: Date, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_observed_at: Text, source_ref: Text, version: Text}, cumulative_basis: Money<USD>, method: Text, origin: Text, period_history: List<{closing_basis: Money<USD>, closing_recognized: Money<USD>, current_result: Money<USD>, events: List<{basis: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_basis: Text, source_observed_at: Text, source_ref: Text}>, opening_basis: Money<USD>, opening_recognized: Money<USD>, opening_utc: Instant, period: Period, source_case_id: Text, source_numbers: Option<{closing_basis: Text, closing_recognized: Text, current_result: Text, opening_basis: Text, opening_recognized: Text}>}>, policy_id: Text, policy_revision: Text, purpose: Text, recognized_entitlement: Money<USD>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text} from "escalation/cumulative-original-history";
  require fact_scope.contract_id == scope.agreement_id and fact_scope.participant_id == scope.participant_id and fact_scope.pool_id == scope.pool_id and fact_scope.asset_id == project and fact_scope.currency == "USD" else "ESCALATION_FACT_SCOPE";
  require case_id != "" else "ESCALATION_IDENTITY_REQUIRED";
  require policy.id == "SYNTHETIC-ESCALATION-01" and policy.revision == "1" and policy.equality == "lower_inclusive" and policy.rounding == "exact_no_rounding" and policy.evidence_class == "research_assumption" and policy.table_availability == "before_all_period_openings_utc" else "ESCALATION_SELECTED_POLICY";
  require policy.method == "prospective_split" or policy.method == "current_period_ending_rate" or policy.method == "row_opening_rate" or policy.method == "row_ending_rate" or policy.method == "cumulative_reprice_delta" else "ESCALATION_METHOD_REQUIRED";
  define checked_evidence = for each row in evidence {
    require row.id != "" and row.source_kind != "" else "ESCALATION_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "ESCALATION_EVIDENCE_SCOPE";
    require row.observed_at < cutoff else "ESCALATION_EVIDENCE_CUTOFF";
    yield row;
  };
  require bracket_table.id != "" and bracket_table.version != "" and bracket_table.source_ref != "" else "ESCALATION_IDENTITY_REQUIRED";
  require bracket_table.scope == fact_scope and sum(filter(checked_evidence, row => row.id == bracket_table.evidence_ref), row => 1) == 1 else "ESCALATION_BRACKET_SCOPE_EVIDENCE";
  require bracket_table.approved_date <= bracket_table.recorded_date and bracket_table.recorded_date <= as_of else "ESCALATION_TABLE_ASOF";
  require bracket_table.observed_at < cutoff else "ESCALATION_TABLE_CUTOFF";
  require sum(bracket_table.brackets, row => 1) > 0 else "ESCALATION_BRACKETS_REQUIRED";
  define ordered_bands = sort_by(bracket_table.brackets, row => row.sequence);
  define checked_bands = for each row in ordered_bands {
    require row.id != "" and row.source_ref != "" else "ESCALATION_IDENTITY_REQUIRED";
    require sum(filter(ordered_bands, other => other.id == row.id), other => 1) == 1 else "ESCALATION_DUPLICATE_ID";
    require row.sequence >= 0 and sum(filter(ordered_bands, other => other.sequence == row.sequence), other => 1) == 1 else "ESCALATION_BRACKET_SEQUENCE";
    require sum(filter(checked_evidence, support => support.id == row.evidence_ref), support => 1) == 1 else "ESCALATION_BRACKET_SCOPE_EVIDENCE";
    require row.rate >= 0.0 and row.rate <= 1.0 else "ESCALATION_RATE_DOMAIN";
    yield row;
  };
  define band_partition = fold checked_bands from {boundary: USD 0, rate: 0.0, ended: false} with step, band {
    require not step.ended and band.lower == step.boundary and (not is_some(band.upper) or get_or(band.upper, band.lower) > band.lower) else "ESCALATION_BRACKET_PARTITION";
    require band.rate >= step.rate else "ESCALATION_DECREASING_RATE";
    require is_some(band.upper) or sum(filter(checked_bands, other => other.sequence > band.sequence), other => 1) == 0 else "ESCALATION_FINAL_UNBOUNDED";
    yield {boundary: get_or(band.upper, band.lower), rate: band.rate, ended: not is_some(band.upper)};
  };
  require band_partition.ended else "ESCALATION_FINAL_UNBOUNDED";
  define table_snapshot = {id: bracket_table.id, version: bracket_table.version, scope: bracket_table.scope, effective: bracket_table.effective, approved_date: bracket_table.approved_date, recorded_date: bracket_table.recorded_date, observed_at: bracket_table.observed_at, source_observed_at: bracket_table.source_observed_at, source_ref: bracket_table.source_ref, evidence_ref: bracket_table.evidence_ref, brackets: checked_bands};
  require history == supplied_opening else "ESCALATION_OPENING_SNAPSHOT";
  require history.scope == fact_scope and history.purpose == "cumulative_escalation" else "ESCALATION_OPENING_SCOPE";
  require history.policy_id == policy.id and history.policy_revision == policy.revision and history.method == policy.method else "ESCALATION_OPENING_METHOD";
  define opening_table = {id: history.bracket_table.id, version: history.bracket_table.version, scope: history.bracket_table.scope, effective: history.bracket_table.effective, approved_date: history.bracket_table.approved_date, recorded_date: history.bracket_table.recorded_date, observed_at: history.bracket_table.observed_at, source_observed_at: history.bracket_table.source_observed_at, source_ref: history.bracket_table.source_ref, evidence_ref: history.bracket_table.evidence_ref, brackets: sort_by(history.bracket_table.brackets, row => row.sequence)};
  require opening_table == table_snapshot else "ESCALATION_BRACKET_AMENDMENT";
  require history.boundary == scope.period.start else "ESCALATION_OPENING_BOUNDARY";
  require if history.origin == "genesis" then history.cumulative_basis == USD 0 and history.recognized_entitlement == USD 0 and sum(history.period_history, row => 1) == 0 and history.source_case_id == "genesis" and not is_some(predecessor) else if history.origin == "supplied_history" then sum(history.period_history, row => 1) > 0 and not is_some(predecessor) else history.origin == "prior_result" and is_some(predecessor) else "ESCALATION_PREDECESSOR_REQUIRED";
  require history.origin != "prior_result" or require_some(predecessor, "ESCALATION_PREDECESSOR_REQUIRED").period.end == scope.period.start else "ESCALATION_PREDECESSOR_BOUNDARY";
  require history.origin != "prior_result" or (require_some(predecessor, "ESCALATION_PREDECESSOR_REQUIRED").source_case_id == history.source_case_id and history.source_case_id != case_id and require_some(predecessor, "ESCALATION_PREDECESSOR_REQUIRED").closing_state == history) else "ESCALATION_PREDECESSOR_MISMATCH";
  define prior_periods = map(sort_by(history.period_history, row => row.period.start), row => {is_current: false, record: row});
  define current_record: {closing_basis: Money<USD>, closing_recognized: Money<USD>, current_result: Money<USD>, events: List<{basis: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_basis: Text, source_observed_at: Text, source_ref: Text}>, opening_basis: Money<USD>, opening_recognized: Money<USD>, opening_utc: Instant, period: Period, source_case_id: Text, source_numbers: Option<{closing_basis: Text, closing_recognized: Text, current_result: Text, opening_basis: Text, opening_recognized: Text}>} = {source_case_id: case_id, period: scope.period, opening_utc: opening_utc, opening_basis: history.cumulative_basis, opening_recognized: history.recognized_entitlement, events: events, current_result: USD 0, closing_basis: USD 0, closing_recognized: USD 0, source_numbers: none()};
  define periods = append(prior_periods, {is_current: true, record: current_record});
  define replayed: {basis: Money<USD>, recognized: Money<USD>, previous_end: Option<Date>, used_ids: List<Text>, used_sources: List<Text>, used_cases: List<Text>, history: List<{closing_basis: Money<USD>, closing_recognized: Money<USD>, current_result: Money<USD>, events: List<{basis: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_basis: Text, source_observed_at: Text, source_ref: Text}>, opening_basis: Money<USD>, opening_recognized: Money<USD>, opening_utc: Instant, period: Period, source_case_id: Text, source_numbers: Option<{closing_basis: Text, closing_recognized: Text, current_result: Text, opening_basis: Text, opening_recognized: Text}>}>, replays: List<{closing_basis: Money<USD>, closing_recognized: Money<USD>, current_result: Money<USD>, ending_bracket_id: Text, ending_rate: Ratio, opening_basis: Money<USD>, opening_recognized: Money<USD>, period: Period, period_basis: Money<USD>, rows: List<{basis: Money<USD>, basis_after: Money<USD>, basis_before: Money<USD>, current_result: Money<USD>, evidence_ref: Text, id: Text, rate_details: {kind: Text, selected: Option<{bracket_id: Text, rate: Ratio}>, slices: List<{amount: Money<USD>, bracket_id: Text, rate: Ratio, width: Money<USD>}>}, recognized_after: Money<USD>, recognized_before: Money<USD>, sequence: Int, source_ref: Text}>, source_case_id: Text}>} = fold periods from {basis: USD 0, recognized: USD 0, previous_end: none(), used_ids: [], used_sources: [], used_cases: [], history: [], replays: []} with ledger, entry {
    define record = entry.record;
    require record.source_case_id != "" and sum(filter(ledger.used_cases, id => id == record.source_case_id), id => 1) == 0 and (entry.is_current or record.source_case_id != case_id) else "ESCALATION_DUPLICATE_PERIOD_CASE";
    require not is_some(ledger.previous_end) or get_or(ledger.previous_end, record.period.start) == record.period.start else "ESCALATION_HISTORY_BOUNDARY";
    require entry.is_current or record.period.end <= scope.period.start else "ESCALATION_HISTORY_BOUNDARY";
    require bracket_table.effective.start <= record.period.start and record.period.end <= bracket_table.effective.end else "ESCALATION_TABLE_EFFECTIVE";
    require bracket_table.recorded_date <= record.period.start and bracket_table.observed_at < record.opening_utc else "ESCALATION_TABLE_HISTORICAL_AVAILABILITY";
    require record.opening_basis == ledger.basis and record.opening_recognized == ledger.recognized else "ESCALATION_HISTORY_RECONCILIATION";
    require not entry.is_current or (ledger.basis == history.cumulative_basis and ledger.recognized == history.recognized_entitlement and (not is_some(ledger.previous_end) or get_or(ledger.previous_end, scope.period.start) == scope.period.start) and (history.origin == "genesis" or sum(filter(history.period_history, last => last.period.end == scope.period.start and last.source_case_id == history.source_case_id), last => 1) == 1)) else "ESCALATION_OPENING_HISTORY_RECONCILIATION";
    define checked_events = for each row in sort_by(record.events, event => event.sequence) {
      require row.id != "" and row.source_ref != "" else "ESCALATION_IDENTITY_REQUIRED";
      require sum(filter(record.events, other => other.id == row.id), other => 1) == 1 else "ESCALATION_DUPLICATE_ID";
      require sum(filter(ledger.used_ids, id => id == row.id), id => 1) == 0 else "ESCALATION_EVENT_ALREADY_RECOGNIZED";
      require sum(filter(ledger.used_sources, id => id == row.source_ref), id => 1) == 0 and sum(filter(record.events, other => other.source_ref == row.source_ref), other => 1) == 1 else "ESCALATION_SOURCE_ALREADY_RECOGNIZED";
      require row.scope == fact_scope else "ESCALATION_FACT_SCOPE";
      require sum(filter(checked_evidence, support => support.id == row.evidence_ref), support => 1) == 1 else "ESCALATION_FACT_EVIDENCE";
      require row.observed_at < cutoff else "ESCALATION_FACT_CUTOFF";
      require in_period(row.effective_date, record.period) else "ESCALATION_FACT_PERIOD";
      require row.basis >= USD 0 else "ESCALATION_EXACT_NONNEGATIVE_VALUE";
      require row.sequence >= 0 and sum(filter(record.events, other => other.sequence == row.sequence), other => 1) == 1 else "ESCALATION_EVENT_SEQUENCE";
      yield row;
    };
    define period_basis = sum(checked_events, row => row.basis);
    define period_end_basis = ledger.basis + period_basis;
    define ending_bands = filter(checked_bands, band => band.lower <= period_end_basis and (not is_some(band.upper) or period_end_basis < get_or(band.upper, period_end_basis)));
    require sum(ending_bands, band => 1) == 1 else "ESCALATION_BRACKET_PARTITION";
    define ending_rate = sum(ending_bands, band => band.rate);
    define ending_id = fold ending_bands from "" with unused, band { yield band.id; };
    define computed: {basis: Money<USD>, recognized: Money<USD>, earned: Money<USD>, rows: List<{basis: Money<USD>, basis_after: Money<USD>, basis_before: Money<USD>, current_result: Money<USD>, evidence_ref: Text, id: Text, rate_details: {kind: Text, selected: Option<{bracket_id: Text, rate: Ratio}>, slices: List<{amount: Money<USD>, bracket_id: Text, rate: Ratio, width: Money<USD>}>}, recognized_after: Money<USD>, recognized_before: Money<USD>, sequence: Int, source_ref: Text}>} = fold checked_events from {basis: ledger.basis, recognized: ledger.recognized, earned: USD 0, rows: []} with step, event {
      define after = step.basis + event.basis;
      define selected_at = if policy.method == "current_period_ending_rate" then period_end_basis else if policy.method == "row_opening_rate" then step.basis else after;
      define selected = filter(checked_bands, band => band.lower <= selected_at and (not is_some(band.upper) or selected_at < get_or(band.upper, selected_at)));
      define selected_rate = sum(selected, band => band.rate);
      define selected_id = fold selected from "" with unused, band { yield band.id; };
      define possible_slices = map(checked_bands, band => {bracket_id: band.id, width: max(USD 0, min(after, get_or(band.upper, after)) - max(step.basis, band.lower)), rate: band.rate, amount: max(USD 0, min(after, get_or(band.upper, after)) - max(step.basis, band.lower)) * band.rate});
      define slices = filter(possible_slices, part => part.width > USD 0);
      define earned = if policy.method == "prospective_split" then sum(slices, part => part.amount) else if policy.method == "cumulative_reprice_delta" then after * selected_rate - step.recognized else event.basis * selected_rate;
      require earned >= USD 0 else "ESCALATION_NEGATIVE_REPRICE_DELTA";
      define details: {kind: Text, selected: Option<{bracket_id: Text, rate: Ratio}>, slices: List<{amount: Money<USD>, bracket_id: Text, rate: Ratio, width: Money<USD>}>} = {kind: if policy.method == "prospective_split" then "marginal_slices" else "selected_rate", slices: if policy.method == "prospective_split" then slices else [], selected: if policy.method == "prospective_split" then none() else some({bracket_id: selected_id, rate: selected_rate})};
      define line = {id: event.id, sequence: event.sequence, basis: event.basis, basis_before: step.basis, basis_after: after, recognized_before: step.recognized, current_result: earned, recognized_after: step.recognized + earned, rate_details: details, source_ref: event.source_ref, evidence_ref: event.evidence_ref};
      yield {basis: after, recognized: step.recognized + earned, earned: step.earned + earned, rows: append(step.rows, line)};
    };
    require policy.method != "cumulative_reprice_delta" or computed.earned == computed.basis * ending_rate - ledger.recognized else "ESCALATION_REPRICE_RECONCILIATION";
    require entry.is_current or (record.current_result == computed.earned and record.closing_basis == computed.basis and record.closing_recognized == computed.recognized) else "ESCALATION_HISTORY_RECONCILIATION";
    define historical: {closing_basis: Money<USD>, closing_recognized: Money<USD>, current_result: Money<USD>, events: List<{basis: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_basis: Text, source_observed_at: Text, source_ref: Text}>, opening_basis: Money<USD>, opening_recognized: Money<USD>, opening_utc: Instant, period: Period, source_case_id: Text, source_numbers: Option<{closing_basis: Text, closing_recognized: Text, current_result: Text, opening_basis: Text, opening_recognized: Text}>} = {source_case_id: record.source_case_id, period: record.period, opening_utc: record.opening_utc, opening_basis: ledger.basis, opening_recognized: ledger.recognized, events: checked_events, current_result: computed.earned, closing_basis: computed.basis, closing_recognized: computed.recognized, source_numbers: record.source_numbers};
    define result = {source_case_id: record.source_case_id, period: record.period, opening_basis: ledger.basis, opening_recognized: ledger.recognized, period_basis: period_basis, closing_basis: computed.basis, closing_recognized: computed.recognized, current_result: computed.earned, ending_bracket_id: ending_id, ending_rate: ending_rate, rows: computed.rows};
    yield {basis: computed.basis, recognized: computed.recognized, previous_end: some(record.period.end), used_ids: concat(ledger.used_ids, map(checked_events, row => row.id)), used_sources: concat(ledger.used_sources, map(checked_events, row => row.source_ref)), used_cases: append(ledger.used_cases, record.source_case_id), history: append(ledger.history, historical), replays: append(ledger.replays, result)};
  };
  define current = filter(replayed.replays, row => row.source_case_id == case_id);
  define current_rows: List<{basis: Money<USD>, basis_after: Money<USD>, basis_before: Money<USD>, current_result: Money<USD>, evidence_ref: Text, id: Text, rate_details: {kind: Text, selected: Option<{bracket_id: Text, rate: Ratio}>, slices: List<{amount: Money<USD>, bracket_id: Text, rate: Ratio, width: Money<USD>}>}, recognized_after: Money<USD>, recognized_before: Money<USD>, sequence: Int, source_ref: Text}> = fold current from [] with unused, row { yield row.rows; };
  closing history = {scope: fact_scope, purpose: "cumulative_escalation", policy_id: policy.id, policy_revision: policy.revision, method: policy.method, bracket_table: table_snapshot, boundary: scope.period.end, origin: "prior_result", source_case_id: case_id, cumulative_basis: replayed.basis, recognized_entitlement: replayed.recognized, period_history: replayed.history};
  emit "comparison" = {source_case_id: case_id, period: scope.period, method: policy.method, opening_basis: history.cumulative_basis, opening_recognized: history.recognized_entitlement, period_basis: sum(current, row => row.period_basis), closing_basis: replayed.basis, closing_recognized: replayed.recognized, current_result: sum(current, row => row.current_result), ending_bracket_id: fold current from "" with unused, row { yield row.ending_bracket_id; }, ending_rate: sum(current, row => row.ending_rate), status_meaning: "synthetic calculated entitlement/delta, not issued or actually paid"};
  emit "rows" = current_rows;
  emit "period_replays" = replayed.replays;
  emit "reconciliation" = replayed.basis == history.cumulative_basis + sum(events, row => row.basis) and replayed.recognized == history.recognized_entitlement + sum(current, row => row.current_result);
}
