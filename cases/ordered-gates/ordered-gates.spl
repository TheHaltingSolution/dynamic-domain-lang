// Original chronological full work gate, followed by the separately supplied payout proxy.
schedule OrderedGate language "spl/0.1-draft" core "spl-core/0.1-draft" schema "spl-data/0.1-draft" {
  input scope: {agreement_id: Id<Agreement>, participant_id: Id<Participant>, pool_id: Id<Pool>, period: Period};
  input project: Id<Asset>;
  input fact_scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Id<Participant>, pool_id: Text, purpose: Text};
  input policy: {amendments: Text, continuous: Text, event_order: Text, evidence_class: Text, fee_offset: Text, id: Text, latch: Text, method: Text, net: Text, reserve_movements: Text, revision: Text, rounding: Text};
  input cutoff: Instant;
  input registry: {genesis_date: Date, net_pool_id: Text, terms: {effective_end: Date, effective_start: Date, evidence_ref: Text, gross_rate: Ratio, id: Text, net_rate: Ratio, observed_at: Instant, original_ref: Text, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text, video_proxy: Ratio}, work: {eligible: Bool, evidence_ref: Text, id: Text, observed_at: Instant, original_ref: Text, purchaser_produced: Bool, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text}};
  input registry_original: Text;
  input research: {professional_approval: Text, references: List<{locator: Text, path: Text, sha256: Text}>, source_boundary: Text};
  input research_original: Text;
  input frames: List<{aggregate_hurdles: List<{attained: Bool, effective_date: Date, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, original_ref: Text, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text}>, costs: List<{actual_third_party: Bool, decision_id: Text, evidence_ref: Text, evidence_slot: Int, gross_amount: Money<USD>, id: Text, incurred_at: Instant, kind: Text, observed_at: Instant, original_ref: Text, reduction_ids: List<Text>, row_slot: Int, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, sequence: Int, source_ref: Text}>, cutoff: Instant, decisions: List<{channel: Text, eligible: Bool, event_ref: Text, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, original_ref: Text, parent_event_id: Text, reason: Text, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text}>, evidence: List<{approved: Bool, id: Text, kind: Text, observed_at: Instant, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, slot: Int, source_ref: Text}>, id: Text, net_worksheets: List<{amount: Money<USD>, evidence_ref: Text, evidence_slot: Int, id: Text, member_asset_ids: List<Id<Asset>>, observed_at: Instant, original_ref: Text, period: Period, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text}>, ordering_authorities: List<{evidence_ref: Text, evidence_slot: Int, id: Text, keys: List<{event_id: Text, occurred_at: Instant, sequence: Int}>, observed_at: Instant, original_ref: Text, period: Period, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text}>, period: Period, period_end_utc: Instant, period_start_utc: Instant, populations: List<{complete: Bool, event_ids: List<Text>, evidence_ref: Text, evidence_slot: Int, id: Text, kind: Text, observed_at: Instant, original_ref: Text, period: Period, raw_total: Money<USD>, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text}>, receipts: List<{amount: Money<USD>, channel: Text, decision_id: Text, earned_at: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, kind: Text, nonrefundable: Bool, observed_at: Instant, original_ref: Text, received_at: Instant, row_slot: Int, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, sequence: Int, source_ref: Text}>, reductions: List<{amount: Money<USD>, category: Text, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, original_ref: Text, parent_event_id: Text, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text}>, terms_slot: Int, work_slot: Int}>;
  input original_frames: List<{id: Text, originals: {aggregate_hurdles: List<{id: Text, raw_original: Text}>, costs: List<{id: Text, kind: Text, raw_original: Text, row_slot: Int}>, decisions: List<{id: Text, raw_original: Text}>, evidence: List<{id: Text, raw_original: Text, slot: Int}>, net_worksheets: List<{id: Text, raw_original: Text}>, ordering_authorities: List<{id: Text, raw_original: Text}>, populations: List<{id: Text, raw_original: Text}>, receipts: List<{id: Text, kind: Text, raw_original: Text, row_slot: Int}>, reductions: List<{id: Text, raw_original: Text}>}, period: Period, raw_original: Text}>;
  input supplied_opening: {boundary: Date, detail: Option<{consumed_classification_ids: List<Text>, consumed_classification_refs: List<Text>, consumed_event_ids: List<Text>, consumed_original_refs: List<Text>, costs: Money<USD>, history: List<{facts: Text, result: {aggregate_hurdle: Text, bank_movement_created: Bool, calculated_unissued_entitlement: Money<USD>, closing_costs: Money<USD>, closing_latch: Bool, closing_receipts: Money<USD>, continuous_current_history: Bool, current_eligible_costs: Money<USD>, current_full_receipts: Money<USD>, gross_candidate: Money<USD>, gross_status: Text, net_candidate: Money<USD>, net_status: Text, net_worksheet: Text, opening_costs: Money<USD>, opening_latch: Bool, opening_receipts: Money<USD>, path: List<{admitted_full_receipt: Money<USD>, economic_instant: Instant, gross_branch_applicable: Bool, id: Text, kind: Text, latch_after: Bool, latch_before: Bool, original: Text, payout_base_contribution: Money<USD>, post_costs: Money<USD>, post_receipts: Money<USD>, post_surplus: Money<USD>, pre_costs: Money<USD>, pre_receipts: Money<USD>, pre_surplus: Money<USD>, proxy_factor: Ratio, reason: Text, row_slot: Int, selected_full_amount: Money<USD>, sequence: Int}>, payment_evidence_status: Text, payout_base: Money<USD>, period: Period, population_records: List<Text>, selected_branch: Text, source_case_id: Text, status: Text, supplied_net_subtotal: Money<USD>}}>, latched: Bool, receipts: Money<USD>, recognized_entitlement: Money<USD>, schema_version: Text}>, identity_codec: Text, origin: Text, original_frames: List<{id: Text, period: Period, raw_original: Text}>, policy: {amendments: Text, continuous: Text, event_order: Text, evidence_class: Text, fee_offset: Text, id: Text, latch: Text, method: Text, net: Text, reserve_movements: Text, revision: Text, rounding: Text}, registry: {genesis_date: Date, net_pool_id: Text, terms: {effective_end: Date, effective_start: Date, evidence_ref: Text, gross_rate: Ratio, id: Text, net_rate: Ratio, observed_at: Instant, original_ref: Text, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text, video_proxy: Ratio}, work: {eligible: Bool, evidence_ref: Text, id: Text, observed_at: Instant, original_ref: Text, purchaser_produced: Bool, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text}}, registry_original: Text, research: {professional_approval: Text, references: List<{locator: Text, path: Text, sha256: Text}>, source_boundary: Text}, research_original: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Id<Participant>, pool_id: Text, purpose: Text}, source_case_id: Option<Text>, transport_profile: Text};
  input predecessor: Option<{closing_state: {boundary: Date, detail: Option<{consumed_classification_ids: List<Text>, consumed_classification_refs: List<Text>, consumed_event_ids: List<Text>, consumed_original_refs: List<Text>, costs: Money<USD>, history: List<{facts: Text, result: {aggregate_hurdle: Text, bank_movement_created: Bool, calculated_unissued_entitlement: Money<USD>, closing_costs: Money<USD>, closing_latch: Bool, closing_receipts: Money<USD>, continuous_current_history: Bool, current_eligible_costs: Money<USD>, current_full_receipts: Money<USD>, gross_candidate: Money<USD>, gross_status: Text, net_candidate: Money<USD>, net_status: Text, net_worksheet: Text, opening_costs: Money<USD>, opening_latch: Bool, opening_receipts: Money<USD>, path: List<{admitted_full_receipt: Money<USD>, economic_instant: Instant, gross_branch_applicable: Bool, id: Text, kind: Text, latch_after: Bool, latch_before: Bool, original: Text, payout_base_contribution: Money<USD>, post_costs: Money<USD>, post_receipts: Money<USD>, post_surplus: Money<USD>, pre_costs: Money<USD>, pre_receipts: Money<USD>, pre_surplus: Money<USD>, proxy_factor: Ratio, reason: Text, row_slot: Int, selected_full_amount: Money<USD>, sequence: Int}>, payment_evidence_status: Text, payout_base: Money<USD>, period: Period, population_records: List<Text>, selected_branch: Text, source_case_id: Text, status: Text, supplied_net_subtotal: Money<USD>}}>, latched: Bool, receipts: Money<USD>, recognized_entitlement: Money<USD>, schema_version: Text}>, identity_codec: Text, origin: Text, original_frames: List<{id: Text, period: Period, raw_original: Text}>, policy: {amendments: Text, continuous: Text, event_order: Text, evidence_class: Text, fee_offset: Text, id: Text, latch: Text, method: Text, net: Text, reserve_movements: Text, revision: Text, rounding: Text}, registry: {genesis_date: Date, net_pool_id: Text, terms: {effective_end: Date, effective_start: Date, evidence_ref: Text, gross_rate: Ratio, id: Text, net_rate: Ratio, observed_at: Instant, original_ref: Text, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text, video_proxy: Ratio}, work: {eligible: Bool, evidence_ref: Text, id: Text, observed_at: Instant, original_ref: Text, purchaser_produced: Bool, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text}}, registry_original: Text, research: {professional_approval: Text, references: List<{locator: Text, path: Text, sha256: Text}>, source_boundary: Text}, research_original: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Id<Participant>, pool_id: Text, purpose: Text}, source_case_id: Option<Text>, transport_profile: Text}, period: Period, source_case_id: Text}>;
  opening history: {boundary: Date, detail: Option<{consumed_classification_ids: List<Text>, consumed_classification_refs: List<Text>, consumed_event_ids: List<Text>, consumed_original_refs: List<Text>, costs: Money<USD>, history: List<{facts: Text, result: {aggregate_hurdle: Text, bank_movement_created: Bool, calculated_unissued_entitlement: Money<USD>, closing_costs: Money<USD>, closing_latch: Bool, closing_receipts: Money<USD>, continuous_current_history: Bool, current_eligible_costs: Money<USD>, current_full_receipts: Money<USD>, gross_candidate: Money<USD>, gross_status: Text, net_candidate: Money<USD>, net_status: Text, net_worksheet: Text, opening_costs: Money<USD>, opening_latch: Bool, opening_receipts: Money<USD>, path: List<{admitted_full_receipt: Money<USD>, economic_instant: Instant, gross_branch_applicable: Bool, id: Text, kind: Text, latch_after: Bool, latch_before: Bool, original: Text, payout_base_contribution: Money<USD>, post_costs: Money<USD>, post_receipts: Money<USD>, post_surplus: Money<USD>, pre_costs: Money<USD>, pre_receipts: Money<USD>, pre_surplus: Money<USD>, proxy_factor: Ratio, reason: Text, row_slot: Int, selected_full_amount: Money<USD>, sequence: Int}>, payment_evidence_status: Text, payout_base: Money<USD>, period: Period, population_records: List<Text>, selected_branch: Text, source_case_id: Text, status: Text, supplied_net_subtotal: Money<USD>}}>, latched: Bool, receipts: Money<USD>, recognized_entitlement: Money<USD>, schema_version: Text}>, identity_codec: Text, origin: Text, original_frames: List<{id: Text, period: Period, raw_original: Text}>, policy: {amendments: Text, continuous: Text, event_order: Text, evidence_class: Text, fee_offset: Text, id: Text, latch: Text, method: Text, net: Text, reserve_movements: Text, revision: Text, rounding: Text}, registry: {genesis_date: Date, net_pool_id: Text, terms: {effective_end: Date, effective_start: Date, evidence_ref: Text, gross_rate: Ratio, id: Text, net_rate: Ratio, observed_at: Instant, original_ref: Text, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text, video_proxy: Ratio}, work: {eligible: Bool, evidence_ref: Text, id: Text, observed_at: Instant, original_ref: Text, purchaser_produced: Bool, scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>}, source_ref: Text}}, registry_original: Text, research: {professional_approval: Text, references: List<{locator: Text, path: Text, sha256: Text}>, source_boundary: Text}, research_original: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Id<Participant>, pool_id: Text, purpose: Text}, source_case_id: Option<Text>, transport_profile: Text} from "ordered-gates/original-work-history";
  require fact_scope.agreement_id == scope.agreement_id and fact_scope.participant_id == scope.participant_id and fact_scope.asset_id == project else "GATE_SCOPE";
  require fact_scope.currency == "USD" and fact_scope.purpose == "rolling_work_gate" and fact_scope.pool_id != "" else "GATE_SCOPE_CURRENCY_PURPOSE";
  require registry.net_pool_id != "" and registry.net_pool_id != fact_scope.pool_id else "GATE_NET_SCOPE_MUST_BE_DISTINCT";
  require policy.method == "split_reopen" or policy.method == "opening_gate" or policy.method == "closing_gate" or policy.method == "continuous_history" or policy.method == "split_latch" or policy.method == "full_cross_reopen" or policy.method == "next_row_reopen" else "GATE_METHOD";
  require policy.id == "SYNTHETIC-LG-ORDERED-GATE-01" else "GATE_POLICY";
  require policy.revision == "1" else "GATE_POLICY";
  require policy.evidence_class == "research_assumption" else "GATE_POLICY";
  require policy.event_order == "exact_instant_then_authorized_unique_sequence" else "GATE_POLICY";
  require policy.continuous == "opening_and_every_current_prefix" else "GATE_POLICY";
  require policy.latch == "positive_receipt_reaches_equality_from_false_genesis" else "GATE_POLICY";
  require policy.rounding == "exact_no_rounding" else "GATE_POLICY";
  require policy.fee_offset == "0" else "GATE_POLICY";
  require policy.reserve_movements == "0" else "GATE_POLICY";
  require policy.net == "separately_evidenced_zero_worksheet" else "GATE_POLICY";
  require policy.amendments == "unsupported" else "GATE_POLICY";
  require research.source_boundary == "source_economics_with_synthetic_history_and_operating_choices" and research.professional_approval == "not_established" and sum(research.references, row => 1) >= 3 else "GATE_RESEARCH_BOUNDARY";
  require history == supplied_opening else "GATE_CANONICAL_OPENING_MISMATCH";
  require history.transport_profile == "ordered-gates-original-json/1" and history.identity_codec == "unicode-utf8-hex/1" else "GATE_STATE_TRANSPORT";
  require history.scope == fact_scope and history.policy == policy and history.registry == registry and history.research == research and history.registry_original == registry_original and history.research_original == research_original else "GATE_PINNED_CONTEXT_CHANGED";
  define work_scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>} = {agreement_id: fact_scope.agreement_id, participant_id: fact_scope.participant_id, currency: fact_scope.currency, pool_id: some(fact_scope.pool_id), asset_id: some(project), purpose: some(fact_scope.purpose)};
  define aggregate_scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>} = {agreement_id: fact_scope.agreement_id, participant_id: fact_scope.participant_id, currency: fact_scope.currency, pool_id: none(), asset_id: none(), purpose: none()};
  define net_scope: {agreement_id: Id<Agreement>, asset_id: Option<Id<Asset>>, currency: Text, participant_id: Id<Participant>, pool_id: Option<Text>, purpose: Option<Text>} = {agreement_id: fact_scope.agreement_id, participant_id: fact_scope.participant_id, currency: fact_scope.currency, pool_id: some(registry.net_pool_id), asset_id: none(), purpose: none()};
  define frame_count = sum(frames, frame => 1);
  require frame_count > 0 and frame_count <= 4 else "GATE_COMPLETE_PREHISTORY_REQUIRED";
  define unique_cases = fold sort_by(map(frames, frame => frame.id), id => id) from "" with previous, id { require id != "" and id != previous else "GATE_CASE_REPLAY"; yield id; };
  require unique_cases != "" else "GATE_CASE_REPLAY";
  define metadata: {boundary: Date, cutoff: Option<Instant>} = fold frames from {boundary: registry.genesis_date, cutoff: none()} with step, frame {
    require frame.period.start == step.boundary and frame.period.start < frame.period.end and frame.period_end_utc < frame.cutoff else "GATE_HISTORY_ADJACENCY";
    require not is_some(step.cutoff) or require_some(step.cutoff, "GATE_HISTORY_CUTOFF_ORDER") < frame.cutoff else "GATE_HISTORY_CUTOFF_ORDER";
    yield {boundary: frame.period.end, cutoff: some(frame.cutoff)};
  };
  require metadata.boundary == scope.period.end and history.boundary == scope.period.start else "GATE_OPENING_BOUNDARY";
  define frame_headers = for each frame in frames {
    yield {id: frame.id, period: frame.period, population_ids: {receipts: map(frame.receipts, row => row.id), costs: map(frame.costs, row => row.id), decisions: map(frame.decisions, row => row.id), reductions: map(frame.reductions, row => row.id), populations: map(frame.populations, row => row.id), evidence: map(frame.evidence, row => row.id), ordering_authorities: map(frame.ordering_authorities, row => row.id), aggregate_hurdles: map(frame.aggregate_hurdles, row => row.id), net_worksheets: map(frame.net_worksheets, row => row.id)}, evidence_slots: map(frame.evidence, row => row.slot), event_slots: concat(map(frame.receipts, row => row.row_slot), map(frame.costs, row => row.row_slot))};
  };
  define frame_index = make_map(frame_headers, row => row.period.start, row => row);
  define originals_index = make_map(original_frames, row => row.period.start, row => row);
  require map(original_frames, row => row.id) == map(frames, row => row.id) else "GATE_ORIGINAL_FRAME_POPULATION";
  define raw_populations = for each source in original_frames {
    define header = require_some(lookup(frame_index, source.period.start), "GATE_ORIGINAL_FRAME_POPULATION");
    require source.id == header.id and source.period == header.period and source.raw_original != "" else "GATE_ORIGINAL_FRAME_POPULATION";
    define originals = source.originals;
    define original_receipts = originals.receipts;
    require map(original_receipts, row => row.id) == header.population_ids.receipts and sum(original_receipts, row => if row.raw_original != "" then 1 else 0) == sum(header.population_ids.receipts, id => 1) else "GATE_ORIGINAL_RECORD_POPULATION";
    define original_costs = originals.costs;
    require map(original_costs, row => row.id) == header.population_ids.costs and sum(original_costs, row => if row.raw_original != "" then 1 else 0) == sum(header.population_ids.costs, id => 1) else "GATE_ORIGINAL_RECORD_POPULATION";
    define original_decisions = originals.decisions;
    require map(original_decisions, row => row.id) == header.population_ids.decisions and sum(original_decisions, row => if row.raw_original != "" then 1 else 0) == sum(header.population_ids.decisions, id => 1) else "GATE_ORIGINAL_RECORD_POPULATION";
    define original_reductions = originals.reductions;
    require map(original_reductions, row => row.id) == header.population_ids.reductions and sum(original_reductions, row => if row.raw_original != "" then 1 else 0) == sum(header.population_ids.reductions, id => 1) else "GATE_ORIGINAL_RECORD_POPULATION";
    define original_populations = originals.populations;
    require map(original_populations, row => row.id) == header.population_ids.populations and sum(original_populations, row => if row.raw_original != "" then 1 else 0) == sum(header.population_ids.populations, id => 1) else "GATE_ORIGINAL_RECORD_POPULATION";
    define original_evidence = originals.evidence;
    require map(original_evidence, row => row.id) == header.population_ids.evidence and sum(original_evidence, row => if row.raw_original != "" then 1 else 0) == sum(header.population_ids.evidence, id => 1) else "GATE_ORIGINAL_RECORD_POPULATION";
    define original_ordering_authorities = originals.ordering_authorities;
    require map(original_ordering_authorities, row => row.id) == header.population_ids.ordering_authorities and sum(original_ordering_authorities, row => if row.raw_original != "" then 1 else 0) == sum(header.population_ids.ordering_authorities, id => 1) else "GATE_ORIGINAL_RECORD_POPULATION";
    define original_aggregate_hurdles = originals.aggregate_hurdles;
    require map(original_aggregate_hurdles, row => row.id) == header.population_ids.aggregate_hurdles and sum(original_aggregate_hurdles, row => if row.raw_original != "" then 1 else 0) == sum(header.population_ids.aggregate_hurdles, id => 1) else "GATE_ORIGINAL_RECORD_POPULATION";
    define original_net_worksheets = originals.net_worksheets;
    require map(original_net_worksheets, row => row.id) == header.population_ids.net_worksheets and sum(original_net_worksheets, row => if row.raw_original != "" then 1 else 0) == sum(header.population_ids.net_worksheets, id => 1) else "GATE_ORIGINAL_RECORD_POPULATION";
    require map(original_evidence, row => row.slot) == header.evidence_slots and concat(map(original_receipts, row => row.row_slot), map(original_costs, row => row.row_slot)) == header.event_slots else "GATE_ORIGINAL_RECORD_POPULATION";
    require sum(original_receipts, row => if row.kind == "receipt" then 1 else 0) == sum(header.population_ids.receipts, id => 1) and sum(original_costs, row => if row.kind == "cost" then 1 else 0) == sum(header.population_ids.costs, id => 1) else "GATE_ORIGINAL_RECORD_POPULATION";
    yield source.id;
  };
  require sum(raw_populations, id => 1) == frame_count else "GATE_ORIGINAL_RECORD_POPULATION";
  define replayed: {costs: Money<USD>, latched: Bool, receipts: Money<USD>, recognized: Money<USD>, seen: {decision_ids: List<Text>, decision_refs: List<Text>, ids: List<Text>, refs: List<Text>}, snapshots: List<{id: Text, period: Period, recognized: Money<USD>, result: {bank_movement_created: Bool, calculated_unissued_entitlement: Money<USD>, closing_costs: Money<USD>, closing_latch: Bool, closing_receipts: Money<USD>, continuous_current_history: Bool, current_eligible_costs: Money<USD>, current_full_receipts: Money<USD>, gross_candidate: Money<USD>, gross_status: Text, net_candidate: Money<USD>, net_status: Text, opening_costs: Money<USD>, opening_latch: Bool, opening_receipts: Money<USD>, path: List<{admitted_full_receipt: Money<USD>, economic_instant: Instant, gross_branch_applicable: Bool, id: Text, kind: Text, latch_after: Bool, latch_before: Bool, payout_base_contribution: Money<USD>, post_costs: Money<USD>, post_receipts: Money<USD>, post_surplus: Money<USD>, pre_costs: Money<USD>, pre_receipts: Money<USD>, pre_surplus: Money<USD>, proxy_factor: Ratio, reason: Text, row_slot: Int, selected_full_amount: Money<USD>, sequence: Int}>, payment_evidence_status: Text, payout_base: Money<USD>, period: Period, selected_branch: Text, source_case_id: Text, status: Text, supplied_net_subtotal: Money<USD>}, seen: {decision_ids: List<Text>, decision_refs: List<Text>, ids: List<Text>, refs: List<Text>}}>} = fold frames from {receipts: USD 0, costs: USD 0, latched: false, seen: {ids: [], refs: [], decision_ids: [], decision_refs: []}, recognized: USD 0, snapshots: []} with ledger, frame {
    define source_receipts = frame.receipts;
    define source_costs = frame.costs;
    define source_decisions = frame.decisions;
    define source_reductions = frame.reductions;
