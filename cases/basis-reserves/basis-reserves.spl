    require sum(filter(checked_elections, other => other.receipt_id == row.receipt_id), other => 1) == 1 and sum(filter(checked_receipts, receipt => receipt.id == row.receipt_id), receipt => 1) == 1 else "BR_ELECTION_RECEIPT_REFERENCE";
    require sum(filter(checked_elections, other => other.vintage_id == row.vintage_id), other => 1) == 1 else "BR_VINTAGE_IDENTITY_PURPOSE";
    require row.approved and row.approved_date <= row.election_date else "BR_ELECTION_AUTHORITY";
    yield row;
  };
  define validated_receipts = for each row in checked_receipts {
    require row.amount >= USD 0 and row.cash_received_country == "US" and row.territory == "US" and row.medium == "physical_videogram" else "BR_US_PHYSICAL_PROFILE";
    require sum(filter(validated_elections, election => election.id == row.election_id and election.receipt_id == row.id and election.election_date == row.receipt_date), election => 1) == 1 else "BR_SAME_DAY_ESTABLISHMENT";
    require row.sequence >= 0 and sum(filter(checked_receipts, other => other.receipt_date == row.receipt_date and other.sequence == row.sequence), other => 1) == 1 else "BR_EXPLICIT_EVENT_SEQUENCE";
    require sum(filter(checked_receipts, other => other.cash_line_ref == row.cash_line_ref), other => 1) == 1 else "BR_CASH_PARENT_ALIAS";
    require sum(filter(checked_receipts, other => other.source_ref == row.source_ref), other => 1) == 1 else "BR_SOURCE_ALIAS";
    require row.receipt_date_utc <= row.observed_at and sum(filter(checked_checkpoints, cp => cp.period.start <= row.receipt_date and row.receipt_date < cp.period.end and row.observed_at < cp.cutoff and row.evidence_observed_at < cp.cutoff), cp => 1) == 1 else "BR_EVENT_WINDOW";
    yield {id: row.id, amount: row.amount, receipt_date: row.receipt_date, sequence: row.sequence, election_id: row.election_id, cash_line_ref: row.cash_line_ref, source_ref: row.source_ref, observed_at: row.observed_at, evidence_observed_at: row.evidence_observed_at, due_date: add_calendar_months(row.receipt_date, 6, policy.invalid_day)};
  };
  define validated_authorities = for each row in checked_return_authorities {
    require row.approved and row.purpose == "basis_stage_videogram_returns" else "BR_RETURN_AUTHORITY";
    require sum(filter(checked_returns, returned => returned.id == row.return_id), returned => 1) == 1 and sum(filter(checked_return_authorities, other => other.return_id == row.return_id), other => 1) == 1 else "BR_UNUSED_RETURN_AUTHORITY";
