  define checkpoint_results = for each snapshot in replayed.snapshots {
    define vintages = for each vintage in snapshot.vintages {
      define election_slot: Option<{id: Text, observed_at: Instant, raw_original: Text, receipt_id: Text}> = fold filter(state_source_elections, row => row.id == vintage.election_id) from none() with slot, row { yield some(row); };
      define election_record = require_some(election_slot, "BR_ELECTION_REQUIRED").raw_original;
      yield {id: vintage.id, receipt_id: vintage.receipt_id, cash_line_ref: vintage.cash_line_ref, election_id: vintage.election_id, reserve_elected: vintage.reserve_elected, origin_date: vintage.origin_date, due_date: vintage.due_date, added: vintage.added, applied_returns: vintage.applied_returns, released: vintage.released, available: vintage.available, return_ids: vintage.return_ids, claim_ids: vintage.claim_ids, release_ids: vintage.release_ids, scope: fact_scope, purpose: "basis_stage_videogram_returns", election_record: election_record};
