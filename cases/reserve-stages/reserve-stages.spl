  define current_slot: Option<{application_details: List<{applied: Money<USD>, closing_available: Money<USD>, opening_available: Money<USD>, original: Text}>, bank_movement_created: Bool, closing_reserve: Money<USD>, cumulative: {additions: Money<USD>, applications: Money<USD>, fee: Money<USD>, gross: Money<USD>, nonparticipant: Money<USD>, producer: Money<USD>, releases: Money<USD>}, current: {additions: Money<USD>, applications: Money<USD>, fee: Money<USD>, gross: Money<USD>, nonparticipant: Money<USD>, producer: Money<USD>, releases: Money<USD>}, fee_consumption_keys: List<List<Text>>, issuance_status: Text, observation_basis: Text, opening_reserve: Money<USD>, payment_evidence_status: Text, period: Period, receipt_details: List<{addition: Money<USD>, cap_room_before: Money<USD>, closing_retained_after_addition: Money<USD>, fee_consumed: Money<USD>, fee_key: List<Text>, gross: Money<USD>, nonparticipant: Money<USD>, producer: Money<USD>, raw_addition: Money<USD>, receipt_id: Text, retained_before: Money<USD>, unretained_current: Money<USD>, vintage_id: Text}>, release_details: List<{basis: Text, closing_available: Money<USD>, due_date: Date, fee: Money<USD>, key: List<Text>, nonparticipant: Money<USD>, opening_available: Money<USD>, original_addition: Money<USD>, producer: Money<USD>, quota: Money<USD>, released: Money<USD>, tranche_id: Text, vintage_id: Text}>, release_policy: Text, reserve_measure: Text, source_case_id: Text, source_clearance_inferred: Bool, stage: Text, status: Text, unknown_local_offset_paths: List<Text>, vintages: List<{applied: Money<USD>, available: Money<USD>, established_date: Date, fee_assessed_once: Money<USD>, fee_key: List<Text>, id: Text, liquidated: Bool, original_addition: Money<USD>, original_election: Text, original_receipt: Text, raw_addition: Money<USD>, released: Money<USD>, reserve_measure: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>, purp