    define released = sum(current_movements, row => row.release);
    define net = gross - added + released;
    define fee = net * authority.fee_rate;
    define totals = {gross: gross, added: added, applied_returns: total_return_applied, released: released, net_receipts: net, fee: fee, allocation: net - fee};
    define cumulative = {gross: ledger.cumulative.gross + totals.gross, added: ledger.cumulative.added + totals.added, applied_returns: ledger.cumulative.applied_returns + totals.applied_returns, released: ledger.cumulative.released + totals.released, net_receipts: ledger.cumulative.net_receipts + totals.net_receipts, fee: ledger.cumulative.fee + totals.fee, allocation: ledger.cumulative.allocation + totals.allocation};
    define closing_vintages = sort_by(processed_days.vintages, row => row.id);
    define balance = sum(closing_vintages, row => row.available);
    require sum(closing_vintages, row => if row.added == row.applied_returns + row.released + row.available then 0 else 1) == 0 else "BR_VINTAGE_CONSERVATION";
    require sum(closing_vintages, row => if row.available == USD 0 or row.due_date > checkpoint.as_of then 0 else 1) == 0 else "BR_OVERDUE_UNRELEASED";
    require cumulative.gross - cumulative.applied_returns == cumulative.net_receipts + balance and cumulative.fee + cumulative.allocation == cumulative.net_receipts else "BR_LEDGER_CONSERVATION";
    define snapshot = {id: checkpoint.id, checkpoint_id: checkpoint.id, source_case_id: checkpoint.source_case_id, period: checkpoint.period, as_of: checkpoint.as_of, cutoff: checkpoint.cutoff, source_cutoff: checkpoint.source_cutoff, gross: gross, added: added, applied_returns: total_return_applied, released: released, net_receipts: net, fee: fee, allocation: net - fee, closing_reserve: balance, movements: current_movements, vintages: closing_vintages};
