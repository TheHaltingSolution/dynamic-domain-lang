ext}, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, transport_profile: Text}> = fold filter(state_frames, row => row.id != run_checkpoint_id) from none() with slot, row { yield some(row.state); };
  define current_state: Option<{boundary: Date, detail: Option<{authority: Text, cumulative: {added: Money<USD>, allocation: Money<USD>, applied_returns: Money<USD>, fee: Money<USD>, gross: Money<USD>, net_receipts: Money<USD>, released: Money<USD>}, last_checkpoint_id: Text, movements: List<{allocation: Money<USD>, authority_id: Option<Text>, claim_id: Option<Text>, election_id: Option<Text>, fee: Money<USD>, gross: Money<USD>, id: Tuple<Text, Text>, kind: Text, movement_date: Date, net_receipts: Money<USD>, receipt_id: Text, release: Money<USD>, reserve_addition: Money<USD>, return_applied: Money<USD>, source_ref: Option<Text>, vintage_id: Text}>, research: {assignment_url: Text, clauses: Text, ld03_sha256: Text, primary_url: Text, rr04_sha256: Text}, sources: {checkpoints: List<{category: Text, id: Text, record: Text}>, clearances: List<{category: Text, id: Text, record: Text}>, elections: List<{category: Text, id: Text, record: Text}>, evidence: List<{category: Text, id: Text, record: Text}>, populations: List<{category: Text, id: Text, record: Text}>, receipts: List<{category: Text, id: Text, record: Text}>, return_authorities: List<{category: Text, id: Text, record: Text}>, returns: List<{category: Text, id: Text, record: Text}>}, vintages: List<{added: Money<USD>, applied_returns: Money<USD>, available: Money<USD>, cash_line_ref: Text, claim_ids: List<Text>, due_date: Date, election_id: Text, election_record: Text, id: Text, origin_date: Date, purpose: Text, receipt_id: Text, release_ids: List<Tuple<Text, Text>>, released: Money<USD>, reserve_elected: Bool, return_ids: List<Text>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}}>}>, origin: Text, policy: {date_basis: Text, evidence_class: Text, excess_returns: Text, fee_stage: Text, id: Text, invalid_day: Text, liquidation: Text, method: Text, months: Text, professional_review: Text, revision: Text, rounding: Text, same_day_order: Text}, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, transport_profile: Text}> = fold filter(state_frames, row => row.id == run_checkpoint_id) from none() with slot, row { yield some(row.state); };
  require history.scope == fact_scope and history.purpose == "basis_stage_videogram_returns" and history.policy == policy and history.boundary == scope.period.start else "BR_OPENING_RECONCILIATION";
  require not is_some(history.detail) or sum(require_some(history.detail, "BR_OPENING_REQUIRED").vintages, row => if row.available == USD 0 or row.due_date >= history.boundary then 0 else 1) == 0 else "BR_OPENING_OVERDUE";
  require if is_some(previous_state) then (history.origin == "supplied_history" or history.origin == "prior_result") and history.source_case_id == require_some(previous_state, "BR_OPENING_REQUIRED").source_case_id and history.detail == require_some(previous_state, "BR_OPENING_REQUIRED").detail else history.origin == "genesis" and history.source_case_id == "genesis" and not is_some(history.detail) and not is_some(predecessor) else "BR_OPENING_RECONCILIATION";
  require if history.origin == "prior_result" then is_some(predecessor) and require_some(predecessor, "BR_PREDECESSOR_REQUIRED").source_case_id == history.source_case_id and require_some(predecessor, "BR_PREDECESSOR_REQUIRED").period.end == scope.period.start and require_some(predecessor, "BR_PREDECESSOR_REQUIRED").closing_state == history else not is_some(predecessor) else "BR_PREDECESSOR_MISMATCH";
  define current_slot: Option<{added: Money<USD>, allocation: Money<USD>, applied_returns: Money<USD>, as_of: Date, checkpoint_id: Text, closing_reserve: Money<USD>, cutoff: Instant, fee: Money<USD>, gross: Money<USD>, id: Text, movements: List<{allocation: Money<USD>, authority_id: Option<Text>, claim_id: Option<Text>, election_id: Option<Text>, fee: Money<USD>, gross: Money<USD>, id: Tuple<Text, Text>, kind: Text, movement_date: Date, net_receipts: Money<USD>, receipt_id: Text, release: Money<USD>, reserve_addition: Money<USD>, return_applied: Money<USD>, source_ref: Option<Text>, vintage_id: Text}>, net_receipts: Money<USD>, period: Period, released: Money<USD>, source_case_id: Text, source_cutoff: Text, vintages: List<{added: Money<USD>, applied_returns: Money<USD>, available: Money<USD>, cash_line_ref: Text, claim_ids: List<Text>, due_date: Date, election_id: Text, election_record: Text, id: Text, origin_date: Date, purpose: Text, receipt_id: Text, release_ids: List<Tuple<Text, Text>>, released: Money<USD>, reserve_elected: Bool, return_ids: List<Text>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}}>}> = fold filter(checkpoint_results, row => row.checkpoint_id == run_checkpoint_id) from none() with slot, row { yield some(row); };
  define current = require_some(current_slot, "BR_CURRENT_CHECKPOINT");
