{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["format", "jobs", "additional_dependencies"],
  "properties": {
    "format": {"const": "spl-component-request/1"},
    "jobs": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "package_ref"],
      "properties": {
        "id": {"type": "string", "pattern": "[A-Za-z][A-Za-z0-9_-]{0,63}"},
        "package_ref": {"$ref": "#/$defs/ref"},
        "dependency_profile_ref": {"$ref": "#/$defs/ref"}
      }
    }},
    "additional_dependencies": {"type": "array", "maxItems": 4096, "items": {
      "type": "object", "additionalProperties": false, "required": ["left", "right", "reason"],
      "properties": {
        "left": {"type": "string"}, "right": {"type": "string"},
        "reason": {"type": "string", "minLength": 1}
      }
    }}
  },
  "$defs": {"ref": {
    "type": "object", "additionalProperties": false, "required": ["locator", "sha256"],
    "properties": {"locator": {"type": "string", "minLength": 1},
                   "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}}
  }}
}
