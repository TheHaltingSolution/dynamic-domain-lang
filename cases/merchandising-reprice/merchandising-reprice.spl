// Original first-dollar merchandising facts and as-known replay. No solved input amounts.
schedule FirstDollarMerchandising language "spl/0.1-draft" core "spl-core/0.1-draft" schema "spl-data/0.1-draft" {
  input scope: {agreement_id: Id<Agreement>, participant_id: Id<Participant>, pool_id: Id<Pool>, period: Period};
  input project: Id<Asset>;
  input fact_scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>};
  input case_id: Text;
  input run: {view_id: Text, mode: Text};
  input research: {clause_locator: Text, contract_url: Text, ld03_sha256: Text, rr04_sha256: Text};
  input policy: {amounts: Text, cash_date_basis: Text, credit_profile: Text, evidence_class: Text, id: Text, method: Text, negative_adjustments: Text, professional_review: Text, revision: Text};
  input cutoff: Instant;
  input source_cutoff: Text;
  input terms: {approved: Bool, effective: Period, effective_end_utc: Instant, effective_start_utc: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, license_deduction_rate: Ratio, multipliers: List<Ratio>, observed_at: Instant, production_charge_rate: Ratio, rates: List<Ratio>, raw_original: Text, recorded_date: Date, recorded_date_utc: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_license_deduction_rate: Text, source_multipliers: List<Ratio>, source_observed_at: Text, source_production_charge_rate: Text, source_rates: List<Ratio>, source_ref: Text, version: Text};
  input cost_basis: {evidence_ref: Text, evidence_slot: Int, funding_charge: Money<USD>, id: Text, observed_at: Instant, production_cost: Money<USD>, raw_original: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_funding_charge: Text, source_observed_at: Text, source_production_cost: Text, source_ref: Text};
  input qualifications: {approved: Bool, comics_rank: Int, evidence_ref: Text, evidence_slot: Int, feature_produced: Bool, feature_released: Bool, graphic_units: Int, id: Text, observed_at: Instant, photography_date: Date, photography_date_utc: Instant, rank_date: Date, rank_date_utc: Instant, raw_original: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_comics_rank: Text, source_graphic_units: Text, source_observed_at: Text, source_ref: Text, units_date: Date, units_date_utc: Instant};
  input cb_switch: {approved: Bool, complete: Bool, credit_line_ids: List<Text>, effective_date: Date, effective_date_utc: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, included_in_nmi: Bool, observed_at: Instant, prior_credit_total: Money<USD>, prior_owner_entitlement: Money<USD>, raw_original: Text, receipt_ids: List<Text>, removed_from_defined_receipts: Bool, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_observed_at: Text, source_prior_credit_total: Text, source_prior_owner_entitlement: Text, source_ref: Text};
  input periods: List<{evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, period: Period, period_end_utc: Instant, period_start_utc: Instant, raw_original: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_observed_at: Text, source_ref: Text}>;
  input views: List<{approved: Bool, as_of: Date, as_of_next: Date, as_of_utc: Instant, coverage_end: Date, coverage_end_utc: Instant, cutoff: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, mode: Text, observed_at: Instant, period_id: Text, raw_original: Text, recognition_id: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, source_cutoff: Text, source_observed_at: Text, source_ref: Text}>;
  input receipts: List<{amount: Money<USD>, evidence_ref: Text, evidence_slot: Int, id: Text, lane: Text, observed_at: Instant, period_id: Text, qualifying: Bool, raw_original: Text, receipt_ref: Text, received_date: Date, received_date_utc: Instant, recognition_date: Date, recognition_date_utc: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_observed_at: Text, source_ref: Text}>;
  input box_office: List<{effective_date: Date, effective_date_utc: Instant, evidence_ref: Text, evidence_slot: Int, gross: Money<USD>, id: Text, metric: Text, observed_at: Instant, raw_original: Text, recorded_date: Date, recorded_date_utc: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_gross: Text, source_observed_at: Text, source_ref: Text}>;
  input issues: List<{amount: Money<USD>, evidence_ref: Text, evidence_slot: Int, id: Text, issued_date: Date, issued_date_utc: Instant, observed_at: Instant, raw_original: Text, recognition_id: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_observed_at: Text, source_ref: Text, version: Text}>;
  input payments: List<{amount: Money<USD>, bank_disbursement_id: Text, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, paid_date: Date, paid_date_utc: Instant, raw_original: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_observed_at: Text, source_ref: Text}>;
  input applications: List<{amount: Money<USD>, applied_date: Date, applied_date_utc: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, issue_id: Text, observed_at: Instant, payment_id: Text, raw_original: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_observed_at: Text, source_ref: Text}>;
  input populations: List<{adjustment_ids: List<Text>, adjustment_total: Money<USD>, application_ids: List<Text>, application_total: Money<USD>, box_office_ids: List<Text>, complete: Bool, disbursement_ids: List<Text>, evidence_ref: Text, evidence_slot: Int, id: Text, issue_ids: List<Text>, issue_total: Money<USD>, observed_at: Instant, payment_ids: List<Text>, payment_total: Money<USD>, raw_original: Text, receipt_coverage: Period, receipt_coverage_end_utc: Instant, receipt_coverage_start_utc: Instant, receipt_ids: List<Text>, receipt_total: Money<USD>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_adjustment_total: Text, source_application_total: Text, source_issue_total: Text, source_observed_at: Text, source_payment_total: Text, source_receipt_total: Text, source_ref: Text, view_id: Text}>;
  input no_default: List<{approved: Bool, evidence_ref: Text, evidence_slot: Int, id: Text, not_in_material_default: Bool, observed_at: Instant, raw_original: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_observed_at: Text, source_ref: Text, view_id: Text}>;
  input evidence: List<{approved: Bool, id: Text, kind: Text, observed_at: Instant, raw_original: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, slot: Int, source_observed_at: Text, source_ref: Text, source_kind: Text, approval_ref: Text, evidence_ref: Text}>;
  input supplied_opening: {boundary: Date, detail: Option<{actual_paid: Money<USD>, cb_switch: Text, cost_basis: Text, issued_outstanding: Money<USD>, known_issued: Money<USD>, last_view_id: Text, qualifications: Text, recognition_history: List<{amount: Money<USD>, attributions: List<{earned_period_id: Text, id: Text, kind: Text, license_cash: Money<USD>, license_deduction: Money<USD>, nmi: Money<USD>, previously_recognized: Money<USD>, qualifying: Bool, rate: Ratio, receipt_id: Text, receipt_ref: Text, recognition_delta: Money<USD>, target_entitlement: Money<USD>}>, catchup: Money<USD>, current_earnings: Money<USD>, cutoff: Instant, id: Text, period_id: Text, source_case_id: Text, source_cutoff: Text, view_id: Text}>, recognized_rows: List<{amount: Money<USD>, id: Text, receipt_id: Text}>, recognized_unissued: Money<USD>, research: {clause_locator: Text, contract_url: Text, ld03_sha256: Text, rr04_sha256: Text}, sources: {applications: List<{category: Text, id: Text, record: Text}>, box_office: List<{category: Text, id: Text, record: Text}>, evidence: List<{category: Text, id: Text, record: Text}>, issues: List<{category: Text, id: Text, record: Text}>, no_default: List<{category: Text, id: Text, record: Text}>, payments: List<{category: Text, id: Text, record: Text}>, periods: List<{category: Text, id: Text, record: Text}>, populations: List<{category: Text, id: Text, record: Text}>, receipts: List<{category: Text, id: Text, record: Text}>, views: List<{category: Text, id: Text, record: Text}>}, terms: Text}>, origin: Text, policy: {amounts: Text, cash_date_basis: Text, credit_profile: Text, evidence_class: Text, id: Text, method: Text, negative_adjustments: Text, professional_review: Text, revision: Text}, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, transport_profile: Text};
  input predecessor: Option<{source_case_id: Text, period: Period, closing_state: {boundary: Date, detail: Option<{actual_paid: Money<USD>, cb_switch: Text, cost_basis: Text, issued_outstanding: Money<USD>, known_issued: Money<USD>, last_view_id: Text, qualifications: Text, recognition_history: List<{amount: Money<USD>, attributions: List<{earned_period_id: Text, id: Text, kind: Text, license_cash: Money<USD>, license_deduction: Money<USD>, nmi: Money<USD>, previously_recognized: Money<USD>, qualifying: Bool, rate: Ratio, receipt_id: Text, receipt_ref: Text, recognition_delta: Money<USD>, target_entitlement: Money<USD>}>, catchup: Money<USD>, current_earnings: Money<USD>, cutoff: Instant, id: Text, period_id: Text, source_case_id: Text, source_cutoff: Text, view_id: Text}>, recognized_rows: List<{amount: Money<USD>, id: Text, receipt_id: Text}>, recognized_unissued: Money<USD>, research: {clause_locator: Text, contract_url: Text, ld03_sha256: Text, rr04_sha256: Text}, sources: {applications: List<{category: Text, id: Text, record: Text}>, box_office: List<{category: Text, id: Text, record: Text}>, evidence: List<{category: Text, id: Text, record: Text}>, issues: List<{category: Text, id: Text, record: Text}>, no_default: List<{category: Text, id: Text, record: Text}>, payments: List<{category: Text, id: Text, record: Text}>, periods: List<{category: Text, id: Text, record: Text}>, populations: List<{category: Text, id: Text, record: Text}>, receipts: List<{category: Text, id: Text, record: Text}>, views: List<{category: Text, id: Text, record: Text}>}, terms: Text}>, origin: Text, policy: {amounts: Text, cash_date_basis: Text, credit_profile: Text, evidence_class: Text, id: Text, method: Text, negative_adjustments: Text, professional_review: Text, revision: Text}, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, transport_profile: Text}}>;
  opening history: {boundary: Date, detail: Option<{actual_paid: Money<USD>, cb_switch: Text, cost_basis: Text, issued_outstanding: Money<USD>, known_issued: Money<USD>, last_view_id: Text, qualifications: Text, recognition_history: List<{amount: Money<USD>, attributions: List<{earned_period_id: Text, id: Text, kind: Text, license_cash: Money<USD>, license_deduction: Money<USD>, nmi: Money<USD>, previously_recognized: Money<USD>, qualifying: Bool, rate: Ratio, receipt_id: Text, receipt_ref: Text, recognition_delta: Money<USD>, target_entitlement: Money<USD>}>, catchup: Money<USD>, current_earnings: Money<USD>, cutoff: Instant, id: Text, period_id: Text, source_case_id: Text, source_cutoff: Text, view_id: Text}>, recognized_rows: List<{amount: Money<USD>, id: Text, receipt_id: Text}>, recognized_unissued: Money<USD>, research: {clause_locator: Text, contract_url: Text, ld03_sha256: Text, rr04_sha256: Text}, sources: {applications: List<{category: Text, id: Text, record: Text}>, box_office: List<{category: Text, id: Text, record: Text}>, evidence: List<{category: Text, id: Text, record: Text}>, issues: List<{category: Text, id: Text, record: Text}>, no_default: List<{category: Text, id: Text, record: Text}>, payments: List<{category: Text, id: Text, record: Text}>, periods: List<{category: Text, id: Text, record: Text}>, populations: List<{category: Text, id: Text, record: Text}>, receipts: List<{category: Text, id: Text, record: Text}>, views: List<{category: Text, id: Text, record: Text}>}, terms: Text}>, origin: Text, policy: {amounts: Text, cash_date_basis: Text, credit_profile: Text, evidence_class: Text, id: Text, method: Text, negative_adjustments: Text, professional_review: Text, revision: Text}, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, transport_profile: Text} from "merchandising/original-recognition-history";
  define source_rows_periods = map(periods, row => {id: row.id, period: row.period, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, scope: row.scope, source_ref: row.source_ref});
  define source_rows_views = map(views, row => {id: row.id, source_case_id: row.source_case_id, period_id: row.period_id, mode: row.mode, as_of: row.as_of, as_of_next: row.as_of_next, cutoff: row.cutoff, source_cutoff: row.source_cutoff, coverage_end: row.coverage_end, coverage_end_utc: row.coverage_end_utc, recognition_id: row.recognition_id, approved: row.approved, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, scope: row.scope, source_ref: row.source_ref});
  define source_rows_receipts = map(receipts, row => {id: row.id, period_id: row.period_id, amount: row.amount, received_date: row.received_date, received_date_utc: row.received_date_utc, recognition_date: row.recognition_date, qualifying: row.qualifying, lane: row.lane, receipt_ref: row.receipt_ref, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, scope: row.scope, source_ref: row.source_ref});
  define source_rows_box_office = map(box_office, row => {id: row.id, gross: row.gross, effective_date: row.effective_date, recorded_date: row.recorded_date, recorded_date_utc: row.recorded_date_utc, metric: row.metric, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, scope: row.scope, source_ref: row.source_ref});
  define source_rows_issues = map(issues, row => {id: row.id, version: row.version, recognition_id: row.recognition_id, amount: row.amount, issued_date: row.issued_date, issued_date_utc: row.issued_date_utc, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, scope: row.scope, source_ref: row.source_ref});
  define source_rows_payments = map(payments, row => {id: row.id, bank_disbursement_id: row.bank_disbursement_id, amount: row.amount, paid_date: row.paid_date, paid_date_utc: row.paid_date_utc, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, scope: row.scope, source_ref: row.source_ref});
  define source_rows_applications = map(applications, row => {id: row.id, payment_id: row.payment_id, issue_id: row.issue_id, amount: row.amount, applied_date: row.applied_date, applied_date_utc: row.applied_date_utc, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, scope: row.scope, source_ref: row.source_ref});
  define source_rows_populations = map(populations, row => {id: row.id, view_id: row.view_id, complete: row.complete, receipt_coverage: row.receipt_coverage, receipt_ids: row.receipt_ids, receipt_total: row.receipt_total, adjustment_ids: row.adjustment_ids, adjustment_total: row.adjustment_total, box_office_ids: row.box_office_ids, issue_ids: row.issue_ids, issue_total: row.issue_total, payment_ids: row.payment_ids, disbursement_ids: row.disbursement_ids, payment_total: row.payment_total, application_ids: row.application_ids, application_total: row.application_total, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, scope: row.scope, source_ref: row.source_ref});
  define source_rows_no_default = map(no_default, row => {id: row.id, view_id: row.view_id, approved: row.approved, not_in_material_default: row.not_in_material_default, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, scope: row.scope, source_ref: row.source_ref});
  define source_rows_evidence = map(evidence, row => {id: row.id, scope: row.scope, observed_at: row.observed_at, source_ref: row.source_ref, approved: row.approved, source_kind: row.source_kind, slot: row.slot});
  define state_source_periods = map(periods, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original, period: row.period});
  define state_source_views = map(views, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original, period_id: row.period_id});
  define state_source_receipts = map(receipts, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original, period_id: row.period_id});
  define state_source_box_office = map(box_office, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original, recorded_date: row.recorded_date});
  define state_source_issues = map(issues, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original});
  define state_source_payments = map(payments, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original});
  define state_source_applications = map(applications, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original});
  define state_source_populations = map(populations, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original, view_id: row.view_id});
  define state_source_no_default = map(no_default, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original, view_id: row.view_id});
  define state_source_evidence = map(evidence, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original});
  require fact_scope.contract_id == scope.agreement_id and fact_scope.participant_id == scope.participant_id and fact_scope.pool_id == scope.pool_id and fact_scope.asset_id == project and fact_scope.currency == "USD" else "MR_FACT_SCOPE";
  require case_id != "" and history == supplied_opening and history.transport_profile == "merchandising-original-json/1" else "MR_OPENING_REQUIRED";
  require policy.id == "RR04-MERCHANDISING-CATCHUP-01" and policy.revision == "1" and policy.method == "trigger_period_catchup" and policy.credit_profile == "complete_approved_zero_cb_credit" and policy.amounts == "exact_no_rounding" and policy.negative_adjustments == "reject" and policy.cash_date_basis == "supplied_utc_date" and policy.evidence_class == "research_assumption" and policy.professional_review == "proposed" else "MR_SELECTED_POLICY";
  require research.contract_url == "https://www.sec.gov/Archives/edgar/data/1410132/000101376207002025/ex1014.htm" and research.clause_locator == "3.2(a)(i)-(v);3.2(c);3.2(d)(i)-(ii)(a);Exhibit CB" else "MR_RESEARCH_SOURCE";
  require run.mode == "final" or run.mode == "preview" else "MR_RUN_MODE";
  define original_evidence_ids = map(source_rows_evidence, e => e.id);
  define evidence_count = sum(original_evidence_ids, id => 1);
  define evidence_id_order = fold sort_by(original_evidence_ids, id => id) from {started: false, previous: "", count: 0} with step, id {
    require not step.started or step.previous != id else "MR_DUPLICATE_ID";
    yield {started: true, previous: id, count: step.count + 1};
  };
  define checked_evidence = for each row in source_rows_evidence {
    require row.id != "" and row.source_ref != "" and row.source_kind != "" else "MR_IDENTITY_REQUIRED";
    require row.scope == fact_scope and row.approved else "MR_EVIDENCE_APPROVAL";
    require row.observed_at < cutoff else "MR_EVIDENCE_AFTER_CUTOFF";
    require evidence_id_order.count == evidence_count else "MR_DUPLICATE_ID";
    require row.slot >= 0 and row.slot < evidence_id_order.count else "MR_EVIDENCE_SLOT_RANGE";
    yield {id: row.id, observed_at: row.observed_at, kind: row.source_kind, slot: row.slot};
  };
  define evidence_index = make_map(checked_evidence, e => e.slot, e => e);
  require terms.id != "" and terms.source_ref != "" and terms.scope == fact_scope and terms.observed_at < cutoff else "MR_FACT_SCOPE";
  define terms_support = require_some(lookup(evidence_index, terms.evidence_slot), "MR_EVIDENCE_REQUIRED");
  require terms_support.id == terms.evidence_ref and terms_support.kind == "fixed-approved-contract-terms" else "MR_EVIDENCE_KIND";
  require cost_basis.id != "" and cost_basis.source_ref != "" and cost_basis.scope == fact_scope and cost_basis.observed_at < cutoff else "MR_FACT_SCOPE";
  define cost_basis_support = require_some(lookup(evidence_index, cost_basis.evidence_slot), "MR_EVIDENCE_REQUIRED");
  require cost_basis_support.id == cost_basis.evidence_ref and cost_basis_support.kind == "original-production-and-funding-stage" else "MR_EVIDENCE_KIND";
  require qualifications.id != "" and qualifications.source_ref != "" and qualifications.scope == fact_scope and qualifications.observed_at < cutoff else "MR_FACT_SCOPE";
  define qualifications_support = require_some(lookup(evidence_index, qualifications.evidence_slot), "MR_EVIDENCE_REQUIRED");
  require qualifications_support.id == qualifications.evidence_ref and qualifications_support.kind == "approved-feature-and-pre-photography-records" else "MR_EVIDENCE_KIND";
  require cb_switch.id != "" and cb_switch.source_ref != "" and cb_switch.scope == fact_scope and cb_switch.observed_at < cutoff else "MR_FACT_SCOPE";
  define cb_switch_support = require_some(lookup(evidence_index, cb_switch.evidence_slot), "MR_EVIDENCE_REQUIRED");
  require cb_switch_support.id == cb_switch.evidence_ref and cb_switch_support.kind == "complete_cb_reclassification_zero_credit" else "MR_EVIDENCE_KIND";
  define checked_periods = for each row in source_rows_periods {
    require row.id != "" and row.source_ref != "" else "MR_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "MR_FACT_SCOPE";
    require row.observed_at < cutoff else "MR_SOURCE_AFTER_CUTOFF";
    require sum(filter(source_rows_periods, other => other.id == row.id), other => 1) == 1 else "MR_DUPLICATE_ID";
    define support = require_some(lookup(evidence_index, row.evidence_slot), "MR_EVIDENCE_REQUIRED");
    require support.id == row.evidence_ref else "MR_EVIDENCE_KIND";
    yield {id: row.id, period: row.period, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, evidence_observed_at: support.observed_at};
  };
  define checked_views = for each row in source_rows_views {
    require row.id != "" and row.source_ref != "" else "MR_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "MR_FACT_SCOPE";
    require row.observed_at < cutoff else "MR_SOURCE_AFTER_CUTOFF";
    require sum(filter(source_rows_views, other => other.id == row.id), other => 1) == 1 else "MR_DUPLICATE_ID";
    define support = require_some(lookup(evidence_index, row.evidence_slot), "MR_EVIDENCE_REQUIRED");
    require support.id == row.evidence_ref else "MR_EVIDENCE_KIND";
    yield {id: row.id, source_case_id: row.source_case_id, period_id: row.period_id, mode: row.mode, as_of: row.as_of, as_of_next: row.as_of_next, cutoff: row.cutoff, source_cutoff: row.source_cutoff, coverage_end: row.coverage_end, coverage_end_utc: row.coverage_end_utc, recognition_id: row.recognition_id, approved: row.approved, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, evidence_observed_at: support.observed_at};
  };
  define checked_receipts = for each row in source_rows_receipts {
    require row.id != "" and row.source_ref != "" else "MR_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "MR_FACT_SCOPE";
    require row.observed_at < cutoff else "MR_SOURCE_AFTER_CUTOFF";
