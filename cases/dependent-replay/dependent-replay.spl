    define period_entry: {as_of: Date, as_of_ordinal: Int, as_of_utc: Instant, cutoff: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, period: Period, period_end_ordinal: Int, period_end_utc: Instant, predecessor_period_id: Option<Text>, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Text, pool_id: Id<Pool>, purpose: Text}, source_ref: Text} = require_some(fold period_matches from none() with selected, item { yield some(item); }, "REPLAY_RECEIPT_PERIOD");
    require row.base_amount >= USD 0 and row.original_ref != "" and row.entitlement_ref != "" and row.term_id != "" else "REPLAY_EXACT_NONNEGATIVE";
    require row.sequence >= 0 and row.effective_date_utc <= row.observed_at else "REPLAY_RECEIPT_CHRONOLOGY";
