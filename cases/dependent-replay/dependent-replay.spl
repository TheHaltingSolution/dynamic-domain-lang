  define original_controls = original_calculation.controls;
  define unique_issue_periods = fold sort_by(map(registry.issued_artifacts, row => row.period_id), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_ISSUE_PERIOD"; yield id; };
  define unique_issue_refs = fold sort_by(map(registry.issued_artifacts, row => row.original_ref), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_ISSUE_ALIAS"; yield id; };
  define unique_issue_results = fold sort_by(map(registry.issued_artifacts, row => row.result_ref), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_ISSUE_ALIAS"; yield id; };
  require sort_by(map(registry.issued_artifacts, row => row.period_id), id => id) == sort_by(map(original_periods, row => row.id), id => id) else "REPLAY_COMPLETE_ISSUED_CHAIN";
  define checked_issues = for each row in registry.issued_artifacts {
    
      require row.id != "" and row.source_ref != "" and row.scope == fact_scope else "REPLAY_FACT_SCOPE";
      require row.observed_at < minimum_cutoff else "REPLAY_SOURCE_OBSERVATION";
      define supporting_row = require_some(lookup(static_evidence_index, row.evidence_slot), "REPLAY_EVIDENCE_REQUIRED");
      require supporting_row.id == row.evidence_ref and supporting_row.kind == "original_issued_artifact" and supporting_row.observed_at <= row.observed_at else "REPLAY_SOURCE_OBSERVATION";

    define period_entry: {as_of: Date, as_of_ordinal: Int, as_of_utc: Instant, cutoff: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, period: Period, period_end_ordinal: Int, period_end_utc: Instant, predecessor_period_id: Option<Text>, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Text, pool_id: Id<Pool>, purpose: Text}, source_ref: Text} = require_some(fold filter(original_period_rows, item => item.id == row.period_id) from none() with selected, item { yield some(item); }, "REPLAY_ISSUE_PERIOD");
    require period_entry.period_end_utc <= row.issued_at and row.issued_at <= row.observed_at and row.observed_at < period_entry.cutoff else "REPLAY_ISSUE_KNOWN_VIEW";
    require row.original_ref != "" and row.result_ref != "" else "REPLAY_ISSUE_ALIAS";
    define period_receipts = filter(checked_original_receipts, item => item.period_id == row.period_id);
    define unique_receipt_ids = fold sort_by(row.receipt_ids, id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_ID_LIST"; yield id; };
    require row.complete and sum(row.receipt_ids, id => 1) <= 8 and sort_by(row.receipt_ids, id => id) == sort_by(map(period_receipts, item => item.id), id => id) and sum(filter(period_receipts, item => item.observed_at > row.observed_at), item => 1) == 0 else "REPLAY_COMPLETE_ORIGINAL_ISSUE";
    define calculated: {closing_cumulative_basis: Money<USD>, earned: Money<USD>, gross_basis: Money<USD>, opening_cumulative_basis: Money<USD>, period: Period, period_id: Text, receipt_details: List<{closing_cumulative_basis: Money<USD>, earned: Money<USD>, lower_basis: Money<USD>, opening_cumulative_basis: Money<USD>, original_basis: Money<USD>, receipt_id: Text, replacement_id: Option<Text>, selected_basis: Money<USD>, term_id: Text, upper_basis: Money<USD>}>} = require_some(fold filter(original_controls, item => item.period_id == row.period_id) from none() with selected, item { yield some(item); }, "REPLAY_ISSUE_PERIOD");
    require row.basis_total == calculated.gross_basis and row.earned == calculated.earned and row.opening_cumulative_basis == calculated.opening_cumulative_basis and row.closing_cumulative_basis == calculated.closing_cumulative_basis else "REPLAY_ORIGINAL_ISSUE_RECONCILIATION";
    yield row;
  };
  define issue_chain: Option<Text> = fold original_periods from none() with previous, period_entry {
    define issue: {basis_total: Money<USD>, closing_cumulative_basis: Money<USD>, complete: Bool, earned: Money<USD>, evidence_ref: Text, evidence_slot: Int, id: Text, issued_at: Instant, issued_at_utc_date: Date, observed_at: Instant, opening_cumulative_basis: Money<USD>, original_ref: Text, period_id: Text, predecessor_issue_id: Option<Text>, receipt_ids: List<Text>, result_ref: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Text, pool_id: Id<Pool>, purpose: Text}, source_ref: Text} = require_some(fold filter(checked_issues, item => item.period_id == period_entry.id) from none() with selected, item { yield some(item); }, "REPLAY_COMPLETE_ISSUED_CHAIN");
    require issue.predecessor_issue_id == previous else "REPLAY_BROKEN_ISSUE_PREDECESSOR";
    yield some(issue.id);
  };
  define original_issued_total = sum(checked_issues, row => row.earned);
  define unique_bank_refs = fold sort_by(map(registry.payments, row => row.original_ref), id => id) from "" with previous, id { require id != "" and id != previous else "REPLAY_BANK_LINE_ALIAS"; yield id; };
  define static_refs = concat(map(checked_original_receipts, row => row.original_ref), map(registry.payments, row => row.original_ref));
  define checked_payments = for each row in registry.payments {
    
      require row.id != "" and row.source_ref != "" and row.scope == fact_scope else "REPLAY_FACT_SCOPE";
      require row.observed_at < minimum_cutoff else "REPLAY_SOURCE_OBSERVATION";
      define supporting_row = require_some(lookup(static_evidence_index, row.evidence_slot), "REPLAY_EVIDENCE_REQUIRED");
      require supporting_row.id == row.evidence_ref and supporting_row.kind == "actual_participation_payment" and supporting_row.observed_at <= row.observed_at else "REPLAY_SOURCE_OBSERVATION";

    define original_receipt: {base_amount: Money<USD>, effective_date: Date, effective_date_utc: Instant, entitlement_ref: Text, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, original_ref: Text, period_id: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Text, pool_id: Id<Pool>, purpose: Text}, sequence: Int, source_ref: Text, term_id: Text} = require_some(fold filter(checked_original_receipts, item => item.id == row.receipt_id) from none() with selected, item { yield some(item); }, "REPLAY_PAYMENT_ROLES");
    require row.payer_id == registry.payer_id and row.recipient_id == fact_scope.participant_id and row.purpose == "participation_payment" else "REPLAY_PAYMENT_ROLES";
    require original_receipt.effective_date_utc <= row.paid_at and row.paid_at <= row.observed_at and row.paid_at_utc_date < original_chain.boundary else "REPLAY_PAYMENT_CHRONOLOGY";
    require row.amount >= USD 0 and row.original_ref != "" else "REPLAY_EXACT_NONNEGATIVE";
    yield row;
  };
  define checked_applications = for each row in registry.applications {
    
      require row.id != "" and row.source_ref != "" and row.scope == fact_scope else "REPLAY_FACT_SCOPE";
      require row.observed_at < minimum_cutoff else "REPLAY_SOURCE_OBSERVATION";
      define supporting_row = require_some(lookup(static_evidence_index, row.evidence_slot), "REPLAY_EVIDENCE_REQUIRED");
      require supporting_row.id == row.evidence_ref and supporting_row.kind == "actual_payment_application" and supporting_row.observed_at <= row.observed_at else "REPLAY_SOURCE_OBSERVATION";

    define payment: {amount: Money<USD>, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, original_ref: Text, paid_at: Instant, paid_at_utc_date: Date, payer_id: Text, purpose: Text, receipt_id: Text, recipient_id: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Text, pool_id: Id<Pool>, purpose: Text}, source_ref: Text} = require_some(fold filter(checked_payments, item => item.id == row.payment_id) from none() with selected, item { yield some(item); }, "REPLAY_PAYMENT_APPLICATION_REFERENCE");
    define original_receipt: {base_amount: Money<USD>, effective_date: Date, effective_date_utc: Instant, entitlement_ref: Text, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, original_ref: Text, period_id: Text, scope: {agreement_id: Id<Agreement>, asset_id: Id<Asset>, currency: Text, participant_id: Text, pool_id: Id<Pool>, purpose: Text}, sequence: Int, source_ref: Text, term_id: Text} = require_some(fold filter(checked_original_receipts, item => item.id == row.receipt_id) from none() with selected, item { yield some(item); }, "REPLAY_PAYMENT_APPLICATION_REFERENCE");
    require row.approved and payment.receipt_id == original_receipt.id and row.original_entitlement_ref == original_receipt.entitlement_ref and payment.observed_at <= row.observed_at else "REPLAY_PAYMENT_APPLICATION_AUTHORITY";
    require row.amount >= USD 0 else "REPLAY_EXACT_NONNEGATIVE";
    yield row;
  };
  define conserved_payments = for each row in checked_payments {
