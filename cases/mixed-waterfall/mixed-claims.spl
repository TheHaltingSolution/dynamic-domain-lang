  require sum(filter(original_registry_ids, meta => meta.category == "roster_authority" and meta.ids == sort_by([registry.roster_authority.id], identity => identity)), x => 1) == 1 else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  require sum(filter(original_registry_ids, meta => meta.category == "residual_weights" and meta.ids == sort_by(map(registry.residual_weights, x => x.participant_id), identity => identity)), x => 1) == 1 else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  require sum(filter(original_registry_ids, meta => meta.category == "capital_fundings" and meta.ids == sort_by(map(registry.capital_fundings, x => x.id), identity => identity)), x => 1) == 1 else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  require sum(filter(original_registry_ids, meta => meta.category == "advance_fundings" and meta.ids == sort_by(map(registry.advance_fundings, x => x.id), identity => identity)), x => 1) == 1 else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  require sum(filter(original_registry_ids, meta => meta.category == "funding_populations" and meta.ids == sort_by(map(registry.funding_populations, x => x.id), identity => identity)), x => 1) == 1 else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  require sum(filter(original_registry_ids, meta => meta.category == "fee_bases" and meta.ids == sort_by(map(registry.fee_bases, x => x.id), identity => identity)), x => 1) == 1 else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  require sum(filter(original_registry_ids, meta => meta.category == "correction_sources" and meta.ids == sort_by(map(registry.correction_sources, x => x.id), identity => identity)), x => 1) == 1 else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  require sum(filter(original_registry_ids, meta => meta.category == "historical_payments" and meta.ids == sort_by(map(registry.historical_payments, x => x.id), identity => identity)), x => 1) == 1 else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  require sum(filter(original_registry_ids, meta => meta.category == "historical_applications" and meta.ids == sort_by(map(registry.historical_applications, x => x.id), identity => identity)), x => 1) == 1 else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  require sum(filter(original_registry_ids, meta => meta.category == "historical_payment_populations" and meta.ids == sort_by(map(registry.historical_payment_populations, x => x.id), identity => identity)), x => 1) == 1 else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  require sum(filter(original_registry_ids, meta => meta.category == "claim_authorities" and meta.ids == sort_by(map(registry.claim_authorities, x => x.id), identity => identity)), x => 1) == 1 else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  require sum(filter(original_registry_ids, meta => meta.category == "evidence" and meta.ids == sort_by(map(registry.evidence, x => x.id), identity => identity)), x => 1) == 1 else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  require sum(original_registry_ids, x => 1) == 14 and sum(raw_frames, x => 1) == sum(originals, x => 1) else "MIXED_ORIGINAL_REGISTRY_POPULATION";
  define static_cutoff = fold originals from frame.cutoff with earliest_cutoff, original { yield if original.facts.cutoff < earliest_cutoff then original.facts.cutoff else earliest_cutoff; };
  define first_record = require_some(lookup(make_map(filter(originals, x => x.facts.period_start_utc == first), x => 0, x => x.facts), 0), "MIXED_OPENING");
  // Immutable original sources must be valid at every historical cutoff.
  define registered = register_claims(registry.participant_ids, registry.payer_id, registry.earning_terms, registry.roster_authority, registry.residual_weights, registry.capital_fundings, registry.advance_fundings, registry.funding_populations, registry.fee_bases, registry.correction_sources, registry.historical_payments, registry.historical_applications, registry.historical_payment_populations, registry.claim_authorities, registry.evidence, first_record.as_of, first_record.as_of_next_utc, static_cutoff, fact_scope, first, policy.method);
  define replay = fold originals from {started: false, boundary: frame.period.start, claims: empty_claims, history: empty_history, allocations: empty_allocations, offsets: empty_allocations, ids: empty_text, refs: empty_text, last_case: history.source_case_id, previous: none_detail} with prior, row {
    require not prior.started or prior.boundary == row.facts.period.start else "MIXED_HISTORY_ADJACENCY";
    require row.id != frame.case_id or (not prior.started and history.origin == "genesis" or prior.previous == old_financial and prior.last_case == history.source_case_id) else "MIXED_OPENING_RECONCILIATION";
    define unique_earnings = for each earning in row.facts.earnings {
      require sum(filter(prior.ids, x => x == earning.id), x => 1) == 0 and sum(filter(prior.refs, x => x == earning.original_ref), x => 1) == 0 else "MIXED_EARNING_REPLAY_ALIAS";
      yield earning.id;
    };
    define calculated = calculate_period(registry.earning_terms, registered.authorities, registered.weights, registered.static_refs, registered.controls, row.facts.period, row.facts.as_of_next, row.facts.cutoff, row.facts.period_end_utc, row.facts.evidence, row.facts.cash_settlement_population, row.facts.earnings, row.facts.earning_population, row.facts.case_id, fact_scope, if prior.started then prior.claims else registered.claims, policy.method);
    require row.id == frame.case_id or sum(filter(old_history, x => x.id == row.id and x.result == calculated), x => 1) == 1 else "MIXED_HISTORY_FINANCIAL_REPLAY";
    define next_history = append(prior.history, {id: row.id, facts: row.facts, result: calculated});
    define allocations = concat(prior.allocations, calculated.current_unissued_allocations);
    define offsets = concat(prior.offsets, calculated.current_offset_records);
    define ids = sort_by(concat(prior.ids, unique_earnings), x => x);
    define refs = sort_by(concat(prior.refs, map(row.facts.earnings, x => x.original_ref)), x => x);
    define snapshot = {scope: fact_scope, policy: policy, research: research, history: next_history, claim_ledger: calculated.claim_ledger, unissued_allocation_ledger: allocations, earning_offset_ledger: offsets, consumed_earning_ids: ids, consumed_earning_refs: refs};
    yield {started: true, boundary: row.facts.period.end, claims: calculated.claim_ledger, history: next_history, allocations: allocations, offsets: offsets, ids: ids, refs: refs, last_case: row.id, previous: some(snapshot)};
  };
  require sum(original_ids, x => 1) == sum(originals, x => 1) else "MIXED_CASE_REPLAY";
  define current = require_some(lookup(make_map(filter(replay.history, x => x.id == frame.case_id), x => 0, x => x.result), 0), "MIXED_CURRENT_REQUIRED");
  define final_financial = require_some(replay.previous, "MIXED_CURRENT_REQUIRED");
  closing history = {boundary: frame.period.end, origin: "prior_result", source_case_id: frame.case_id, detail: some({scope: fact_scope, policy: policy, research: research, registry: normalized_registry, registry_original: registry_original, original_frames: original_frames, history: final_financial.history, claim_ledger: final_financial.claim_ledger, unissued_allocation_ledger: final_financial.unissued_allocation_ledger, earning_offset_ledger: final_financial.earning_offset_ledger, consumed_earning_ids: final_financial.consumed_earning_ids, consumed_earning_refs: final_financial.consumed_earning_refs}), transport_profile: "mixed-claims-original-json/3", identity_codec: "unicode-utf8-hex/1"};
  emit "comparison" = current;
  emit "reconciliation" = current.capacity == current.recoupment_credits + current.earning_offsets + current.residual_entitlement;
}
