ticipant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_observed_at: Text, source_ref: Text}>, reversals: List<{evidence_ref: Text, id: Text, observed_at: Instant, original_id: Text, recognition_date: Date, return_date: Date, returned_basis: Money<USD>, revision_authority_id: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_observed_at: Text, source_ref: Text, source_returned_basis: Text}>, revision_authorities: List<{approved: Bool, approved_date: Date, effective: Period, evidence_ref: Text, id: Text, issued_id: Text, maximum_returned_basis: Money<USD>, observed_at: Instant, original_id: Text, permitted_reversal_ids: List<Text>, recorded_date: Date, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_maximum_returned_basis: Text, source_observed_at: Text, source_ref: Text}>, source_case_id: Text, source_cutoff: Text}>, policy_id: Text, policy_revision: Text, priority_recipe: Text, purpose: Text, returned_basis: Money<USD>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text} from "authorized-offsets/original-recovery-history";
  require fact_scope.contract_id == scope.agreement_id and fact_scope.participant_id == scope.participant_id and fact_scope.pool_id == scope.pool_id and fact_scope.asset_id == project and fact_scope.currency == "USD" else "OFFSET_FACT_SCOPE";
  require case_id != "" else "OFFSET_IDENTITY_REQUIRED";
  require policy.id == "SYNTHETIC-AUTHORIZED-OFFSETS-01" and policy.revision == "1" and policy.recognition == "revise_original_obligation_only" and policy.recovery_order == "cash_then_earning_offsets" and policy.earning_order == "date_then_unique_sequence" and policy.cash_date_basis == "supplied_utc_date" and policy.unapplied_cash == "reject" and policy.rounding == "exact_no_rounding" and policy.evidence_class == "research_assumption" else "OFFSET_SELECTED_POLICY";
  require policy.priority_recipe == "clawback_first" or policy.priority_recipe == "other_claim_first" else "OFFSET_PRIORITY_RECIPE";
  define checked_evidence = for each row in evidence {
    require row.id != "" and row.source_kind != "" else "OFFSET_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "OFFSET_EVIDENCE_SCOPE";
    require row.observed_at < cutoff else "OFFSET_EVIDENCE_CUTOFF";
    require (row.source_kind == "complete_original_payment_population") == is_some(row.payment_population) and (row.source_kind == "complete_cash_recovery_population") == is_some(row.cash_population) else "OFFSET_RECORD_FIELDS";
    require not is_some(row.payment_population) or (sum(require_some(row.payment_population, "OFFSET_PAYMENT_POPULATION_SCOPE").payment_ids, id => if id != "" and sum(filter(require_some(row.payment_population, "OFFSET_PAYMENT_POPULATION_SCOPE").payment_ids, other => other == id), other => 1) == 1 then 0 else 1) == 0 and sum(require_some(row.payment_population, "OFFSET_PAYMENT_POPULATION_SCOPE").disbursement_ids, id => if id != "" and sum(filter(require_some(row.payment_population, "OFFSET_PAYMENT_POPULATION_SCOPE").disbursement_ids, other => other == id), other => 1) == 1 then 0 else 1) == 0 and sum(require_some(row.payment_population, "OFFSET_PAYMENT_POPULATION_SCOPE").application_ids, id => if id != "" and sum(filter(require_some(row.payment_population, "OFFSET_PAYMENT_POPULATION_SCOPE").application_ids, other => other == id), other => 1) == 1 then 0 else 1) == 0) else "OFFSET_POPULATION_CONTROL";
    require not is_some(row.cash_population) or (sum(require_some(row.cash_population, "OFFSET_RECOVERY_POPULATION_CONTROL").cash_ids, id => if id != "" and sum(filter(require_some(row.cash_population, "OFFSET_RECOVERY_POPULATION_CONTROL").cash_ids, other => other == id), other => 1) == 1 then 0 else 1) == 0 and sum(require_some(row.cash_population, "OFFSET_RECOVERY_POPULATION_CONTROL").receipt_ids, id => if id != "" and sum(filter(require_some(row.cash_population, "OFFSET_RECOVERY_POPULATION_CONTROL").receipt_ids, other => other == id), other => 1) == 1 then 0 else 1) == 0 and sum(require_some(row.cash_population, "OFFSET_RECOVERY_POPULATION_CONTROL").application_ids, id => if id != "" and sum(filter(require_some(row.cash_population, "OFFSET_RECOVERY_POPULATION_CONTROL").application_ids, other => other == id), other => 1) == 1 then 0 else 1) == 0) else "OFFSET_POPULATION_CONTROL";
    yield row;
  };
  define original = original_bundle.original;
  define issued = original_bundle.issued;
  define snapshot = original_bundle.payment_snapshot;
  require original.id != "" and original.source_ref != "" and issued.id != "" and issued.source_ref != "" else "OFFSET_IDENTITY_REQUIRED";
  require original.scope == fact_scope and issued.scope == fact_scope else "OFFSET_FACT_SCOPE";
  require sum(filter(checked_evidence, row => row.id == original.evidence_ref), row => 1) == 1 and sum(filter(checked_evidence, row => row.id == issued.evidence_ref), row => 1) == 1 else "OFFSET_EVIDENCE_REQUIRED";
  require original.observed_at < cutoff and issued.observed_at < cutoff else "OFFSET_FACT_CUTOFF";
  require original.basis >= USD 0 and original.rate >= 0.0 and original.rate <= 1.0 else "OFFSET_ORIGINAL_RATE_DOMAIN";
  require original.measurement_date < scope.period.start else "OFFSET_ORIGINAL_HISTORICAL_DATE";
