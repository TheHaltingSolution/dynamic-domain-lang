    define receipt_slot: Option<{amount: Money<USD>, cash_line_ref: Text, due_date: Date, election_id: Text, evidence_observed_at: Instant, id: Text, observed_at: Instant, receipt_date: Date, sequence: Int, source_ref: Text}> = fold filter(validated_receipts, candidate_receipt => candidate_receipt.id == row.receipt_id) from none() with slot, candidate_receipt { yield some(candidate_receipt); };
