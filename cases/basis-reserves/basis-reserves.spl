// Original cash/election/return history. All deadlines and money are derived here.
schedule ElectedBasisReserve language "spl/0.1-draft" core "spl-core/0.1-draft" schema "spl-data/0.1-draft" {
  input scope: {agreement_id: Id<Agreement>, participant_id: Id<Participant>, pool_id: Id<Pool>, period: Period};
  input project: Id<Asset>;
  input fact_scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>};
  input case_id: Text;
  input run_checkpoint_id: Text;
  input policy: {date_basis: Text, evidence_class: Text, excess_returns: Text, fee_stage: Text, id: Text, invalid_day: Text, liquidation: Text, method: Text, months: Text, professional_review: Text, revision: Text, rounding: Text, same_day_order: Text};
  input research: {assignment_url: Text, clauses: Text, ld03_sha256: Text, primary_url: Text, rr04_sha256: Text};
  input cutoff: Instant;
  input source_cutoff: Text;
  input authority: {approved: Bool, covered_program: Bool, effective: Period, effective_end_utc: Instant, effective_start_utc: Instant, evidence_ref: Text, evidence_slot: Int, fee_rate: Ratio, fee_substitute: Text, id: Text, observed_at: Instant, original_distributor: Text, raw_original: Text, reserve_rate: Ratio, sales_period_id: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_fee_rate: Text, source_fee_redacted: Bool, source_observed_at: Text, source_ref: Text, source_reserve_rate: Text, successor_authorized: Bool, successor_id: Text, version: Text};
  input checkpoints: List<{approved: Bool, as_of: Date, as_of_next: Date, as_of_utc: Instant, cutoff: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, period: Period, period_end_utc: Instant, period_start_utc: Instant, raw_original: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, source_cutoff: Text, source_observed_at: Text, source_ref: Text}>;
  input receipts: List<{amount: Money<USD>, cash_line_ref: Text, cash_received_country: Text, election_id: Text, evidence_ref: Text, evidence_slot: Int, id: Text, medium: Text, observed_at: Instant, raw_original: Text, receipt_date: Date, receipt_date_utc: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_amount: Text, source_observed_at: Text, source_ref: Text, territory: Text}>;
  input elections: List<{approved: Bool, approved_date: Date, approved_date_utc: Instant, elected: Bool, election_date: Date, election_date_utc: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, purpose: Text, raw_original: Text, receipt_id: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_observed_at: Text, source_ref: Text, vintage_id: Text}>;
  input returns: List<{amount: Money<USD>, authority_id: Text, claim_id: Text, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, raw_original: Text, receipt_id: Text, return_date: Date, return_date_utc: Instant, return_line_ref: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_amount: Text, source_observed_at: Text, source_ref: Text, vintage_id: Text}>;
  input return_authorities: List<{approved: Bool, approved_date: Date, approved_date_utc: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, purpose: Text, raw_original: Text, receipt_id: Text, return_id: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_observed_at: Text, source_ref: Text, vintage_id: Text}>;
  input populations: List<{authority_ids: List<Text>, checkpoint_id: Text, complete: Bool, election_ids: List<Text>, evidence_ref: Text, evidence_slot: Int, id: Text, observed_at: Instant, other_adjustment_ids: List<Text>, other_adjustment_total: Money<USD>, raw_original: Text, receipt_ids: List<Text>, receipt_total: Money<USD>, return_ids: List<Text>, return_total: Money<USD>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_observed_at: Text, source_other_adjustment_total: Text, source_receipt_total: Text, source_ref: Text, source_return_total: Text}>;
  input clearances: List<{approved: Bool, checkpoint_id: Text, complete: Bool, evidence_ref: Text, evidence_slot: Int, expense_remaining: Money<USD>, id: Text, minimum_guarantee_remaining: Money<USD>, observed_at: Instant, raw_original: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_expense_remaining: Text, source_minimum_guarantee_remaining: Text, source_observed_at: Text, source_ref: Text, unresolved_claim_ids: List<Text>}>;
  input evidence: List<{approved: Bool, id: Text, kind: Text, observed_at: Instant, raw_original: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, slot: Int, source_observed_at: Text, source_ref: Text, source_kind: Text, approval_ref: Text, evidence_ref: Text}>;
  input supplied_opening: {boundary: Date, detail: Option<{authority: Text, cumulative: {added: Money<USD>, allocation: Money<USD>, applied_returns: Money<USD>, fee: Money<USD>, gross: Money<USD>, net_receipts: Money<USD>, released: Money<USD>}, last_checkpoint_id: Text, movements: List<{allocation: Money<USD>, authority_id: Option<Text>, claim_id: Option<Text>, election_id: Option<Text>, fee: Money<USD>, gross: Money<USD>, id: Tuple<Text, Text>, kind: Text, movement_date: Date, net_receipts: Money<USD>, receipt_id: Text, release: Money<USD>, reserve_addition: Money<USD>, return_applied: Money<USD>, source_ref: Option<Text>, vintage_id: Text}>, research: {assignment_url: Text, clauses: Text, ld03_sha256: Text, primary_url: Text, rr04_sha256: Text}, sources: {checkpoints: List<{category: Text, id: Text, record: Text}>, clearances: List<{category: Text, id: Text, record: Text}>, elections: List<{category: Text, id: Text, record: Text}>, evidence: List<{category: Text, id: Text, record: Text}>, populations: List<{category: Text, id: Text, record: Text}>, receipts: List<{category: Text, id: Text, record: Text}>, return_authorities: List<{category: Text, id: Text, record: Text}>, returns: List<{category: Text, id: Text, record: Text}>}, vintages: List<{added: Money<USD>, applied_returns: Money<USD>, available: Money<USD>, cash_line_ref: Text, claim_ids: List<Text>, due_date: Date, election_id: Text, election_record: Text, id: Text, origin_date: Date, purpose: Text, receipt_id: Text, release_ids: List<Tuple<Text, Text>>, released: Money<USD>, reserve_elected: Bool, return_ids: List<Text>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}}>}>, origin: Text, policy: {date_basis: Text, evidence_class: Text, excess_returns: Text, fee_stage: Text, id: Text, invalid_day: Text, liquidation: Text, method: Text, months: Text, professional_review: Text, revision: Text, rounding: Text, same_day_order: Text}, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, transport_profile: Text};
  input predecessor: Option<{source_case_id: Text, period: Period, closing_state: {boundary: Date, detail: Option<{authority: Text, cumulative: {added: Money<USD>, allocation: Money<USD>, applied_returns: Money<USD>, fee: Money<USD>, gross: Money<USD>, net_receipts: Money<USD>, released: Money<USD>}, last_checkpoint_id: Text, movements: List<{allocation: Money<USD>, authority_id: Option<Text>, claim_id: Option<Text>, election_id: Option<Text>, fee: Money<USD>, gross: Money<USD>, id: Tuple<Text, Text>, kind: Text, movement_date: Date, net_receipts: Money<USD>, receipt_id: Text, release: Money<USD>, reserve_addition: Money<USD>, return_applied: Money<USD>, source_ref: Option<Text>, vintage_id: Text}>, research: {assignment_url: Text, clauses: Text, ld03_sha256: Text, primary_url: Text, rr04_sha256: Text}, sources: {checkpoints: List<{category: Text, id: Text, record: Text}>, clearances: List<{category: Text, id: Text, record: Text}>, elections: List<{category: Text, id: Text, record: Text}>, evidence: List<{category: Text, id: Text, record: Text}>, populations: List<{category: Text, id: Text, record: Text}>, receipts: List<{category: Text, id: Text, record: Text}>, return_authorities: List<{category: Text, id: Text, record: Text}>, returns: List<{category: Text, id: Text, record: Text}>}, vintages: List<{added: Money<USD>, applied_returns: Money<USD>, available: Money<USD>, cash_line_ref: Text, claim_ids: List<Text>, due_date: Date, election_id: Text, election_record: Text, id: Text, origin_date: Date, purpose: Text, receipt_id: Text, release_ids: List<Tuple<Text, Text>>, released: Money<USD>, reserve_elected: Bool, return_ids: List<Text>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}}>}>, origin: Text, policy: {date_basis: Text, evidence_class: Text, excess_returns: Text, fee_stage: Text, id: Text, invalid_day: Text, liquidation: Text, method: Text, months: Text, professional_review: Text, revision: Text, rounding: Text, same_day_order: Text}, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, transport_profile: Text}}>;
  opening history: {boundary: Date, detail: Option<{authority: Text, cumulative: {added: Money<USD>, allocation: Money<USD>, applied_returns: Money<USD>, fee: Money<USD>, gross: Money<USD>, net_receipts: Money<USD>, released: Money<USD>}, last_checkpoint_id: Text, movements: List<{allocation: Money<USD>, authority_id: Option<Text>, claim_id: Option<Text>, election_id: Option<Text>, fee: Money<USD>, gross: Money<USD>, id: Tuple<Text, Text>, kind: Text, movement_date: Date, net_receipts: Money<USD>, receipt_id: Text, release: Money<USD>, reserve_addition: Money<USD>, return_applied: Money<USD>, source_ref: Option<Text>, vintage_id: Text}>, research: {assignment_url: Text, clauses: Text, ld03_sha256: Text, primary_url: Text, rr04_sha256: Text}, sources: {checkpoints: List<{category: Text, id: Text, record: Text}>, clearances: List<{category: Text, id: Text, record: Text}>, elections: List<{category: Text, id: Text, record: Text}>, evidence: List<{category: Text, id: Text, record: Text}>, populations: List<{category: Text, id: Text, record: Text}>, receipts: List<{category: Text, id: Text, record: Text}>, return_authorities: List<{category: Text, id: Text, record: Text}>, returns: List<{category: Text, id: Text, record: Text}>}, vintages: List<{added: Money<USD>, applied_returns: Money<USD>, available: Money<USD>, cash_line_ref: Text, claim_ids: List<Text>, due_date: Date, election_id: Text, election_record: Text, id: Text, origin_date: Date, purpose: Text, receipt_id: Text, release_ids: List<Tuple<Text, Text>>, released: Money<USD>, reserve_elected: Bool, return_ids: List<Text>, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}}>}>, origin: Text, policy: {date_basis: Text, evidence_class: Text, excess_returns: Text, fee_stage: Text, id: Text, invalid_day: Text, liquidation: Text, method: Text, months: Text, professional_review: Text, revision: Text, rounding: Text, same_day_order: Text}, purpose: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_case_id: Text, transport_profile: Text} from "basis-reserves/original-vintage-history";
  define source_rows_checkpoints = map(checkpoints, row => {id: row.id, source_case_id: row.source_case_id, period: row.period, period_end_utc: row.period_end_utc, as_of: row.as_of, as_of_next: row.as_of_next, cutoff: row.cutoff, source_cutoff: row.source_cutoff, approved: row.approved, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, scope: row.scope});
  define state_source_checkpoints = map(checkpoints, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original});
  define source_rows_receipts = map(receipts, row => {id: row.id, amount: row.amount, receipt_date: row.receipt_date, receipt_date_utc: row.receipt_date_utc, sequence: row.sequence, cash_received_country: row.cash_received_country, territory: row.territory, medium: row.medium, election_id: row.election_id, cash_line_ref: row.cash_line_ref, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, scope: row.scope});
  define state_source_receipts = map(receipts, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original, receipt_date: row.receipt_date});
  define source_rows_elections = map(elections, row => {id: row.id, receipt_id: row.receipt_id, vintage_id: row.vintage_id, purpose: row.purpose, elected: row.elected, election_date: row.election_date, approved_date: row.approved_date, approved: row.approved, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, scope: row.scope});
  define state_source_elections = map(elections, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original, receipt_id: row.receipt_id});
  define source_rows_returns = map(returns, row => {id: row.id, receipt_id: row.receipt_id, vintage_id: row.vintage_id, claim_id: row.claim_id, amount: row.amount, return_date: row.return_date, return_date_utc: row.return_date_utc, sequence: row.sequence, authority_id: row.authority_id, return_line_ref: row.return_line_ref, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, scope: row.scope});
  define state_source_returns = map(returns, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original, return_date: row.return_date});
  define source_rows_return_authorities = map(return_authorities, row => {id: row.id, return_id: row.return_id, receipt_id: row.receipt_id, vintage_id: row.vintage_id, purpose: row.purpose, approved: row.approved, approved_date: row.approved_date, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, scope: row.scope});
  define state_source_return_authorities = map(return_authorities, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original, return_id: row.return_id});
  define source_rows_populations = map(populations, row => {id: row.id, checkpoint_id: row.checkpoint_id, complete: row.complete, receipt_ids: row.receipt_ids, receipt_total: row.receipt_total, election_ids: row.election_ids, return_ids: row.return_ids, return_total: row.return_total, authority_ids: row.authority_ids, other_adjustment_ids: row.other_adjustment_ids, other_adjustment_total: row.other_adjustment_total, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, scope: row.scope});
  define state_source_populations = map(populations, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original, checkpoint_id: row.checkpoint_id});
  define source_rows_clearances = map(clearances, row => {id: row.id, checkpoint_id: row.checkpoint_id, complete: row.complete, approved: row.approved, minimum_guarantee_remaining: row.minimum_guarantee_remaining, expense_remaining: row.expense_remaining, unresolved_claim_ids: row.unresolved_claim_ids, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, scope: row.scope});
  define state_source_clearances = map(clearances, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original, checkpoint_id: row.checkpoint_id});
  define source_rows_evidence = map(evidence, row => {id: row.id, scope: row.scope, observed_at: row.observed_at, source_ref: row.source_ref, source_kind: row.source_kind, approved: row.approved, slot: row.slot});
  define state_source_evidence = map(evidence, row => {id: row.id, observed_at: row.observed_at, raw_original: row.raw_original});
  require fact_scope.contract_id == scope.agreement_id and fact_scope.participant_id == scope.participant_id and fact_scope.pool_id == scope.pool_id and fact_scope.asset_id == project and fact_scope.currency == "USD" else "BR_FACT_SCOPE";
  require history == supplied_opening and history.transport_profile == "basis-reserve-original-json/1" else "BR_OPENING_REQUIRED";
  require policy.id == "RR04-GENIUS-BASIS-RESERVE-01" and policy.revision == "1" and policy.method == "elected_basis_reserve_within_vintage_only" and policy.excess_returns == "reject_pending_signed_policy" and policy.fee_stage == "after_basis_reserve" and policy.liquidation == "full_unused_on_due_date" and policy.months == "6" and policy.invalid_day == "clamp_day" and policy.same_day_order == "receipt_election_then_return_then_due_release" and policy.date_basis == "supplied_utc_date" and policy.rounding == "exact_no_rounding" and policy.evidence_class == "research_assumption" and policy.professional_review == "proposed" else "BR_SELECTED_POLICY";
  require research.primary_url == "https://www.sec.gov/Archives/edgar/data/1098016/000119312506200074/dex101.htm" and research.assignment_url == "https://www.sec.gov/Archives/edgar/data/1098016/000101968706002845/genius_10q-093006.htm" and research.clauses == "1-4;9(c);10-11;20;24(d)" else "BR_RESEARCH_SOURCE";
  define ids_checkpoints = map(source_rows_checkpoints, row => row.id);
  define count_checkpoints = sum(ids_checkpoints, id => 1);
  require count_checkpoints <= 256 else "BR_FINITE_BOUND";
  define unique_checkpoints = fold sort_by(ids_checkpoints, id => id) from {previous: "", started: false, count: 0} with step, id {
    require id != "" and (not step.started or step.previous != id) else "BR_DUPLICATE_ID";
    yield {previous: id, started: true, count: step.count + 1};
  };
  define ids_receipts = map(source_rows_receipts, row => row.id);
  define count_receipts = sum(ids_receipts, id => 1);
  require count_receipts <= 256 else "BR_FINITE_BOUND";
  define unique_receipts = fold sort_by(ids_receipts, id => id) from {previous: "", started: false, count: 0} with step, id {
    require id != "" and (not step.started or step.previous != id) else "BR_DUPLICATE_ID";
    yield {previous: id, started: true, count: step.count + 1};
  };
  define ids_elections = map(source_rows_elections, row => row.id);
  define count_elections = sum(ids_elections, id => 1);
  require count_elections <= 256 else "BR_FINITE_BOUND";
  define unique_elections = fold sort_by(ids_elections, id => id) from {previous: "", started: false, count: 0} with step, id {
    require id != "" and (not step.started or step.previous != id) else "BR_DUPLICATE_ID";
    yield {previous: id, started: true, count: step.count + 1};
  };
  define ids_returns = map(source_rows_returns, row => row.id);
  define count_returns = sum(ids_returns, id => 1);
  require count_returns <= 256 else "BR_FINITE_BOUND";
  define unique_returns = fold sort_by(ids_returns, id => id) from {previous: "", started: false, count: 0} with step, id {
    require id != "" and (not step.started or step.previous != id) else "BR_DUPLICATE_ID";
    yield {previous: id, started: true, count: step.count + 1};
  };
  define ids_return_authorities = map(source_rows_return_authorities, row => row.id);
  define count_return_authorities = sum(ids_return_authorities, id => 1);
  require count_return_authorities <= 256 else "BR_FINITE_BOUND";
  define unique_return_authorities = fold sort_by(ids_return_authorities, id => id) from {previous: "", started: false, count: 0} with step, id {
    require id != "" and (not step.started or step.previous != id) else "BR_DUPLICATE_ID";
    yield {previous: id, started: true, count: step.count + 1};
  };
  define ids_populations = map(source_rows_populations, row => row.id);
  define count_populations = sum(ids_populations, id => 1);
  require count_populations <= 256 else "BR_FINITE_BOUND";
  define unique_populations = fold sort_by(ids_populations, id => id) from {previous: "", started: false, count: 0} with step, id {
    require id != "" and (not step.started or step.previous != id) else "BR_DUPLICATE_ID";
    yield {previous: id, started: true, count: step.count + 1};
  };
  define ids_clearances = map(source_rows_clearances, row => row.id);
  define count_clearances = sum(ids_clearances, id => 1);
  require count_clearances <= 256 else "BR_FINITE_BOUND";
  define unique_clearances = fold sort_by(ids_clearances, id => id) from {previous: "", started: false, count: 0} with step, id {
    require id != "" and (not step.started or step.previous != id) else "BR_DUPLICATE_ID";
    yield {previous: id, started: true, count: step.count + 1};
  };
  define ids_evidence = map(source_rows_evidence, row => row.id);
  define count_evidence = sum(ids_evidence, id => 1);
  require count_evidence <= 256 else "BR_FINITE_BOUND";
  define unique_evidence = fold sort_by(ids_evidence, id => id) from {previous: "", started: false, count: 0} with step, id {
    require id != "" and (not step.started or step.previous != id) else "BR_DUPLICATE_ID";
    yield {previous: id, started: true, count: step.count + 1};
  };
  define checked_evidence = for each row in source_rows_evidence {
    require unique_evidence.count == count_evidence and row.source_ref != "" and row.source_kind != "" else "BR_IDENTITY_REQUIRED";
    require row.scope == fact_scope and row.approved else "BR_EVIDENCE_APPROVAL";
    require row.observed_at < cutoff else "BR_EVIDENCE_AFTER_CUTOFF";
    require row.slot >= 0 and row.slot < count_evidence else "BR_EVIDENCE_SLOT_RANGE";
    yield {id: row.id, slot: row.slot, observed_at: row.observed_at, kind: row.source_kind};
  };
  define evidence_index = make_map(checked_evidence, row => row.slot, row => row);
  require authority.id != "" and authority.version != "" and authority.source_ref != "" and authority.scope == fact_scope and authority.observed_at < cutoff else "BR_FACT_SCOPE";
  define authority_support = require_some(lookup(evidence_index, authority.evidence_slot), "BR_EVIDENCE_REQUIRED");
  require authority_support.id == authority.evidence_ref and authority_support.kind == "approved_successor_and_selected_sales_period_terms" else "BR_EVIDENCE_KIND";
  require authority.approved and authority.successor_authorized and authority.covered_program and authority.successor_id != "" and authority.original_distributor == "Genius Products Inc." else "BR_SUCCESSOR_SCOPE_AUTHORITY";
  require authority.sales_period_id == "SalesPeriod3" and authority.effective.start == date "2009-01-01" and authority.effective.end == date "2010-01-01" and authority.reserve_rate == 0.2 and authority.fee_rate == 0.1 and authority.fee_substitute == "synthetic_flat_10_percent" and authority.source_fee_redacted else "BR_SELECTED_TERMS";
  define checked_checkpoints = for each row in source_rows_checkpoints {
    require unique_checkpoints.count == count_checkpoints and row.source_ref != "" else "BR_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "BR_FACT_SCOPE";
    require row.observed_at < cutoff else "BR_SOURCE_AFTER_CUTOFF";
    define support = require_some(lookup(evidence_index, row.evidence_slot), "BR_EVIDENCE_REQUIRED");
    require support.id == row.evidence_ref else "BR_EVIDENCE_KIND";
    yield {id: row.id, source_case_id: row.source_case_id, period: row.period, period_end_utc: row.period_end_utc, as_of: row.as_of, as_of_next: row.as_of_next, cutoff: row.cutoff, source_cutoff: row.source_cutoff, approved: row.approved, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, evidence_observed_at: support.observed_at};
  };
  define checked_receipts = for each row in source_rows_receipts {
    require unique_receipts.count == count_receipts and row.source_ref != "" else "BR_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "BR_FACT_SCOPE";
    require row.observed_at < cutoff else "BR_SOURCE_AFTER_CUTOFF";
    define support = require_some(lookup(evidence_index, row.evidence_slot), "BR_EVIDENCE_REQUIRED");
    require support.id == row.evidence_ref and support.kind == "actual_qualifying_gross_cash_receipt" else "BR_EVIDENCE_KIND";
    yield {id: row.id, amount: row.amount, receipt_date: row.receipt_date, receipt_date_utc: row.receipt_date_utc, sequence: row.sequence, cash_received_country: row.cash_received_country, territory: row.territory, medium: row.medium, election_id: row.election_id, cash_line_ref: row.cash_line_ref, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, evidence_observed_at: support.observed_at};
  };
  define checked_elections = for each row in source_rows_elections {
    require unique_elections.count == count_elections and row.source_ref != "" else "BR_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "BR_FACT_SCOPE";
    require row.observed_at < cutoff else "BR_SOURCE_AFTER_CUTOFF";
    define support = require_some(lookup(evidence_index, row.evidence_slot), "BR_EVIDENCE_REQUIRED");
    require support.id == row.evidence_ref and support.kind == "original_reserve_election" else "BR_EVIDENCE_KIND";
    yield {id: row.id, receipt_id: row.receipt_id, vintage_id: row.vintage_id, purpose: row.purpose, elected: row.elected, election_date: row.election_date, approved_date: row.approved_date, approved: row.approved, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, evidence_observed_at: support.observed_at};
  };
  define checked_returns = for each row in source_rows_returns {
    require unique_returns.count == count_returns and row.source_ref != "" else "BR_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "BR_FACT_SCOPE";
    require row.observed_at < cutoff else "BR_SOURCE_AFTER_CUTOFF";
    define support = require_some(lookup(evidence_index, row.evidence_slot), "BR_EVIDENCE_REQUIRED");
    require support.id == row.evidence_ref and support.kind == "actual_customer_return" else "BR_EVIDENCE_KIND";
    yield {id: row.id, receipt_id: row.receipt_id, vintage_id: row.vintage_id, claim_id: row.claim_id, amount: row.amount, return_date: row.return_date, return_date_utc: row.return_date_utc, sequence: row.sequence, authority_id: row.authority_id, return_line_ref: row.return_line_ref, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, evidence_observed_at: support.observed_at};
  };
  define checked_return_authorities = for each row in source_rows_return_authorities {
    require unique_return_authorities.count == count_return_authorities and row.source_ref != "" else "BR_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "BR_FACT_SCOPE";
    require row.observed_at < cutoff else "BR_SOURCE_AFTER_CUTOFF";
    define support = require_some(lookup(evidence_index, row.evidence_slot), "BR_EVIDENCE_REQUIRED");
    require support.id == row.evidence_ref and support.kind == "approved_original_return_application" else "BR_EVIDENCE_KIND";
    yield {id: row.id, return_id: row.return_id, receipt_id: row.receipt_id, vintage_id: row.vintage_id, purpose: row.purpose, approved: row.approved, approved_date: row.approved_date, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, evidence_observed_at: support.observed_at};
  };
  define checked_populations = for each row in source_rows_populations {
    require unique_populations.count == count_populations and row.source_ref != "" else "BR_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "BR_FACT_SCOPE";
    require row.observed_at < cutoff else "BR_SOURCE_AFTER_CUTOFF";
    define support = require_some(lookup(evidence_index, row.evidence_slot), "BR_EVIDENCE_REQUIRED");
    require support.id == row.evidence_ref and support.kind == "complete_original_reserve_population" else "BR_EVIDENCE_KIND";
    yield {id: row.id, checkpoint_id: row.checkpoint_id, complete: row.complete, receipt_ids: row.receipt_ids, receipt_total: row.receipt_total, election_ids: row.election_ids, return_ids: row.return_ids, return_total: row.return_total, authority_ids: row.authority_ids, other_adjustment_ids: row.other_adjustment_ids, other_adjustment_total: row.other_adjustment_total, observed_at: row.observed_at, evidence_ref: row.evidence_ref, evidence_slot: row.evidence_slot, source_ref: row.source_ref, evidence_observed_at: support.observed_at};
  };
  define checked_clearances = for each row in source_rows_clearances {
    require unique_clearances.count == count_clearances and row.source_ref != "" else "BR_IDENTITY_REQUIRED";
    require row.scope == fact_scope else "BR_FACT_SCOPE";
    require row.observed_at < cutoff else "BR_SOURCE_AFTER_CUTOFF";
    define support = require_some(lookup(evidence_index, row.evidence_slot), "BR_EVIDENCE_REQUIRED");
    require support.id == row.evidence_ref and support.kind == "complete_cleared_recoupment_claims" else "BR_EVIDENCE_KIND";
