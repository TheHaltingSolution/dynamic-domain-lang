    define population_raw_receipts = original_population_tables.receipts;
    define population_typed_receipts = frame.population_ids.receipts;
    require map(population_raw_receipts, row => row.id) == population_typed_receipts and sum(population_raw_receipts, row => if row.raw_original != "" then 1 else 0) == sum(population_typed_receipts, id => 1) else "BURDEN_ORIGINAL_RECORD_POPULATION";
    define population_raw_authorizations = original_population_tables.authorizations;
    define population_typed_authorizations = frame.population_ids.authorizations;
    require map(population_raw_authorizations, row => row.id) == population_typed_authorizations and sum(population_raw_authorizations, row => if row.raw_original != "" then 1 else 0) == sum(population_typed_authorizations, id => 1) else "BURDEN_ORIGINAL_RECORD_POPULATION";
    define population_raw_requests = original_population_tables.requests;
    define population_typed_requests = frame.population_ids.requests;
    require map(population_raw_requests, row => row.id) == population_typed_requests and sum(population_raw_requests, row => if row.raw_original != "" then 1 else 0) == sum(population_typed_requests, id => 1) else "BURDEN_ORIGINAL_RECORD_POPULATION";
    define population_raw_payments = original_population_tables.payments;
    define population_typed_payments = frame.population_ids.payments;
    require map(population_raw_payments, row => row.id) == population_typed_payments and sum(population_raw_payments, row => if row.raw_original != "" then 1 else 0) == sum(population_typed_payments, id => 1) else "BURDEN_ORIGINAL_RECORD_POPULATION";
    define population_raw_applications = original_population_tables.applications;
    define population_typed_applications = frame.population_ids.applications;
    require map(population_raw_applications, row => row.id) == population_typed_applications and sum(population_raw_applications, row => if row.raw_original != "" then 1 else 0) == sum(population_typed_applications, id => 1) else "BURDEN_ORIGINAL_RECORD_POPULATION";
    define population_raw_receipt_populations = original_population_tables.receipt_populations;
    define population_typed_receipt_populations = frame.population_ids.receipt_populations;
    require map(population_raw_receipt_populations, row => row.id) == population_typed_receipt_populations and sum(population_raw_receipt_populations, row => if row.raw_original != "" then 1 else 0) == sum(population_typed_receipt_populations, id => 1) else "BURDEN_ORIGINAL_RECORD_POPULATION";
    define population_raw_payment_populations = original_population_tables.payment_populations;
    define population_typed_payment_populations = frame.population_ids.payment_populations;
    require map(population_raw_payment_populations, row => row.id) == population_typed_payment_populations and sum(population_raw_payment_populations, row => if row.raw_original != "" then 1 else 0) == sum(population_typed_payment_populations, id => 1) else "BURDEN_ORIGINAL_RECORD_POPULATION";
    define population_raw_evidence = original_population_tables.evidence;
    define population_typed_evidence = frame.population_ids.evidence;
    require map(population_raw_evidence, row => row.id) == population_typed_evidence and sum(population_raw_evidence, row => if row.raw_original != "" then 1 else 0) == sum(population_typed_evidence, id => 1) else "BURDEN_ORIGINAL_RECORD_POPULATION";
    require map(population_raw_evidence, row => row.slot) == frame.evidence_slots else "BURDEN_ORIGINAL_RECORD_POPULATION";
    yield frame.id;
  };
  require sum(raw_populations, id => 1) == frame_count else "BURDEN_ORIGINAL_RECORD_POPULATION";
  define financial_frames = frames;
  define registries = for each original_frame in original_frames {
    define frame = require_some(lookup(frame_index, original_frame.period.start), "BURDEN_ORIGINAL_FRAME_POPULATION");
    define raw_registry = original_frame.originals;
    define static_slots = frame.static_slots;
    define evidence_originals = raw_registry.evidence;
    yield {id: frame.id, registry: {accounts: map(sort_by(raw_registry.accounts, row => row.id), row => row.raw_original), terms: map(sort_by(raw_registry.terms, row => row.id), row => row.raw_original), authorizations: map(sort_by(raw_registry.authorizations, row => row.id), row => row.raw_original), static_evidence: map(sort_by(filter(evidence_originals, row => sum(filter(static_slots, slot => slot == row.slot), slot => 1) > 0), row => row.id), row => row.raw_original)}};
  };
  define first_registry: Option<{accounts: List<Text>, authorizations: List<Text>, static_evidence: List<Text>, terms: List<Text>}> = fold registries from none() with step, row { yield if is_some(step) then step else some(row.registry); };
  define registry = require_some(first_registry, "BURDEN_REGISTRY_REQUIRED");
