        define updated = {id: claim.id, kind: claim.kind, origin_id: claim.origin_id, authorized_amount: claim.authorized_amount, priority: claim.priority, sequence: claim.sequence, eligible_from: claim.eligible_from, authority_id: claim.authority_id, authority_record: claim.authority_record, actual_cash_recovered: claim.actual_cash_recovered, earning_offsets: claim.earning_offsets + amount, remaining: claim.remaining - amount};
        define offset_line = {earning_id: event.id, claim_id: claim.id, priority: claim.priority, sequence: claim.sequence, capacity_before: offset_step.capacity, claim_before: claim.remaining, amount: amount, capacity_after: offset_step.capacity - amount, claim_after: claim.remaining - amount};
        yield {claims: map(offset_step.claims, other => if other.id == claim.id then updated else other), capacity: offset_step.capacity - amount, lines: if amount > USD 0 then append(offset_step.lines, offset_line) else offset_step.lines};
      };
      define earning_line = {id: event.id, effective_date: event.effective_date, amount: event.amount, earning_offset: event.amount - applied.capacity, payable_calculated: applied.capacity, upstream_ref: event.upstream_ref};
      yield {claims: applied.claims, earning_lines: append(earning_step.earning_lines, earning_line), offset_lines: applied.lines, total_earnings: earning_step.total_earnings + event.amount, total_offsets: earning_step.total_offsets + event.amount - applied.capacity, total_payable: earning_step.total_payable + applied.capacity};
    };
    require earned.total_earnings == earned.total_offsets + earned.total_payable else "OFFSET_EARNING_RECONCILIATION";
    require sum(earned.claims, claim => if claim.authorized_amount == claim.actual_cash_recovered + claim.earning_offsets + claim.remaining and claim.remaining >= USD 0 then 0 else 1) == 0 else "OFFSET_CLAIM_RECONCILIATION";
    define total_authorized_original = sum(filter(earned.claims, claim => claim.kind == "original_overpayment"), claim => claim.authorized_amount);
    define result = {current_returned_basis: current_returned, current_signed_reversal: -current_returned * original.rate, returned_basis: total_returned, cumulative_signed_reversal: -total_returned * original.rate, revised_original_entitlement: revised, original_outstanding: max(USD 0, revised - paid), potential_overpayment: potential, total_authorized_original: total_authorized_original, unallocated_overpayment_capacity: potential - total_authorized_original, current_actual_cash_recovered: current_cash, future_earnings: earned.total_earnings, current_earning_offsets: earned.total_offsets, payable_calculated: earned.total_payable, earning_lines: earned.earning_lines, offset_lines: earned.offset_lines, claims: sort_by(earned.claims, claim => claim.id)};
    define normalized: {as_of: Date, cash_recoveries: List<{amount: Money<USD>, evidence_ref: Text, id: Text, observed_at: Instant, receipt_id: Text, received_at: Instant, received_date: Date, received_utc_date: Date, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_observed_at: Text, source_received_at: Text, source_ref: Text}>, cutoff: Instant, future_earnings: List<{amount: Money<USD>, effective_date: Date, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_amount: Text, source_observed_at: Text, source_ref: Text, upstream_ref: Text}>, offset_authorities: List<{amount: Money<USD>, approved: Bool, approved_date: Date, claim_id: Text, effective: Period, eligible_from: Date, evidence_ref: Text, id: Text, kind: Text, observed_at: Instant, origin_id: Text, priority: Int, recorded_date: Date, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_amount: Text, source_observed_at: Text, source_ref: Text}>, opening_utc: Instant, period: Period, recovery_applications: List<{amount: Money<USD>, cash_id: Text, claim_id: Text, evidence_ref: Text, id: Text, observed_at: Instant, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_amount: Text, source_observed_at: Text, source_ref: Text}>, reversals: List<{evidence_ref: Text, id: Text, observed_at: Instant, original_id: Text, recognition_date: Date, return_date: Date, returned_basis: Money<USD>, revision_authority_id: Text, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_observed_at: Text, source_ref: Text, source_returned_basis: Text}>, revision_authorities: List<{approved: Bool, approved_date: Date, effective: Period, evidence_ref: Text, id: Text, issued_id: Text, maximum_returned_basis: Money<USD>, observed_at: Instant, original_id: Text, permitted_reversal_ids: List<Text>, recorded_date: Date, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, source_maximum_returned_basis: Text, source_observed_at: Text, source_ref: Text}>, source_case_id: Text, source_cutoff: Text} = {source_case_id: record.source_case_id, period: record.period, as_of: record.as_of, cutoff: record.cutoff, source_cutoff: record.source_cutoff, opening_utc: record.opening_utc, reversals: checked_reversals, revision_authorities: checked_revision_authorities, offset_authorities: checked_offset_authorities, future_earnings: checked_future_earnings, cash_recoveries: checked_cash_recoveries, recovery_applications: checked_recovery_applications};
    yield {reversals: concat(ledger.reversals, checked_reversals), revision_authorities: concat(ledger.revision_authorities, checked_revision_authorities), offset_authorities: concat(ledger.offset_authorities, checked_offset_authorities), future_earnings: concat(ledger.future_earnings, checked_future_earnings), cash_recoveries: concat(ledger.cash_recoveries, checked_cash_recoveries), recovery_applications: concat(ledger.recovery_applications, checked_recovery_applications), returned: total_returned, claims: result.claims, boundary: some(record.period.end), history: append(ledger.history, normalized), replays: append(ledger.replays, {source_case_id: record.source_case_id, period: record.period, result: result})};
  };
  define selected: Option<{period: Period, result: {claims: List<{actual_cash_recovered: Money<USD>, authority_id: Text, authority_record: {amount: Money<USD>, approved: Bool, approved_date: Date, claim_id: Text, effective: Period, eligible_from: Date, evidence_ref: Text, id: Text, kind: Text, observed_at: Instant, origin_id: Text, priority: Int, recorded_date: Date, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_amount: Text, source_observed_at: Text, source_ref: Text}, authorized_amount: Money<USD>, earning_offsets: Money<USD>, eligible_from: Date, id: Text, kind: Text, origin_id: Text, priority: Int, remaining: Money<USD>, sequence: Int}>, cumulative_signed_reversal: Money<USD>, current_actual_cash_recovered: Money<USD>, current_earning_offsets: Money<USD>, current_returned_basis: Money<USD>, current_signed_reversal: Money<USD>, earning_lines: List<{amount: Money<USD>, earning_offset: Money<USD>, effective_date: Date, id: Text, payable_calculated: Money<USD>, upstream_ref: Text}>, future_earnings: Money<USD>, offset_lines: List<{amount: Money<USD>, capacity_after: Money<USD>, capacity_before: Money<USD>, claim_after: Money<USD>, claim_before: Money<USD>, claim_id: Text, earning_id: Text, priority: Int, sequence: Int}>, original_outstanding: Money<USD>, payable_calculated: Money<USD>, potential_overpayment: Money<USD>, returned_basis: Money<USD>, revised_original_entitlement: Money<USD>, total_authorized_original: Money<USD>, unallocated_overpayment_capacity: Money<USD>}, source_case_id: Text}> = fold filter(replayed.replays, row => row.source_case_id == case_id) from none() with unused, row { yield some(row); };
  define current = require_some(selected, "OFFSET_CURRENT_PERIOD_REQUIRED").result;
  closing history = {scope: fact_scope, purpose: "authorized_original_recovery", policy_id: policy.id, policy_revision: policy.revision, priority_recipe: policy.priority_recipe, original_bundle: original_bundle, boundary: scope.period.end, origin: "prior_result", source_case_id: case_id, returned_basis: replayed.returned, claims: replayed.claims, period_history: replayed.history};
  emit "comparison" = {source_case_id: case_id, period: scope.period, original_gross: gross, original_issued: issued.amount, original_actual_paid: paid, original_paid_as_of: snapshot.source_as_of, current_returned_basis: current.current_returned_basis, current_signed_reversal: current.current_signed_reversal, returned_basis: current.returned_basis, cumulative_signed_reversal: current.cumulative_signed_reversal, revised_original_entitlement: current.revised_original_entitlement, original_outstanding: current.original_outstanding, potential_overpayment: current.potential_overpayment, total_authorized_original: current.total_authorized_original, unallocated_overpayment_capacity: current.unallocated_overpayment_capacity, current_actual_cash_recovered: current.current_actual_cash_recovered, future_earnings: current.future_earnings, current_earning_offsets: current.current_earning_offsets, payable_calculated: current.payable_calculated, original_payment_status: if sum(checked_payments, row => 1) > 0 then "complete_with_payments" else "complete_no_events", cash_recovery_status: if sum(cash_recoveries, row => 1) > 0 then "complete_with_recoveries" else "complete_no_events", current_settlement_payment_status: "no_event_supplied", status_meaning: "old obligation revision and separately authorized recovery; no new bank refund or settlement payment inferred"};
  emit "claims" = current.claims;
  emit "earning_lines" = current.earning_lines;
  emit "offset_lines" = current.offset_lines;
  emit "period_replays" = replayed.replays;
  emit "reconciliation" = current.future_earnings == current.current_earning_offsets + current.payable_calculated;
}
