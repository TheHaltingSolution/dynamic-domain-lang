  };
  require count_checkpoints >= 1 and count_checkpoints <= 12 and count_receipts <= 24 and count_returns <= 48 else "BR_FINITE_BOUND";
  define ordered_checkpoints = sort_by(checked_checkpoints, row => row.period.start);
  define boundaries = fold ordered_checkpoints from {boundary: authority.effective.start, started: false, previous_cutoff: cutoff} with step, row {
    require row.period.start == step.boundary and row.period.start < row.period.end and authority.effective.start <= row.period.start and row.period.end <= authority.effective.end and row.as_of_next == row.period.end else "BR_CHECKPOINT_ADJACENCY";
    require row.approved and row.source_case_id != "" and sum(filter(checked_checkpoints, other => other.source_case_id == row.source_case_id), other => 1) == 1 else "BR_CHECKPOINT_AUTHORITY_ID";
    require row.period_end_utc <= row.cutoff and (not step.started or step.previous_cutoff < row.cutoff) and row.observed_at < row.cutoff else "BR_CHECKPOINT_CUTOFF";
