    require sum(visible_receipts, row => if row.observed_at < before and row.evidence_observed_at < before and row.observed_at <= control.observed_at then 0 else 1) == 0 else "BR_POPULATION_OBSERVATION_ORDER";
    define declared_election_ids = sort_by(control.election_ids, id => id);
