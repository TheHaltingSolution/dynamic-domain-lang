    define earned: {claims: List<{actual_cash_recovered: Money<USD>, authority_id: Text, authority_record: {amount: Money<USD>, approved: Bool, approved_date: Date, claim_id: Text, effective: Period, eligible_from: Date, evidence_ref: Text, id: Text, kind: Text, observed_at: Instant, origin_id: Text, priority: Int, recorded_date: Date, scope: {asset_id: Id<Asset>, contract_id: Id<Agreement>, currency: Text, participant_id: Id<Participant>, pool_id: Id<Pool>}, sequence: Int, source_amount: Text, source_observed_at: Text, source_ref: Text}, authorized_amount: Money<USD>, earning_offsets: Money<USD>, eligible_from: Date, id: Text, kind: Text, origin_id: Text, priority: Int, remaining: Money<USD>, sequence: Int}>, earning_lines: List<{amount: Money<USD>, earning_offset: Money<USD>, effective_date: Date, id: Text, payable_calculated: Money<USD>, upstream_ref: Text}>, offset_lines: List<{amount: Money<USD>, capacity_after: Money<USD>, capacity_before: Money<USD>, claim_after: Money<USD>, claim_before: Money<USD>, claim_id: Text, earning_id: Text, priority: Int, sequence: Int}>, total_earnings: Money<USD>, total_offsets: Money<USD>, total_payable: Money<USD>} = fold sort_by(checked_future_earnings, row => tuple(row.effective_date, row.sequence)) from {claims: cash_applied, earning_lines: [], offset_lines: [], total_earnings: USD 0, total_offsets: USD 0, total_payable: USD 0} with earning_step, event {
