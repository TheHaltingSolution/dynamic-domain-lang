    require originals.id == snapshot.id and originals.period == snapshot.period else "BURDEN_ORIGINAL_FRAME_POPULATION";
    define receipt_details = for each item in snapshot.result.receipt_details {
      define original = fold filter(originals.receipts, row => row.id == item.id) from "" with selected, row { yield row.raw_original; };
      yield {receipt: original, original_share: item.original_share, derived_participation_entitlement: item.derived_participation_entitlement};
    };
    define application_details = for each item in snapshot.result.payment_application_details {
      define original = fold filter(originals.applications, row => row.id == item.id) from "" with selected, row { yield row.raw_original; };
      yield {application: original, derived_participation_limit: item.derived_participation_limit, applied: item.applied};
    };
    define burden_details = for each item in snapshot.result.burden_details {
      define original = fold filter(originals.requests, row => row.id == item.id) from "" with selected, row { yield row.raw_original; };
      yield {request: original, target_after: item.target_after, cap_excess_not_carried: item.cap_excess_not_carried, cap_consumed_after: item.cap_consumed_after, claimant_credit_added: item.claimant_credit_added, cap_remaining_after: item.cap_remaining_after, source_original_accrued: item.source_original_accrued, target_before: item.target_before, minimum_basis: item.minimum_basis, cap_remaining_before: item.cap_remaining_before, basis: item.basis, cap_limit: item.cap_limit, requested: item.requested, applied: item.applied, cap_opening_consumed: item.cap_opening_consumed, authorization_id: item.authorization_id, source_actual_paid: item.source_actual_paid, basis_kind: item.basis_kind, eligible: item.eligible, burden_rate: item.burden_rate};
    };
    yield {id: snapshot.id, period: snapshot.period, cap_usage: snapshot.cap_usage, consumed: snapshot.consumed, result: {source_case_id: snapshot.result.source_case_id, period: snapshot.result.period, status: snapshot.result.status, account_results: snapshot.result.account_results, dependency_order: snapshot.result.dependency_order, original_entitlement_total: snapshot.result.original_entitlement_total, applied_burden_total: snapshot.result.applied_burden_total, adjusted_entitlement_total: snapshot.result.adjusted_entitlement_total, reconciliation: snapshot.result.reconciliation, bank_movement_created: snapshot.result.bank_movement_created, receipt_details: receipt_details, payment_application_details: application_details, burden_details: burden_details}};
  };
  define history_records = for each prior in complete_snapshots {
    define original_source = require_some(lookup(original_source_index, prior.period.start), "BURDEN_ORIGINAL_FRAME_POPULATION");
    require original_source.id == prior.id and original_source.period == prior.period else "BURDEN_ORIGINAL_FRAME_POPULATION";
    yield {id: prior.id, period: prior.period, record: {facts: original_source.raw_original, result: prior.result}};
  };
  define material_states = for each snapshot in filter(complete_snapshots, row => row.period == scope.period or row.period.end == scope.period.start) {
    define records = map(filter(history_records, row => row.period.end <= snapshot.period.end), row => row.record);
    yield {id: snapshot.id, boundary: snapshot.period.end, state: {transport_profile: "entitlement-burdens-original-json/5", identity_codec: "unicode-utf8-hex/1", coordinator: coordinator, policy: policy, research: research, boundary: snapshot.period.end, origin: "prior_result", source_case_id: snapshot.id, detail: some({schema_version: "entitlement-burden-state/1", registry: registry, history: records, cap_usage: snapshot.cap_usage, consumed: snapshot.consumed})}};
  };
  require history.transport_profile == "entitlement-burdens-original-json/5" and history.identity_codec == "unicode-utf8-hex/1" else "BURDEN_STATE_TRANSPORT";
  require history.coordinator == coordinator and history.policy == policy and history.research == research and history.boundary == scope.period.start else "BURDEN_OPENING_RECONCILIATION";
  define material_state_index = make_map(material_states, row => row.boundary, row => row.state);
  define previous_slot = lookup(material_state_index, scope.period.start);
  require (frame_count == 1 and history.origin == "genesis" and history.source_case_id == "67656e65736973" and not is_some(history.detail) and not is_some(predecessor)) or (frame_count > 1 and history.origin == "prior_result" and is_some(previous_slot) and history == require_some(previous_slot, "BURDEN_OPENING_RECONCILIATION") and is_some(predecessor)) else "BURDEN_OPENING_RECONCILIATION";
  require frame_count > 1 or sum(financial_frames, frame => sum(frame.authorizations, row => if frame.period.start <= row.effective.start then 1 else 0)) == sum(financial_frames, frame => sum(frame.authorizations, row => 1)) else "BURDEN_GENESIS_CAP_BOUNDARY";
  require not is_some(predecessor) or (require_some(predecessor, "BURDEN_PREDECESSOR_REQUIRED").source_case_id == history.source_case_id and require_some(predecessor, "BURDEN_PREDECESSOR_REQUIRED").closing_state == history and require_some(predecessor, "BURDEN_PREDECESSOR_REQUIRED").period.end == scope.period.start) else "BURDEN_PREDECESSOR_MISMATCH";
  define current_slot: Option<{cap_usage: List<{authorization_id: Text, cap_limit: Money<USD>, consumed: Money<USD>, remaining: Money<USD>}>, consumed: {application_ids: List<Text>, entitlement_refs: List<Text>, payment_ids: List<Text>, payment_refs: List<Text>, receipt_ids: List<Text>, receipt_refs: List<Text>, request_ids: List<Text>, request_refs: List<Text>, semantic_keys: List<{authorization_ref: Text, claimant_scope: {agreement_id: Text, asset_id: Text, currency: Text, participant_id: Text, pool_id: Text}, end: Date, method: Text, start: Date}>}, id: Text, period: Period, result: {account_results: List<{actual_paid: Option<Money<USD>>, adjusted_entitlement: Money<USD>, burden_applied: Money<USD>, claimant_credit_added: Money<USD>, id: Text, original_accrued: Money<USD>, original_gross_basis: Money<USD>, payment_evidence_status: Text, scope: {agreement_id: Text, asset_id: Text, currency: Text, participant_id: Text, pool_id: Text}}>, adjusted_entitlement_total: Money<USD>, applied_burden_total: Money<USD>, bank_movement_created: Bool, burden_details: List<{applied: Money<USD>, authorization_id: Text, basis: Money<USD>, basis_kind: Text, burden_rate: Ratio, cap_consumed_after: Money<USD>, cap_excess_not_carried: Money<USD>, cap_limit: Money<USD>, cap_opening_consumed: Money<USD>, cap_remaining_after: Money<USD>, cap_remaining_before: Money<USD>, claimant_credit_added: Money<USD>, eligible: Bool, minimum_basis: Money<USD>, request: Text, requested: Money<USD>, source_actual_paid: Option<Money<USD>>, source_original_accrued: Money<USD>, target_after: Money<USD>, target_before: Money<USD>}>, dependency_order: List<Text>, original_entitlement_total: Money<USD>, payment_application_details: List<{application: Text, applied: Money<USD>, derived_participation_limit: Money<USD>}>, period: Period, receipt_details: List<{derived_participation_entitlement: Money<USD>, original_share: Text, receipt: Text}>, reconciliation: Text, source_case_id: Text, status: Text}}> = fold filter(complete_snapshots, row => row.period == scope.period) from none() with selected, row { yield some(row); };
  define current = require_some(current_slot, "BURDEN_CURRENT_PERIOD");
  define closing_slot = lookup(material_state_index, scope.period.end);
  closing history = require_some(closing_slot, "BURDEN_CURRENT_PERIOD");
  emit "comparison" = current.result;
  emit "reconciliation" = current.result.adjusted_entitlement_total == current.result.original_entitlement_total - current.result.applied_burden_total;
}
