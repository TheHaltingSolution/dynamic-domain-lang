        define vintage: {added: Money<USD>, applied_returns: Money<USD>, available: Money<USD>, cash_line_ref: Text, claim_ids: List<Text>, due_date: Date, election_id: Text, id: Text, origin_date: Date, receipt_id: Text, release_ids: List<Tuple<Text, Text>>, released: Money<USD>, reserve_elected: Bool, return_ids: List<Text>} = {id: election.vintage_id, receipt_id: receipt.id, cash_line_ref: receipt.cash_line_ref, election_id: election.id, reserve_elected: election.elected, origin_date: receipt.receipt_date, due_date: receipt.due_date, added: addition, applied_returns: USD 0, released: USD 0, available: addition, return_ids: empty_text, claim_ids: empty_text, release_ids: empty_keys};
        define movement: {allocation: Money<USD>, authority_id: Option<Text>, claim_id: Option<Text>, election_id: Option<Text>, fee: Money<USD>, gross: Money<USD>, id: Tuple<Text, Text>, kind: Text, movement_date: Date, net_receipts: Money<USD>, receipt_id: Text, release: Money<USD>, reserve_addition: Money<USD>, return_applied: Money<USD>, source_ref: Option<Text>, vintage_id: Text} = {id: tuple("addition", receipt.id), kind: "receipt_and_election", movement_date: day, receipt_id: receipt.id, vintage_id: election.vintage_id, election_id: some(election.id), source_ref: some(receipt.source_ref), claim_id: none(), authority_id: none(), gross: receipt.amount, reserve_addition: addition, return_applied: USD 0, release: USD 0, net_receipts: receipt_net, fee: receipt_fee, allocation: receipt_net - receipt_fee};
        yield {vintages: append(added_ledger.vintages, vintage), movements: append(added_ledger.movements, movement)};
