    yield row;
  };
  require sum(validated_issues, row => 1) == sum(checked_issues, row => 1) else "MR_ORIGINAL_ISSUE_AMOUNT_DATE";
  require sum(checked_populations, row => if sum(filter(validated_views, view => view.id == row.view_id), view => 1) == 1 then 0 else 1) == 0 and sum(checked_no_default, row => if sum(filter(validated_views, view => view.id == row.view_id), view => 1) == 1 then 0 else 1) == 0 else "MR_POPULATION_VIEW_REFERENCE";
  define current_slot: Option<{actual_paid: Money<USD>, as_of: Date, attributions: List<{earned_period_id: Text, id: Text, kind: Text, license_cash: Money<USD>, license_deduction: Money<USD>, nmi: Money<USD>, previously_recognized: Money<USD>, qualifying: Bool, rate: Ratio, receipt_id: Text, receipt_ref: Text, recognition_delta: Money<USD>, target_entitlement: Money<USD>}>, box_office_gross: Money<USD>, box_office_id: Text, candidate_total_unpaid: Money<USD>, candidate_unissued: Money<USD>, catchup: Money<USD>, coverage_end: Date, cumulative_entitlement_asof: Money<USD>, current_earnings: Money<USD>, cutoff: Instant, id: Text, issued_outstanding: Money<USD>, known_issue_ids: List<Text>, known_issued: Money<USD>, known_payment_ids: List<Text>, mode: Text, new_recognition_candidate: Money<USD>, obligation_lines: List<{actual_applied: Money<USD>, id: Text, issue_id: Text, original_amount: Money<USD>, outstanding: Money<USD>}>, period_id: Text, rate: Ratio, recognized_cumulative: Money<USD>, source_case_id: Text, source_cutoff: Text, tier: Int, view_id: Text}> = fold filter(replayed.snapshots, row => row.view_id == run.view_id) from none() with slot, row { yield some(row); };
  define current = require_some(current_slot, "MR_CURRENT_VIEW_REQUIRED");
  closing history = if run.mode == "final" then require_some(current_state, "MR_OPENING_REQUIRED") else history;
