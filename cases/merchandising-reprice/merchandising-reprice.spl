    define control_slot: Option<{adjustment_ids: List<Text>, adjustment_total: Money<USD>, application_ids: List<Text>, application_total: Money<USD>, box_office_ids: List<Text>, complete: Bool, disbursement_ids: List<Text>, evidence_observed_at: Instant, evidence_ref: Text, evidence_slot: Int, id: Text, issue_ids: List<Text>, issue_total: Money<USD>, observed_at: Instant, payment_ids: List<Text>, payment_total: Money<USD>, receipt_coverage: Period, receipt_ids: List<Text>, receipt_total: Money<USD>, view_id: Text}> = fold population from none() with slot, pop { yield some(pop); };
    define control = require_some(control_slot, "MR_COMPLETE_POPULATION_REQUIRED");
    require control.observed_at < before and control.receipt_coverage.start == boundaries.first and control.receipt_coverage.end == view.coverage_end and control.evidence_observed_at < before else "MR_RECEIPT_POPULATION_COVERAGE";
    define declared_receipt_ids = sort_by(control.receipt_ids, id => id);
    define actual_receipt_ids = sort_by(map(known_receipts, row => row.id), id => id);
    require declared_receipt_ids == actual_receipt_ids and control.receipt_total == sum(known_receipts, row => row.amount) else "MR_ORIGINAL_POPULATION_CONTROL";
    define declared_issue_ids = sort_by(control.issue_ids, id => id);
    define actual_issue_ids = sort_by(map(known_issues, row => row.id), id => id);
    require declared_issue_ids == actual_issue_ids and control.issue_total == sum(known_issues, row => row.amount) else "MR_ORIGINAL_POPULATION_CONTROL";
    define declared_payment_ids = sort_by(control.payment_ids, id => id);
    define actual_payment_ids = sort_by(map(known_payments, row => row.id), id => id);
    require declared_payment_ids == actual_payment_ids and control.payment_total == sum(known_payments, row => row.amount) else "MR_ORIGINAL_POPULATION_CONTROL";
    define declared_application_ids = sort_by(control.application_ids, id => id);
    define actual_application_ids = sort_by(map(known_applications, row => row.id), id => id);
    require declared_application_ids == actual_application_ids and control.application_total == sum(known_applications, row => row.amount) else "MR_ORIGINAL_POPULATION_CONTROL";
    define declared_box_office_ids = sort_by(control.box_office_ids, id => id);
    define actual_box_office_ids = sort_by(map(known_box, row => row.id), id => id);
    require declared_box_office_ids == actual_box_office_ids else "MR_ORIGINAL_POPULATION_CONTROL";
    define declared_disbursement_ids = sort_by(control.disbursement_ids, id => id);
    define actual_disbursement_ids = sort_by(map(known_payments, row => row.bank_disbursement_id), id => id);
    require declared_disbursement_ids == actual_disbursement_ids else "MR_ORIGINAL_POPULATION_CONTROL";
    require sum(known_receipts, row => if row.evidence_observed_at < before and row.observed_at <= control.observed_at then 0 else 1) == 0 else "MR_POPULATION_OBSERVATION_ORDER";
    require sum(known_box, row => if row.evidence_observed_at < before and row.observed_at <= control.observed_at then 0 else 1) == 0 else "MR_POPULATION_OBSERVATION_ORDER";
    require sum(known_issues, row => if row.evidence_observed_at < before and row.observed_at <= control.observed_at then 0 else 1) == 0 else "MR_POPULATION_OBSERVATION_ORDER";
    require sum(known_payments, row => if row.evidence_observed_at < before and row.observed_at <= control.observed_at then 0 else 1) == 0 else "MR_POPULATION_OBSERVATION_ORDER";
    require sum(known_applications, row => if row.evidence_observed_at < before and row.observed_at <= control.observed_at then 0 else 1) == 0 else "MR_POPULATION_OBSERVATION_ORDER";
    require sum(control.adjustment_ids, id => 1) == 0 and control.adjustment_total == USD 0 else "MR_NONZERO_ADJUSTMENT_VARIANT_REQUIRED";
    define obligation_lines = for each issue in known_issues {
      define applied = sum(filter(known_applications, row => row.issue_id == issue.id), row => row.amount);
      require applied <= issue.amount else "MR_ISSUE_OVERPAYMENT";
      yield {id: issue.id, issue_id: issue.id, original_amount: issue.amount, actual_applied: applied, outstanding: issue.amount - applied};
    };
    require sum(known_payments, p => if sum(filter(known_applications, row => row.payment_id == p.id), row => row.amount) == p.amount then 0 else 1) == 0 else "MR_PAYMENT_APPLICATION_CONSERVATION";
    require sum(known_applications, row => if sum(filter(known_payments, p => p.id == row.payment_id), p => 1) == 1 and sum(filter(known_issues, i => i.id == row.issue_id), i => 1) == 1 then 0 else 1) == 0 else "MR_KNOWN_APPLICATION_REFERENCE";
    define known_issued = sum(known_issues, row => row.amount);
    define paid = sum(known_payments, row => row.amount);
    define recognized_cumulative = sum(recognized, row => row.amount);
    require known_issued <= recognized_cumulative else "MR_ISSUED_EXCEEDS_RECOGNIZED";
    define snapshot = {id: view.id, view_id: view.id, source_case_id: view.source_case_id, period_id: period.id, mode: view.mode, as_of: view.as_of, cutoff: view.cutoff, source_cutoff: view.source_cutoff, coverage_end: view.coverage_end, box_office_id: selected.id, box_office_gross: selected.gross, tier: tier, rate: rate, current_earnings: current_earnings, catchup: catchup, new_recognition_candidate: new_recognition, cumulative_entitlement_asof: cumulative_target, recognized_cumulative: recognized_cumulative, attributions: attributions, known_issue_ids: map(known_issues, row => row.id), known_payment_ids: map(known_payments, row => row.id), known_issued: known_issued, actual_paid: paid, issued_outstanding: known_issued - paid, candidate_unissued: cumulative_target - known_issued, candidate_total_unpaid: cumulative_target - paid, obligation_lines: obligation_lines};
